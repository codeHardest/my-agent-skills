{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.06,
      "to": 0.58,
      "sid": 1,
      "location": 2,
      "content": "各位好",
      "music": 0.0
    },
    {
      "from": 0.58,
      "to": 2.94,
      "sid": 2,
      "location": 2,
      "content": "欢迎收看cs同学六月的宏观推演",
      "music": 0.0
    },
    {
      "from": 2.94,
      "to": 6.04,
      "sid": 3,
      "location": 2,
      "content": "上个月呢我们的主题是碳基通缩和硅基通胀",
      "music": 0.0
    },
    {
      "from": 6.04,
      "to": 8.34,
      "sid": 4,
      "location": 2,
      "content": "这个趋势呢到了本月依旧在加剧",
      "music": 0.0
    },
    {
      "from": 8.34,
      "to": 8.98,
      "sid": 5,
      "location": 2,
      "content": "国内方面",
      "music": 0.0
    },
    {
      "from": 8.98,
      "to": 10.72,
      "sid": 6,
      "location": 2,
      "content": "我们早在年前就预告大家了",
      "music": 0.0
    },
    {
      "from": 10.72,
      "to": 13.73,
      "sid": 7,
      "location": 2,
      "content": "我国经济呢会在二季度末到三季度开始放缓",
      "music": 0.0
    },
    {
      "from": 13.73,
      "to": 16.72,
      "sid": 8,
      "location": 2,
      "content": "这个进程超预期的进一步提前到了4月到5月",
      "music": 0.0
    },
    {
      "from": 16.72,
      "to": 19.28,
      "sid": 9,
      "location": 2,
      "content": "二季度呢我国经济除了出口为之强势",
      "music": 0.0
    },
    {
      "from": 19.28,
      "to": 21.68,
      "sid": 10,
      "location": 2,
      "content": "其余的投资和消费呢已经呈现出",
      "music": 0.0
    },
    {
      "from": 21.68,
      "to": 23.34,
      "sid": 11,
      "location": 2,
      "content": "回到去年四季度的迹象",
      "music": 0.0
    },
    {
      "from": 23.34,
      "to": 24.9,
      "sid": 12,
      "location": 2,
      "content": "尤其是消费呢在近期",
      "music": 0.0
    },
    {
      "from": 24.9,
      "to": 28.03,
      "sid": 13,
      "location": 2,
      "content": "因为之前补贴造成的高基数和透支的效应",
      "music": 0.0
    },
    {
      "from": 28.03,
      "to": 29.87,
      "sid": 14,
      "location": 2,
      "content": "时隔多年首次负增长",
      "music": 0.0
    },
    {
      "from": 29.87,
      "to": 31.89,
      "sid": 15,
      "location": 2,
      "content": "而信贷的社融呢也在进一步恶化",
      "music": 0.0
    },
    {
      "from": 33.47,
      "to": 34.82,
      "sid": 16,
      "location": 2,
      "content": "信心不足的另一面",
      "music": 0.0
    },
    {
      "from": 34.82,
      "to": 36.9,
      "sid": 17,
      "location": 2,
      "content": "是科技相关的投融资一片火热",
      "music": 0.0
    },
    {
      "from": 36.9,
      "to": 37.74,
      "sid": 18,
      "location": 2,
      "content": "这种现象呢",
      "music": 0.0
    },
    {
      "from": 37.74,
      "to": 40.34,
      "sid": 19,
      "location": 2,
      "content": "因为我国经济处于房地产的下行周期",
      "music": 0.0
    },
    {
      "from": 40.34,
      "to": 42.26,
      "sid": 20,
      "location": 2,
      "content": "所以在全球表现的最为极化",
      "music": 0.0
    },
    {
      "from": 42.26,
      "to": 43.22,
      "sid": 21,
      "location": 2,
      "content": "但事实上呢",
      "music": 0.0
    },
    {
      "from": 43.22,
      "to": 45.98,
      "sid": 22,
      "location": 2,
      "content": "日韩欧美如今也都或多或少的出现了",
      "music": 0.0
    },
    {
      "from": 45.98,
      "to": 47.76,
      "sid": 23,
      "location": 2,
      "content": "这种科技热消费凉的症状",
      "music": 0.0
    },
    {
      "from": 47.76,
      "to": 49.72,
      "sid": 24,
      "location": 2,
      "content": "我总感觉这偏离经济学常识",
      "music": 0.0
    },
    {
      "from": 49.72,
      "to": 51.1,
      "sid": 25,
      "location": 2,
      "content": "人造出来的经济增长",
      "music": 0.0
    },
    {
      "from": 51.1,
      "to": 53.14,
      "sid": 26,
      "location": 2,
      "content": "背后呢会有一场高风险的处境",
      "music": 0.0
    },
    {
      "from": 53.14,
      "to": 56.019,
      "sid": 27,
      "location": 2,
      "content": "而且最后让科技崩盘的元凶可能是原油",
      "music": 0.0
    },
    {
      "from": 56.019,
      "to": 57.159,
      "sid": 28,
      "location": 2,
      "content": "就我国而言呢",
      "music": 0.0
    },
    {
      "from": 57.159,
      "to": 58.779,
      "sid": 29,
      "location": 2,
      "content": "极度依靠出口拉动的经济",
      "music": 0.0
    },
    {
      "from": 58.779,
      "to": 61.26,
      "sid": 30,
      "location": 2,
      "content": "最怕的就是出口端的外需大幅走弱",
      "music": 0.0
    },
    {
      "from": 61.26,
      "to": 63.2,
      "sid": 31,
      "location": 2,
      "content": "目前国外的需求还并没有出现",
      "music": 0.0
    },
    {
      "from": 63.2,
      "to": 65.22,
      "sid": 32,
      "location": 2,
      "content": "我国内需负增长的极端情况",
      "music": 0.0
    },
    {
      "from": 65.22,
      "to": 66.66,
      "sid": 33,
      "location": 2,
      "content": "但高油价的长期影响",
      "music": 0.0
    },
    {
      "from": 66.66,
      "to": 68.89,
      "sid": 34,
      "location": 2,
      "content": "正在逐渐的削弱全球的购买力",
      "music": 0.0
    },
    {
      "from": 68.89,
      "to": 71.57,
      "sid": 35,
      "location": 2,
      "content": "而美国方面本月公布的5月居民物价",
      "music": 0.0
    },
    {
      "from": 71.57,
      "to": 73.41,
      "sid": 36,
      "location": 2,
      "content": "CPI同比上涨了4.2",
      "music": 0.0
    },
    {
      "from": 73.41,
      "to": 75.43,
      "sid": 37,
      "location": 2,
      "content": "创出了近3年来的最高水平",
      "music": 0.0
    },
    {
      "from": 75.43,
      "to": 77.59,
      "sid": 38,
      "location": 2,
      "content": "这场美伊冲突造成的油价上涨",
      "music": 0.0
    },
    {
      "from": 80.67,
      "to": 82.99,
      "sid": 39,
      "location": 2,
      "content": "高位的油价会持续压制降息预期",
      "music": 0.0
    },
    {
      "from": 82.99,
      "to": 84.32,
      "sid": 40,
      "location": 2,
      "content": "抬高加息压力",
      "music": 0.0
    },
    {
      "from": 84.32,
      "to": 87.24,
      "sid": 41,
      "location": 2,
      "content": "对高估值的科技股和支撑美国经济的科技",
      "music": 0.0
    },
    {
      "from": 87.24,
      "to": 88.92,
      "sid": 42,
      "location": 2,
      "content": "资本开支呢都是反式",
      "music": 0.0
    },
    {
      "from": 88.92,
      "to": 91.1,
      "sid": 43,
      "location": 2,
      "content": "虽然本月美伊的和谈出现了进展",
      "music": 0.0
    },
    {
      "from": 91.1,
      "to": 92.66,
      "sid": 44,
      "location": 2,
      "content": "油价跌回了80以下",
      "music": 0.0
    },
    {
      "from": 92.66,
      "to": 96.12,
      "sid": 45,
      "location": 2,
      "content": "让市场对中国外需回落和美国进入加息的担忧",
      "music": 0.0
    },
    {
      "from": 96.12,
      "to": 96.94,
      "sid": 46,
      "location": 2,
      "content": "有所缓解",
      "music": 0.0
    },
    {
      "from": 99.06,
      "to": 101.02,
      "sid": 47,
      "location": 2,
      "content": "但美伊谈判拖的有些太久了",
      "music": 0.0
    },
    {
      "from": 101.02,
      "to": 104.14,
      "sid": 48,
      "location": 2,
      "content": "目前全球原油的库存已经跌破了百日警戒线",
      "music": 0.0
    },
    {
      "from": 104.14,
      "to": 105.02,
      "sid": 49,
      "location": 2,
      "content": "到6月中旬",
      "music": 0.0
    },
    {
      "from": 105.02,
      "to": 108.14,
      "sid": 50,
      "location": 2,
      "content": "全球原油仅可满足全球98天的需求",
      "music": 0.0
    },
    {
      "from": 108.14,
      "to": 110.22,
      "sid": 51,
      "location": 2,
      "content": "就算现在海峡恢复通航",
      "music": 0.0
    },
    {
      "from": 110.22,
      "to": 112.28,
      "sid": 52,
      "location": 2,
      "content": "在全球补充库存的需求之下",
      "music": 0.0
    },
    {
      "from": 112.28,
      "to": 114.39,
      "sid": 53,
      "location": 2,
      "content": "油价也难以回到大涨之前",
      "music": 0.0
    },
    {
      "from": 114.39,
      "to": 115.75,
      "sid": 54,
      "location": 2,
      "content": "高油价造成的影响",
      "music": 0.0
    },
    {
      "from": 115.75,
      "to": 117.71,
      "sid": 55,
      "location": 2,
      "content": "现在可能还只是刚刚开始",
      "music": 0.0
    },
    {
      "from": 117.71,
      "to": 120.75,
      "sid": 56,
      "location": 2,
      "content": "本月这次的资本市场因为美伊和谈出现了上涨",
      "music": 0.0
    },
    {
      "from": 120.75,
      "to": 123.66,
      "sid": 57,
      "location": 2,
      "content": "我认为可能是正式入危机前的一次回光返照",
      "music": 0.0
    },
    {
      "from": 123.66,
      "to": 125.86,
      "sid": 58,
      "location": 2,
      "content": "何时危机才会张开它的大嘴",
      "music": 0.0
    },
    {
      "from": 125.86,
      "to": 127.48,
      "sid": 59,
      "location": 2,
      "content": "国内要看外需的变化",
      "music": 0.0
    },
    {
      "from": 127.48,
      "to": 129.22,
      "sid": 60,
      "location": 2,
      "content": "国际则要看利率变化",
      "music": 0.0
    },
    {
      "from": 129.22,
      "to": 129.66,
      "sid": 61,
      "location": 2,
      "content": "好了",
      "music": 0.0
    },
    {
      "from": 129.66,
      "to": 132.7,
      "sid": 62,
      "location": 2,
      "content": "接下来我们再具体的看看本月的经济数据变化",
      "music": 0.0
    },
    {
      "from": 132.7,
      "to": 133.92,
      "sid": 63,
      "location": 2,
      "content": "首先呢是国内方面",
      "music": 0.0
    },
    {
      "from": 133.92,
      "to": 137.06,
      "sid": 64,
      "location": 2,
      "content": "本月国内的物价在投资和消费双低迷的背景下",
      "music": 0.0
    },
    {
      "from": 137.06,
      "to": 138.04,
      "sid": 65,
      "location": 2,
      "content": "保持了韧性",
      "music": 0.0
    },
    {
      "from": 138.04,
      "to": 140.66,
      "sid": 66,
      "location": 2,
      "content": "居民物价CPI同比增长了1.2%",
      "music": 0.0
    },
    {
      "from": 140.66,
      "to": 142.8,
      "sid": 67,
      "location": 2,
      "content": "环比上个月呢下降了1.1%",
      "music": 0.0
    },
    {
      "from": 142.8,
      "to": 144.38,
      "sid": 68,
      "location": 2,
      "content": "CPI能保持正增长",
      "music": 0.0
    },
    {
      "from": 144.38,
      "to": 145.82,
      "sid": 69,
      "location": 2,
      "content": "一个是去年基数太低",
      "music": 0.0
    },
    {
      "from": 145.82,
      "to": 147.04,
      "sid": 70,
      "location": 2,
      "content": "那另一个是上游",
      "music": 0.0
    },
    {
      "from": 147.04,
      "to": 148.52,
      "sid": 71,
      "location": 2,
      "content": "尤其是原油带来的涨价",
      "music": 0.0
    },
    {
      "from": 148.52,
      "to": 150.5,
      "sid": 72,
      "location": 2,
      "content": "已经影响到了下游的消费品",
      "music": 0.0
    },
    {
      "from": 150.5,
      "to": 153.19,
      "sid": 73,
      "location": 2,
      "content": "如果我们剔除掉原油带来的被动涨价",
      "music": 0.0
    },
    {
      "from": 153.19,
      "to": 156.13,
      "sid": 74,
      "location": 2,
      "content": "但实际其他消费品价格依旧在底部徘徊",
      "music": 0.0
    },
    {
      "from": 156.13,
      "to": 157.95,
      "sid": 75,
      "location": 2,
      "content": "而工业物价呢更是超预期的",
      "music": 0.0
    },
    {
      "from": 157.95,
      "to": 159.47,
      "sid": 76,
      "location": 2,
      "content": "同比增长了3.9%",
      "music": 0.0
    },
    {
      "from": 159.47,
      "to": 160.89,
      "sid": 77,
      "location": 2,
      "content": "环比增长0.5%",
      "music": 0.0
    },
    {
      "from": 160.89,
      "to": 162.55,
      "sid": 78,
      "location": 2,
      "content": "上升势头看似很强",
      "music": 0.0
    },
    {
      "from": 162.55,
      "to": 164.23,
      "sid": 79,
      "location": 2,
      "content": "但从这张图我们就能看到",
      "music": 0.0
    },
    {
      "from": 164.23,
      "to": 165.95,
      "sid": 80,
      "location": 2,
      "content": "我国工业端物价的回暖呢",
      "music": 0.0
    },
    {
      "from": 165.95,
      "to": 168.11,
      "sid": 81,
      "location": 2,
      "content": "主要集中在AI和能源相关的行业",
      "music": 0.0
    },
    {
      "from": 168.11,
      "to": 169.02,
      "sid": 82,
      "location": 2,
      "content": "正常的情况下",
      "music": 0.0
    },
    {
      "from": 171.82,
      "to": 173.98,
      "sid": 83,
      "location": 2,
      "content": "进而拉动企业增产扩产的动力",
      "music": 0.0
    },
    {
      "from": 173.98,
      "to": 176.72,
      "sid": 84,
      "location": 2,
      "content": "但是从这份企业固定投资计划的数据来看",
      "music": 0.0
    },
    {
      "from": 176.72,
      "to": 178.31,
      "sid": 85,
      "location": 2,
      "content": "这种情况并没有发生",
      "music": 0.0
    },
    {
      "from": 178.31,
      "to": 179.11,
      "sid": 86,
      "location": 2,
      "content": "说到底呢",
      "music": 0.0
    },
    {
      "from": 179.11,
      "to": 180.31,
      "sid": 87,
      "location": 2,
      "content": "其实这波开年后",
      "music": 0.0
    },
    {
      "from": 180.31,
      "to": 182.71,
      "sid": 88,
      "location": 2,
      "content": "工业物价的上涨其实跟居民物价一样",
      "music": 0.0
    },
    {
      "from": 182.71,
      "to": 184.04,
      "sid": 89,
      "location": 2,
      "content": "被动大于主动",
      "music": 0.0
    },
    {
      "from": 184.04,
      "to": 185.56,
      "sid": 90,
      "location": 2,
      "content": "而AI带来的投资增量",
      "music": 0.0
    },
    {
      "from": 185.56,
      "to": 187.8,
      "sid": 91,
      "location": 2,
      "content": "跟我国全体行业的投资下行相比呢",
      "music": 0.0
    },
    {
      "from": 187.8,
      "to": 188.84,
      "sid": 92,
      "location": 2,
      "content": "只能是洒洒水",
      "music": 0.0
    },
    {
      "from": 188.84,
      "to": 192.08,
      "sid": 93,
      "location": 2,
      "content": "近期在我国工业端最为显著的问题是缺乏订单",
      "music": 0.0
    },
    {
      "from": 192.08,
      "to": 195.14,
      "sid": 94,
      "location": 2,
      "content": "本月公布的5月国内制造业PMI是50",
      "music": 0.0
    },
    {
      "from": 195.14,
      "to": 197.78,
      "sid": 95,
      "location": 2,
      "content": "至少呢没有重新调到荣枯线下方",
      "music": 0.0
    },
    {
      "from": 197.78,
      "to": 199.5,
      "sid": 96,
      "location": 2,
      "content": "但在政府和企业投资增速",
      "music": 0.0
    },
    {
      "from": 199.5,
      "to": 201.86,
      "sid": 97,
      "location": 2,
      "content": "二季度明显重新掉头向下的背景下",
      "music": 0.0
    },
    {
      "from": 201.86,
      "to": 204.86,
      "sid": 98,
      "location": 2,
      "content": "制造业冷热最上游的订单在近期已经开始减少",
      "music": 0.0
    },
    {
      "from": 204.86,
      "to": 206.22,
      "sid": 99,
      "location": 2,
      "content": "从这张图呢可以看到",
      "music": 0.0
    },
    {
      "from": 206.22,
      "to": 209.3,
      "sid": 100,
      "location": 2,
      "content": "新订单和新出口订单已经来到了荣枯线的下方",
      "music": 0.0
    },
    {
      "from": 209.3,
      "to": 211.78,
      "sid": 101,
      "location": 2,
      "content": "而生产端因为原材料价格的大幅升高",
      "music": 0.0
    },
    {
      "from": 211.78,
      "to": 215.57,
      "sid": 102,
      "location": 2,
      "content": "成为了拉动PMI还在50荣枯线上方的主要推力",
      "music": 0.0
    },
    {
      "from": 215.57,
      "to": 217.47,
      "sid": 103,
      "location": 2,
      "content": "跟刚刚我们讲到的物价一样",
      "music": 0.0
    },
    {
      "from": 217.47,
      "to": 218.81,
      "sid": 104,
      "location": 2,
      "content": "如果剔除掉油价影响",
      "music": 0.0
    },
    {
      "from": 218.81,
      "to": 220.65,
      "sid": 105,
