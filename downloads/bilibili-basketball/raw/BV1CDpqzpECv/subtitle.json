 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "v1.7.0.4",
 "body": [
  {
   "from": 0.04,
   "to": 1.52,
   "sid": 1,
   "location": 2,
   "content": "如果你在面对紧追不舍",
   "music": 0
  },
  {
   "from": 1.52,
   "to": 3.24,
   "sid": 2,
   "location": 2,
   "content": "不断封盖你投篮的防守者时",
   "music": 0
  },
  {
   "from": 3.24,
   "to": 4.48,
   "sid": 3,
   "location": 2,
   "content": "难以完成终结",
   "music": 0
  },
  {
   "from": 4.48,
   "to": 6.36,
   "sid": 4,
   "location": 2,
   "content": "这是你需要重点练习的三件事",
   "music": 0
  },
  {
   "from": 6.36,
   "to": 8.49,
   "sid": 5,
   "location": 2,
   "content": "第一件事是当你过掉防守者后",
   "music": 0
  },
  {
   "from": 8.49,
   "to": 10.17,
   "sid": 6,
   "location": 2,
   "content": "你要切断防守者的路线",
   "music": 0
  },
  {
   "from": 10.17,
   "to": 11.93,
   "sid": 7,
   "location": 2,
   "content": "或至少抢先到达位置",
   "music": 0.09467455061097345
  },
  {
   "from": 11.93,
   "to": 12.97,
   "sid": 8,
   "location": 2,
   "content": "改善进攻角度",
   "music": 0
  },
  {
   "from": 12.97,
   "to": 14.81,
   "sid": 9,
   "location": 2,
   "content": "总能提高你的终结能力",
   "music": 0
  },
  {
   "from": 14.81,
   "to": 18.78,
   "sid": 10,
   "location": 2,
   "content": "第二件事是要有能力将球向前向外伸展",
   "music": 0.2024539815198167
  },
  {
   "from": 18.78,
   "to": 21.6,
   "sid": 11,
   "location": 2,
   "content": "有时我可能会黏住球向内切入",
   "music": 0.3089430768722322
  },
  {
   "from": 21.6,
   "to": 24.09,
   "sid": 12,
   "location": 2,
   "content": "我们需要多样化的伸展方式",
   "music": 0.11340205601020284
  },
  {
   "from": 24.09,
   "to": 26.89,
   "sid": 13,
   "location": 2,
   "content": "第三件事是变换你的脚步",
   "music": 0.3490565873086529
  },
  {
   "from": 26.89,
   "to": 29.13,
   "sid": 14,
   "location": 2,
   "content": "有时候如果你想快速终结",
   "music": 0.29378529413642446
  },
  {
   "from": 29.13,
   "to": 30.85,
   "sid": 15,
   "location": 2,
   "content": "在第一步就完成出手是合理的",
   "music": 0
  },
  {
   "from": 30.85,
   "to": 33.48,
   "sid": 16,
   "location": 2,
   "content": "有时你需要多迈一步来改善角度或减速",
   "music": 0.23008848539431326
  },
  {
   "from": 33.48,
   "to": 36.54,
   "sid": 17,
   "location": 2,
   "content": "第三件你可能做到的事是用两步起跳",
   "music": 0
  },
  {
   "from": 36.54,
   "to": 39.57,
   "sid": 18,
   "location": 2,
   "content": "在假动作和踏步突破时改善平衡",
   "music": 0.70802917123981
  },
  {
   "from": 39.57,
   "to": 40.53,
   "sid": 19,
   "location": 2,
   "content": "你需要多样性",
   "music": 0
  },
  {
   "from": 40.53,
   "to": 41.95,
   "sid": 20,
   "location": 2,
   "content": "如果你能掌握这三件事",
   "music": 0.11267604840309264
  },
  {
   "from": 41.95,
   "to": 44.09,
   "sid": 21,
   "location": 2,
   "content": "你在面对追防防守者时的终结能力",
   "music": 0.08411214560223604
  },
  {
   "from": 44.09,
   "to": 45.17,
   "sid": 22,
   "location": 2,
   "content": "将会比以往更好",
   "music": 0
  },
  {
   "from": 45.17,
   "to": 47.18,
   "sid": 23,
   "location": 2,
   "content": "我们将详细讲解所有这些要点",
   "music": 0
  },
  {
   "from": 47.18,
   "to": 49.6,
   "sid": 24,
   "location": 2,
   "content": "并给你一些可以立即拿来练习",
   "music": 0
  },
  {
   "from": 49.6,
   "to": 52.3,
   "sid": 25,
   "location": 2,
   "content": "以提升终结能力的训练方法",
   "music": 0
  },
  {
   "from": 52.3,
   "to": 55.6,
   "sid": 26,
   "location": 2,
   "content": "所以第一个要点是我们的突破角度",
   "music": 0.04861110942322318
  },
  {
   "from": 55.6,
   "to": 57,
   "sid": 27,
   "location": 2,
   "content": "如果他防守我",
   "music": 0
  },
  {
   "from": 57,
   "to": 58.08,
   "sid": 28,
   "location": 2,
   "content": "我向前突破",
   "music": 0
  },
  {
   "from": 58.08,
   "to": 59.32,
   "sid": 29,
   "location": 2,
   "content": "他贴住我的身体",
   "music": 0
  },
  {
   "from": 59.32,
   "to": 60.8,
   "sid": 30,
   "location": 2,
   "content": "现在我被挤出去了",
   "music": 0
  },
  {
   "from": 60.8,
   "to": 62.83,
   "sid": 31,
   "location": 2,
   "content": "面临艰难的终结角度",
   "music": 0
  },
  {
   "from": 62.83,
   "to": 65.67,
   "sid": 32,
   "location": 2,
   "content": "我想要做的是抢先他到达位置",
   "music": 0
  },
  {
   "from": 65.67,
   "to": 67.67,
   "sid": 33,
   "location": 2,
   "content": "所以当我们并排或他稍微落后时",
   "music": 0
  },
  {
   "from": 67.67,
   "to": 68.81,
   "sid": 34,
   "location": 2,
   "content": "我不直线前进",
   "music": 0
  },
  {
   "from": 68.81,
   "to": 70.53,
   "sid": 35,
   "location": 2,
   "content": "而是立即切入",
   "music": 0
  },
  {
   "from": 70.53,
   "to": 71.57,
   "sid": 36,
   "location": 2,
   "content": "我怎么切入",
   "music": 0
  },
  {
   "from": 71.57,
   "to": 72.83,
   "sid": 37,
   "location": 2,
   "content": "我用脚步切入",
   "music": 0
  },
  {
   "from": 72.83,
   "to": 74.35,
   "sid": 38,
   "location": 2,
   "content": "注意我的脚如何转动",
   "music": 0
  },
  {
   "from": 74.35,
   "to": 75.07,
   "sid": 39,
   "location": 2,
   "content": "跟我来",
   "music": 0
  },
  {
   "from": 75.07,
   "to": 76.15,
   "sid": 40,
   "location": 2,
   "content": "我的脚在转动",
   "music": 0
  },
  {
   "from": 76.15,
   "to": 77.31,
   "sid": 41,
   "location": 2,
   "content": "我的髋部在转动",
   "music": 0
  },
  {
   "from": 77.31,
   "to": 79.37,
   "sid": 42,
   "location": 2,
   "content": "现在他落后并在身后",
   "music": 0
  },
  {
   "from": 79.37,
   "to": 81.55,
   "sid": 43,
   "location": 2,
   "content": "这样我就有了伸展空间",
   "music": 0
  },
  {
   "from": 81.55,
   "to": 83.69,
   "sid": 44,
   "location": 2,
   "content": "我看到很多在这方面有困难的球员",
   "music": 0
  },
  {
   "from": 83.69,
   "to": 85.17,
   "sid": 45,
   "location": 2,
   "content": "他们可能用身体切入",
   "music": 0
  },
  {
   "from": 85.17,
   "to": 87.71,
   "sid": 46,
   "location": 2,
   "content": "但脚却走向另一个方向",
   "music": 0
  },
  {
   "from": 87.71,
   "to": 89.05,
   "sid": 47,
   "location": 2,
   "content": "而我的脚是这样",
   "music": 0
  },
  {
   "from": 89.05,
   "to": 92.35,
   "sid": 48,
   "location": 2,
   "content": "但我的髋部和身体却转向相反方向",
   "music": 0
  },
  {
   "from": 92.35,
   "to": 95.24,
   "sid": 49,
   "location": 2,
   "content": "你的身体会朝髋部朝向移动",
   "music": 0
  },
  {
   "from": 95.24,
   "to": 96.28,
   "sid": 50,
   "location": 2,
   "content": "所以我的黄金法则是",
   "music": 0
  },
  {
   "from": 96.28,
   "to": 98.66,
   "sid": 51,
   "location": 2,
   "content": "当你起诉试图抢先防守者到达位置时",
   "music": 0
  },
  {
   "from": 98.66,
   "to": 99.76,
   "sid": 52,
   "location": 2,
   "content": "你要用脚转向",
   "music": 0
  },
  {
   "from": 99.76,
   "to": 100.9,
   "sid": 53,
   "location": 2,
   "content": "并用髋部转向",
   "music": 0
  },
  {
   "from": 100.9,
   "to": 102.43,
   "sid": 54,
   "location": 2,
   "content": "让他处于追防状态",
   "music": 0
  },
  {
   "from": 102.43,
   "to": 103.73,
   "sid": 55,
   "location": 2,
   "content": "我可以在这里伸展",
   "music": 0
  },
  {
   "from": 103.73,
   "to": 105.03,
   "sid": 56,
   "location": 2,
   "content": "但这就是方法",
   "music": 0
  },
  {
   "from": 105.03,
   "to": 108.4,
   "sid": 57,
   "location": 2,
   "content": "你的脚和髋部决定了你的移动方向",
   "music": 0
  },
  {
   "from": 108.4,
   "to": 110.32,
   "sid": 58,
   "location": 2,
   "content": "如果你想要更全面的解析",
   "music": 0
  },
  {
   "from": 110.32,
   "to": 113.62,
   "sid": 59,
   "location": 2,
   "content": "我们发布过上一个关于突破角度的视频",
   "music": 0.2450331044691047
  },
  {
   "from": 113.62,
   "to": 115.4,
   "sid": 60,
   "location": 2,
   "content": "你一定要去看看",
   "music": 0.8055554996142003
  },
  {
   "from": 115.4,
   "to": 118.02,
   "sid": 61,
   "location": 2,
   "content": "第二个要点是用不同的方式伸展球",
   "music": 0
  },
  {
   "from": 118.02,
   "to": 120.02,
   "sid": 62,
   "location": 2,
   "content": "假设他防守我",
   "music": 0
  },
  {
   "from": 120.02,
   "to": 121.72,
   "sid": 63,
   "location": 2,
   "content": "我突破禁区",
   "music": 0
  },
  {
   "from": 121.72,
   "to": 125.12,
   "sid": 64,
   "location": 2,
   "content": "我看到很多球员困扰于防守者追防他们起跳",
   "music": 0
  },
  {
   "from": 125.12,
   "to": 127.16,
   "sid": 65,
   "location": 2,
   "content": "并用上手姿势终结",
   "music": 0
  },
  {
   "from": 127.16,
   "to": 130.78,
   "sid": 66,
   "location": 2,
   "content": "这是追防防守者最容易碰到球的方式",
   "music": 0
  },
  {
   "from": 130.78,
   "to": 132.02,
   "sid": 67,
   "location": 2,
   "content": "假设我这样",
   "music": 0
  },
  {
   "from": 132.02,
   "to": 133.56,
   "sid": 68,
   "location": 2,
   "content": "假设他在我内侧",
   "music": 0
  },
  {
   "from": 133.56,
   "to": 134.58,
   "sid": 69,
   "location": 2,
   "content": "他在追防",
   "music": 0
  },
  {
   "from": 134.58,
   "to": 135.74,
   "sid": 70,
   "location": 2,
   "content": "但他在内侧",
   "music": 0
  },
  {
   "from": 135.74,
   "to": 137.92,
   "sid": 71,
   "location": 2,
   "content": "那么这样出手就不合理",
   "music": 0
  },
  {
   "from": 137.92,
   "to": 140.46,
   "sid": 72,
   "location": 2,
   "content": "合理的做法是把球向外伸展",
   "music": 0
  },
  {
   "from": 140.46,
   "to": 143.98,
   "sid": 73,
   "location": 2,
   "content": "我不断思考如何让球离主要防守者最远",
   "music": 0
  },
  {
   "from": 143.98,
   "to": 146.68,
   "sid": 74,
   "location": 2,
   "content": "所以这需要你从外侧终结",
   "music": 0
  },
  {
   "from": 146.68,
   "to": 148.04,
   "sid": 75,
   "location": 2,
   "content": "如果我在他背上",
   "music": 0
  },
  {
   "from": 148.04,
   "to": 149.88,
   "sid": 76,
   "location": 2,
   "content": "他稍微在肩膀后方",
   "music": 0
  },
  {
   "from": 149.88,
   "to": 152.25,
   "sid": 77,
   "location": 2,
   "content": "他认为我要走外侧",
   "music": 0
  },
  {
   "from": 152.25,
   "to": 154.97,
   "sid": 78,
   "location": 2,
   "content": "那么我可以悄悄从内侧切入",
   "music": 0
  },
  {
   "from": 154.97,
   "to": 155.91,
   "sid": 79,
   "location": 2,
   "content": "改善角度",
   "music": 0
  },
  {
   "from": 155.91,
   "to": 158.2,
   "sid": 80,
   "location": 2,
   "content": "改变他的起跳封盖方向",
   "music": 0
  },
  {
   "from": 158.2,
   "to": 160.92,
   "sid": 81,
   "location": 2,
   "content": "另一种可能是我突破时他更偏向追防",
   "music": 0
  },
  {
   "from": 160.92,
   "to": 162.36,
   "sid": 82,
   "location": 2,
   "content": "几乎像在外侧肩膀",
   "music": 0
  },
  {
   "from": 162.36,
   "to": 163.98,
   "sid": 83,
   "location": 2,
   "content": "所以如果我这样尝试终结",
   "music": 0
  },
  {
   "from": 163.98,
   "to": 165.05,
   "sid": 84,
   "location": 2,
   "content": "他可能会碰到",
   "music": 0
  },
  {
   "from": 165.05,
   "to": 166.15,
   "sid": 85,
   "location": 2,
   "content": "我可以多迈一步",
   "music": 0
  },
  {
   "from": 166.15,
   "to": 167.79,
   "sid": 86,
   "location": 2,
   "content": "在这里向外伸展",
   "music": 0
  },
  {
   "from": 167.79,
   "to": 169.33,
   "sid": 87,
   "location": 2,
   "content": "现在我有反方向的选择",
   "music": 0
  },
  {
   "from": 169.33,
   "to": 171.09,
   "sid": 88,
   "location": 2,
   "content": "你注意到至少有三种不同方式",
   "music": 0.15384614398422713
  },
  {
   "from": 171.09,
   "to": 172.26,
   "sid": 89,
   "location": 2,
   "content": "我可以向前",
   "music": 0
  },
  {
   "from": 172.26,
   "to": 173.3,
   "sid": 90,
   "location": 2,
   "content": "我可以向外",
   "music": 0
  },
  {
   "from": 173.3,
   "to": 174.38,
   "sid": 91,
   "location": 2,
   "content": "我可以向内",
   "music": 0
  },
  {
   "from": 174.38,
   "to": 176.329,
   "sid": 92,
   "location": 2,
   "content": "我也可以用左手完成终结",
   "music": 0
  },
  {
   "from": 176.329,
   "to": 178.069,
   "sid": 93,
   "location": 2,
   "content": "但我们需要多样性",
   "music": 0
  },
  {
   "from": 178.069,
   "to": 179.789,
   "sid": 94,
   "location": 2,
   "content": "根据我们离篮筐的远近",
   "music": 0
  },
  {
   "from": 179.789,
   "to": 184.68,
   "sid": 95,
   "location": 2,
   "content": "但更重要的是防守者的位置用不同方式终结",
   "music": 0
  },
  {
   "from": 184.68,
   "to": 185.88,
   "sid": 96,
   "location": 2,
   "content": "不断告诉自己",
   "music": 0
  },
  {
   "from": 185.88,
   "to": 189.61,
   "sid": 97,
   "location": 2,
   "content": "我的防守者在这里如何让球离他最远",
   "music": 0
  },
  {
   "from": 189.61,
   "to": 192.11,
   "sid": 98,
   "location": 2,
   "content": "来真正提高无人干扰的终结能力",
   "music": 0
  },
  {
   "from": 192.11,
   "to": 194.85,
   "sid": 99,
   "location": 2,
   "content": "现在我们来谈谈改变和混合你的脚步",
   "music": 0
  },
  {
   "from": 194.85,
   "to": 197.05,
   "sid": 100,
   "location": 2,
   "content": "假设我突破他追防我",
   "music": 0
  },
  {
   "from": 197.05,
   "to": 198.33,
   "sid": 101,
   "location": 2,
   "content": "我收球",
   "music": 0
  },
  {
   "from": 198.33,
   "to": 199.19,
   "sid": 102,
   "location": 2,
   "content": "在第一步时",
   "music": 0
  },
  {
   "from": 199.19,
   "to": 200.37,
   "sid": 103,
   "location": 2,
   "content": "我有足够好的角度",
   "music": 0
  },
  {
   "from": 200.37,
   "to": 202.41,
   "sid": 104,
   "location": 2,
   "content": "我与篮筐有很好的空间",
   "music": 0.3411764505190362
  },
  {
   "from": 202.41,
   "to": 203.71,
   "sid": 105,
   "location": 2,
   "content": "我觉得在第一步时",
   "music": 0
  },
  {
   "from": 203.71,
   "to": 205.89,
   "sid": 106,
   "location": 2,
   "content": "我应该能快速完成终结",
   "music": 0
  },
  {
   "from": 205.89,
   "to": 207.47,
   "sid": 107,
   "location": 2,
   "content": "当他没准备好时",
   "music": 0
  },
  {
   "from": 207.47,
   "to": 208.79,
   "sid": 108,
   "location": 2,
   "content": "所以在这种场景下",
   "music": 0
  },
  {
   "from": 208.79,
   "to": 210.69,
   "sid": 109,
   "location": 2,
   "content": "我会做同脚同手终结",
   "music": 0
  },
  {
   "from": 210.69,
   "to": 212.63,
   "sid": 110,
   "location": 2,
   "content": "大多数盖帽手预期的是第一步",
   "music": 0
  },
  {
   "from": 212.63,
   "to": 214.17,
   "sid": 111,
   "location": 2,
   "content": "第二步起跳",
   "music": 0
  },
  {
   "from": 214.17,
