 "body": [
  {
   "from": 0.34,
   "to": 3.97,
   "sid": 1,
   "location": 2,
   "content": "转髋犹豫步是指在转体时将外侧脚抬起",
   "music": 0.12121211787294436
  },
  {
   "from": 3.97,
   "to": 5.4,
   "sid": 2,
   "location": 2,
   "content": "以内侧脚为支撑",
   "music": 0
  },
  {
   "from": 5.4,
   "to": 6.84,
   "sid": 3,
   "location": 2,
   "content": "髋部朝一侧转体",
   "music": 0
  },
  {
   "from": 6.84,
   "to": 7.98,
   "sid": 4,
   "location": 2,
   "content": "带动脚尖旋转",
   "music": 0
  },
  {
   "from": 7.98,
   "to": 10.08,
   "sid": 5,
   "location": 2,
   "content": "最后利用髋部发力进行突破",
   "music": 0.15789472853185674
  },
  {
   "from": 10.08,
   "to": 12.93,
   "sid": 6,
   "location": 2,
   "content": "转髋犹豫步可以帮助我们轻松的摆脱防守",
   "music": 0
  },
  {
   "from": 12.93,
   "to": 15,
   "sid": 7,
   "location": 2,
   "content": "是一个非常高效的过人技巧",
   "music": 0.2176165690354109
  },
  {
   "from": 15,
   "to": 18.33,
   "sid": 8,
   "location": 2,
   "content": "今天我们就来分享一下转髋犹豫步的训练方法",
   "music": 0
  },
  {
   "from": 18.33,
   "to": 20.28,
   "sid": 9,
   "location": 2,
   "content": "首先第一步我们找到一条线",
   "music": 0
  },
  {
   "from": 20.28,
   "to": 23.16,
   "sid": 10,
   "location": 2,
   "content": "在这条线上的去练习我们的髋部灵活性",
   "music": 0.09090908746556561
  },
  {
   "from": 23.16,
   "to": 26.16,
   "sid": 11,
   "location": 2,
   "content": "首先呢我们可以在原地找到髋部发力的感受",
   "music": 0
  },
  {
   "from": 26.16,
   "to": 28.26,
   "sid": 12,
   "location": 2,
   "content": "我们的身体正朝前方",
   "music": 0
  },
  {
   "from": 28.26,
   "to": 30.78,
   "sid": 13,
   "location": 2,
   "content": "此时我们的髋部进行一个左右的转动",
   "music": 0.21428570471938696
  },
  {
   "from": 30.78,
   "to": 31.98,
   "sid": 14,
   "location": 2,
   "content": "注意我们在转动时",
   "music": 0
  },
  {
   "from": 31.98,
   "to": 35.1,
   "sid": 15,
   "location": 2,
   "content": "我们身体不能跟随我们的髋进行了同时的转动",
   "music": 0.07432432181336719
  },
  {
   "from": 35.1,
   "to": 37.47,
   "sid": 16,
   "location": 2,
   "content": "而我们的身体是始终朝向前方的",
   "music": 0
  },
  {
   "from": 37.47,
   "to": 39.75,
   "sid": 17,
   "location": 2,
   "content": "进行一个髋部的转动转动转动",
   "music": 0.3913043265595476
  },
  {
   "from": 39.75,
   "to": 40.56,
   "sid": 18,
   "location": 2,
   "content": "那这时候呢",
   "music": 0
  },
  {
   "from": 40.56,
   "to": 43.34,
   "sid": 19,
   "location": 2,
   "content": "我们再进行一个横向的一个髋部的转动",
   "music": 0
  },
  {
   "from": 43.34,
   "to": 44.57,
   "sid": 20,
   "location": 2,
   "content": "去进行一个跳步",
   "music": 0
  },
  {
   "from": 44.57,
   "to": 45.44,
   "sid": 21,
   "location": 2,
   "content": "横向转动",
   "music": 0.026315786011075624
  },
  {
   "from": 45.44,
   "to": 48.56,
   "sid": 22,
   "location": 2,
   "content": "快速身体朝向前方",
   "music": 0.2784809950328505
  },
  {
   "from": 49.86,
