   "sid": 23,
   "location": 2,
   "content": "当我们找到了髋部发力的感受之后呢",
   "music": 0.35922328353285216
  },
  {
   "from": 52.08,
   "to": 54.12,
   "sid": 24,
   "location": 2,
   "content": "第二步我们来到罚球线附近",
   "music": 0
  },
  {
   "from": 54.12,
