   "sid": 25,
   "location": 2,
   "content": "沿着罚球线的弧线进行一个转髋的练习",
   "music": 0
  },
  {
   "from": 56.88,
   "to": 58.34,
   "sid": 26,
   "location": 2,
   "content": "首先上我们的内侧角",
   "music": 0
  },
  {
   "from": 58.34,
   "to": 60.68,
   "sid": 27,
   "location": 2,
   "content": "这时候呢抬起我们的另一只脚",
