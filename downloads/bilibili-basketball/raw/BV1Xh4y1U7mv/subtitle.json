   "location": 2,
   "content": "连续连续完成最后一步",
   "music": 0.5982905727226242
  },
  {
   "from": 72.62,
   "to": 73.64,
   "sid": 32,
   "location": 2,
   "content": "同样来到罚球线",
   "music": 0
  },
  {
   "from": 73.64,
