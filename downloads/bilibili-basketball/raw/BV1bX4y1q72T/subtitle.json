 "body": [
  {
   "from": 5.12,
   "to": 7.96,
   "sid": 1,
   "location": 2,
   "content": "今天给大家分享一个非常有节奏的进攻技巧",
   "music": 0
  },
  {
   "from": 7.96,
   "to": 9.52,
   "sid": 2,
   "location": 2,
   "content": "它的起始动作非常简单",
   "music": 0.10256409598948114
  },
  {
   "from": 9.52,
   "to": 10.78,
   "sid": 3,
   "location": 2,
   "content": "就是我们的运球步",
   "music": 0.370370336076821
  },
  {
   "from": 10.78,
   "to": 13.39,
   "sid": 4,
   "location": 2,
   "content": "也就是我们的对侧脚上步同时落球",
   "music": 0
  },
  {
   "from": 13.39,
   "to": 15.34,
   "sid": 5,
   "location": 2,
   "content": "注意这时候我们立刻做悬浮",
   "music": 0
  },
  {
   "from": 15.34,
   "to": 17.18,
   "sid": 6,
   "location": 2,
   "content": "前脚收到后边去蹬地",
   "music": 0
  },
  {
   "from": 17.18,
   "to": 19.14,
   "sid": 7,
   "location": 2,
   "content": "把我们的另一只脚延伸出去",
   "music": 0
  },
  {
   "from": 19.14,
   "to": 22.02,
   "sid": 8,
   "location": 2,
   "content": "第二把我们重心有一个前探的过程",
   "music": 0
  },
  {
   "from": 22.02,
   "to": 23.76,
   "sid": 9,
   "location": 2,
   "content": "只要防守人向后收缩",
   "music": 0
  },
  {
   "from": 23.76,
   "to": 25.74,
   "sid": 10,
   "location": 2,
   "content": "我们立刻上后脚完成一个合球",
   "music": 0
  },
  {
   "from": 25.74,
   "to": 27.72,
   "sid": 11,
   "location": 2,
   "content": "完成出手投篮",
   "music": 0
  },
  {
   "from": 35.2,
   "to": 37.38,
   "sid": 12,
   "location": 2,
   "content": "如果我们的第一个动作没有出来空间",
   "music": 0
  },
  {
   "from": 37.38,
   "to": 38.88,
   "sid": 13,
   "location": 2,
   "content": "我们可以继续向下延伸",
   "music": 0
  },
  {
   "from": 38.88,
   "to": 41.64,
   "sid": 14,
   "location": 2,
   "content": "我们做一个胯下同样运球步",
   "music": 0.04807692076553338
  },
  {
   "from": 41.64,
   "to": 44.55,
   "sid": 15,
   "location": 2,
   "content": "注意这时候悬浮转换进攻角",
   "music": 0
  },
  {
   "from": 44.55,
   "to": 48.66,
   "sid": 16,
   "location": 2,
   "content": "立刻上后脚的胯下完成一个加速上篮",
   "music": 0
  },
  {
   "from": 56.72,
   "to": 59.56,
   "sid": 17,
   "location": 2,
   "content": "如果前两个动作对防守人没有产生任何的效果",
   "music": 0
  },
  {
   "from": 59.56,
   "to": 61.88,
   "sid": 18,
   "location": 2,
   "content": "那么第三个动作一定会把它定在原地",
   "music": 0
  },
  {
   "from": 61.88,
   "to": 65.96,
   "sid": 19,
   "location": 2,
   "content": "同样是运球步一二把我们重心蹬踏出去",
   "music": 0
  },
  {
   "from": 65.96,
   "to": 67.44,
   "sid": 20,
   "location": 2,
   "content": "这时候立刻上后脚",
   "music": 0
  },
  {
   "from": 67.44,
   "to": 70.62,
   "sid": 21,
   "location": 2,
   "content": "注意胯下完成时不要立刻完成交叉步突破",
   "music": 0
  },
  {
   "from": 70.62,
   "to": 72.04,
   "sid": 22,
   "location": 2,
   "content": "我们做一个重心的转换",
   "music": 0
  },
  {
   "from": 72.04,
   "to": 75.38,
   "sid": 23,
   "location": 2,
   "content": "上步胯下一二重心有个前后的一个过程",
   "music": 0
  },
  {
   "from": 75.38,
   "to": 77.12,
   "sid": 24,
   "location": 2,
   "content": "利用重心去诱导防守人",
   "music": 0
  },
  {
   "from": 77.12,
   "to": 78.74,
   "sid": 25,
   "location": 2,
   "content": "这时候再完成一个交叉步",
   "music": 0
  },
  {
   "from": 78.74,
   "to": 80.24,
   "sid": 26,
   "location": 2,
   "content": "完成上篮",
   "music": 0
  }
 ]
}