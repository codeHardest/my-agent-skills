  },
  {
   "from": 25.74,
   "to": 27.45,
   "sid": 12,
   "location": 2,
   "content": "有时候即便是看会了",
   "music": 0
  },
  {
   "from": 27.45,
   "to": 29.88,
   "sid": 13,
   "location": 2,
   "content": "想要控制住自己的身体还是挺难的",
   "music": 0
  },
  {
   "from": 29.88,
   "to": 31.68,
   "sid": 14,
   "location": 2,
   "content": "但是根据我说的这几点体会呢",
