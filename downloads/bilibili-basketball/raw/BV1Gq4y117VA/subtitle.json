 "version": "1.5.0",
 "body": [
  {
   "from": 0.18,
   "to": 2.08,
   "sid": 1,
   "location": 2,
   "content": "没篮是一种什么体验",
   "music": 0
  },
  {
   "from": 2.08,
   "to": 4.18,
   "sid": 2,
   "location": 2,
   "content": "就是防守人永远都放你两步",
   "music": 0
  },
  {
   "from": 4.18,
   "to": 4.78,
   "sid": 3,
   "location": 2,
   "content": "秃嘛",
   "music": 0
  },
  {
   "from": 4.78,
   "to": 6.4,
   "sid": 4,
   "location": 2,
   "content": "没有空间投嘛",
   "music": 0
  },
  {
   "from": 6.4,
   "to": 7.18,
   "sid": 5,
   "location": 2,
   "content": "又投不进",
   "music": 0
  },
  {
   "from": 7.18,
   "to": 8.5,
   "sid": 6,
   "location": 2,
   "content": "别提多难受了",
   "music": 0
  },
  {
   "from": 8.5,
   "to": 9.94,
   "sid": 7,
   "location": 2,
   "content": "那么怎么才能标准",
   "music": 0
  },
  {
   "from": 9.94,
   "to": 11.84,
   "sid": 8,
   "location": 2,
   "content": "我认为最重要的是不要代偿",
   "music": 0
  },
  {
   "from": 11.84,
   "to": 13.25,
   "sid": 9,
   "location": 2,
   "content": "也就是说不要借力",
   "music": 0
  },
  {
   "from": 13.25,
   "to": 14.6,
   "sid": 10,
   "location": 2,
   "content": "女生如果胳膊没力",
   "music": 0
  },
  {
   "from": 14.6,
   "to": 15.98,
   "sid": 11,
   "location": 2,
   "content": "就会从胸肌借力",
   "music": 0
  },
  {
   "from": 15.98,
   "to": 17.15,
   "sid": 12,
   "location": 2,
   "content": "最终变成三大腿",
   "music": 0
  },
  {
   "from": 17.15,
   "to": 18.619,
   "sid": 13,
   "location": 2,
   "content": "男生如果臀腿没力",
   "music": 0
  },
  {
   "from": 18.619,
   "to": 19.939,
   "sid": 14,
   "location": 2,
   "content": "就会从腰借力",
   "music": 0.12499998883928393
  },
  {
   "from": 19.939,
   "to": 21.289,
   "sid": 15,
   "location": 2,
   "content": "最终上身往后攻",
   "music": 0
  },
  {
   "from": 21.289,
   "to": 23.2,
   "sid": 16,
   "location": 2,
   "content": "我一直对一个现象很感兴趣",
   "music": 0
  },
  {
   "from": 23.2,
   "to": 25.3,
   "sid": 17,
   "location": 2,
   "content": "很多粉丝声称自己是one motion",
   "music": 0
  },
  {
   "from": 25.3,
   "to": 26.86,
   "sid": 18,
   "location": 2,
   "content": "但如果仔细看他们的大臂",
   "music": 0
  },
  {
   "from": 26.86,
   "to": 29.64,
   "sid": 19,
   "location": 2,
   "content": "从这到这大臂都是不动的",
   "music": 0
  },
  {
   "from": 29.64,
   "to": 30.75,
   "sid": 20,
   "location": 2,
   "content": "只有小臂在动",
   "music": 0
  },
  {
   "from": 30.75,
   "to": 32.67,
   "sid": 21,
   "location": 2,
   "content": "而如果我们观察库里特雷杨",
   "music": 0
  },
  {
   "from": 32.67,
   "to": 34.53,
   "sid": 22,
   "location": 2,
   "content": "他们的大臂一直在向上顶",
   "music": 0
  },
  {
   "from": 34.53,
   "to": 35.53,
   "sid": 23,
   "location": 2,
   "content": "从不停下",
   "music": 0
  },
  {
   "from": 35.53,
   "to": 36.91,
   "sid": 24,
   "location": 2,
   "content": "那你直接去库里玩",
   "music": 0
  },
  {
   "from": 36.91,
   "to": 37.57,
   "sid": 25,
   "location": 2,
   "content": "顶不行了",
   "music": 0
  },
  {
   "from": 37.57,
   "to": 38.86,
   "sid": 26,
   "location": 2,
   "content": "我干嘛那么麻烦的",
   "music": 0
  },
  {
   "from": 38.86,
   "to": 40.93,
   "sid": 27,
   "location": 2,
   "content": "那你直接跟苏炳添一样跑快点不就完了",
   "music": 0
  },
  {
   "from": 40.93,
   "to": 41.96,
   "sid": 28,
   "location": 2,
   "content": "一天到晚纠结个啥",
   "music": 0
  },
  {
   "from": 41.96,
   "to": 43.76,
   "sid": 29,
   "location": 2,
   "content": "我要是能和苏炳添一样快",
   "music": 0
  },
  {
   "from": 43.76,
   "to": 45.26,
   "sid": 30,
   "location": 2,
   "content": "我怎么还在这吗",
   "music": 0
  },
  {
   "from": 46.74,
   "to": 48.78,
   "sid": 31,
   "location": 2,
   "content": "所以很多事情不是我们不想",
   "music": 0
  },
  {
   "from": 48.78,
   "to": 49.91,
   "sid": 32,
   "location": 2,
   "content": "只是做不到罢了",
   "music": 0
  },
  {
   "from": 49.91,
   "to": 51.41,
   "sid": 33,
   "location": 2,
   "content": "库里也说过很多次",
   "music": 0
  },
  {
   "from": 51.41,
   "to": 52.43,
   "sid": 34,
   "location": 2,
   "content": "他不靠胳膊",
   "music": 0
  },
  {
   "from": 52.43,
   "to": 53.09,
   "sid": 35,
   "location": 2,
   "content": "只靠腿",
   "music": 0
  },
  {
   "from": 53.09,
   "to": 54.74,
   "sid": 36,
   "location": 2,
   "content": "有一场比赛他投篮很差",
   "music": 0
  },
  {
   "from": 54.74,
   "to": 57.22,
   "sid": 37,
   "location": 2,
   "content": "记者问为什么他就说累了",
   "music": 0
  },
  {
   "from": 57.22,
   "to": 58,
   "sid": 38,
   "location": 2,
   "content": "跳不动了",
   "music": 0
  },
  {
   "from": 58,
   "to": 59.11,
   "sid": 39,
   "location": 2,
   "content": "所以用胳膊投篮",
   "music": 0
  },
  {
   "from": 59.11,
   "to": 61.24,
   "sid": 40,
   "location": 2,
   "content": "还有一次他也是说我累了",
   "music": 0
  },
  {
   "from": 61.24,
   "to": 63.82,
   "sid": 41,
   "location": 2,
   "content": "有时候就会忘记降安中心会偷懒",
   "music": 0
  },
  {
   "from": 63.82,
   "to": 65.54,
   "sid": 42,
   "location": 2,
   "content": "也就是说不管距离多远",
   "music": 0
  },
  {
   "from": 65.54,
   "to": 67.61,
   "sid": 43,
   "location": 2,
   "content": "在他看来都不应该胳膊夹里",
   "music": 0
  },
  {
   "from": 67.61,
   "to": 69.05,
   "sid": 44,
   "location": 2,
   "content": "而应该臀腿加力",
   "music": 0
  },
  {
   "from": 69.05,
   "to": 70.58,
   "sid": 45,
   "location": 2,
   "content": "这一点说起来容易",
   "music": 0
  },
  {
   "from": 70.58,
   "to": 72.23,
   "sid": 46,
   "location": 2,
   "content": "但做起来非常难",
   "music": 0
  },
  {
   "from": 72.23,
   "to": 76.13,
   "sid": 47,
   "location": 2,
   "content": "想一想你练传统手艺的时候是更愿意去动手呢",
   "music": 0
  },
  {
   "from": 76.13,
   "to": 79.6,
   "sid": 48,
   "location": 2,
   "content": "还是更愿意去动屁股哈太狂",
   "music": 0
  },
  {
   "from": 80,
   "to": 81.47,
   "sid": 49,
   "location": 2,
   "content": "乔丹曾经说过",
   "music": 0
  },
  {
   "from": 81.47,
   "to": 83.57,
   "sid": 50,
   "location": 2,
   "content": "如果他能感觉到食指和中指",
   "music": 0
  },
  {
   "from": 83.57,
   "to": 84.68,
   "sid": 51,
   "location": 2,
   "content": "那这球就闭紧",
   "music": 0
  },
  {
   "from": 84.68,
   "to": 86.12,
   "sid": 52,
   "location": 2,
   "content": "而要是感觉不到手指",
   "music": 0
  },
  {
   "from": 86.12,
   "to": 87.42,
   "sid": 53,
   "location": 2,
   "content": "那就要丢",
   "music": 0.40909086260331257
  },
  {
   "from": 87.42,
   "to": 89.04,
   "sid": 54,
   "location": 2,
   "content": "那以前我教练就告诉我",
   "music": 0
  },
  {
   "from": 89.04,
   "to": 92.44,
   "sid": 55,
   "location": 2,
   "content": "如果你的手指感受不到最后拨球的这个感觉",
   "music": 0
  },
  {
   "from": 92.44,
   "to": 94.54,
   "sid": 56,
   "location": 2,
   "content": "那就说明你一定有某种代偿了",
   "music": 0
  },
  {
   "from": 94.54,
   "to": 95.56,
   "sid": 57,
   "location": 2,
   "content": "那解决方法呢",
   "music": 0
  },
  {
   "from": 95.56,
   "to": 97.96,
   "sid": 58,
   "location": 2,
   "content": "我把它叫做不要学威少训练法",
   "music": 0
  },
  {
   "from": 97.96,
   "to": 98.89,
   "sid": 59,
   "location": 2,
   "content": "什么意思呢",
   "music": 0
  },
  {
   "from": 98.89,
   "to": 100.09,
   "sid": 60,
   "location": 2,
   "content": "我们做两件事",
   "music": 0
  },
  {
   "from": 100.09,
   "to": 104.84,
   "sid": 61,
   "location": 2,
   "content": "第一个是篮球后立马去做一个翻球的动作",
   "music": 0
  },
  {
   "from": 104.84,
   "to": 106.7,
   "sid": 62,
   "location": 2,
   "content": "就我们一般人是这样的嘛",
   "music": 0
  },
  {
   "from": 106.7,
   "to": 110.03,
   "sid": 63,
   "location": 2,
   "content": "尤其是威少特别大额头之后之后再去翻",
   "music": 0
  },
  {
   "from": 110.03,
   "to": 114.18,
   "sid": 64,
   "location": 2,
   "content": "我们要做的就是在叽叽这里就翻炮",
   "music": 0
  },
  {
   "from": 114.18,
   "to": 116.39,
   "sid": 65,
   "location": 2,
   "content": "然后你会发现什么诶",
   "music": 0
  },
  {
   "from": 116.39,
   "to": 118.07,
   "sid": 66,
   "location": 2,
   "content": "我肘在肚子里",
   "music": 0
  },
  {
   "from": 118.07,
   "to": 120.02,
   "sid": 67,
   "location": 2,
   "content": "是不是球球已经翻上来了",
   "music": 0
  },
  {
   "from": 120.02,
   "to": 121.52,
   "sid": 68,
   "location": 2,
   "content": "是不是很像特雷杨",
   "music": 0
  },
  {
   "from": 121.52,
   "to": 123.27,
   "sid": 69,
   "location": 2,
   "content": "然后第二个事情是什么呢",
   "music": 0
  },
  {
   "from": 123.27,
   "to": 125.28,
   "sid": 70,
   "location": 2,
   "content": "就是当球举上来之后",
   "music": 0
  },
  {
   "from": 125.28,
   "to": 129.34,
   "sid": 71,
   "location": 2,
   "content": "我想象这里有一个有一罐饼干",
   "music": 0
  },
  {
   "from": 129.34,
   "to": 131.8,
   "sid": 72,
   "location": 2,
   "content": "我要去把手伸上去去购这块饼干",
   "music": 0
  },
  {
   "from": 131.8,
   "to": 133.19,
   "sid": 73,
   "location": 2,
   "content": "或者用库里的话说",
   "music": 0
  },
  {
   "from": 133.19,
   "to": 136.79,
   "sid": 74,
   "location": 2,
   "content": "那就是我是想象手臂是一个天鹅的脖子诶",
   "music": 0
  },
  {
   "from": 136.79,
   "to": 138.59,
   "sid": 75,
   "location": 2,
   "content": "很优雅的这么压下来",
   "music": 0
  },
  {
   "from": 138.59,
   "to": 139.49,
   "sid": 76,
   "location": 2,
   "content": "这两个连起来",
   "music": 0
  },
  {
   "from": 139.49,
   "to": 140.769,
   "sid": 77,
   "location": 2,
   "content": "如果连如果连起来做",
   "music": 0
  },
  {
   "from": 140.769,
   "to": 144.249,
   "sid": 78,
   "location": 2,
   "content": "你就会既拥有很低的一个举球点",
   "music": 0
  },
  {
   "from": 144.249,
   "to": 146.59,
   "sid": 79,
   "location": 2,
   "content": "又拥有一个很高的出手点",
   "music": 0
  },
  {
   "from": 153.16,
   "to": 155.04,
   "sid": 80,
   "location": 2,
   "content": "虽然现在我们在篮下练",
   "music": 0
  },
  {
   "from": 155.04,
   "to": 157.9,
   "sid": 81,
   "location": 2,
   "content": "但是要牢牢记住这个柔和的感觉",
   "music": 0
  },
  {
   "from": 157.9,
   "to": 160.63,
   "sid": 82,
   "location": 2,
   "content": "往后退的时候也是完全一模一样的感觉",
   "music": 0
  },
  {
   "from": 160.63,
   "to": 163.28,
   "sid": 83,
   "location": 2,
   "content": "然后我们退",
   "music": 0
  },
  {
   "from": 164.9,
   "to": 165.94,
   "sid": 84,
   "location": 2,
   "content": "到一定距离之后",
   "music": 0
  },
  {
   "from": 165.94,
   "to": 170.62,
   "sid": 85,
   "location": 2,
   "content": "你会发现自己胳膊会忍不住在这里猛地去发力",
   "music": 0
  },
  {
   "from": 173.32,
   "to": 174.48,
   "sid": 86,
   "location": 2,
   "content": "这个时候怎么办",
   "music": 0
  },
  {
   "from": 174.48,
   "to": 177.75,
   "sid": 87,
   "location": 2,
   "content": "那就要上腿了",
   "music": 0.48999997549999613
  },
  {
   "from": 177.91,
   "to": 179.49,
   "sid": 88,
   "location": 2,
   "content": "上头有两种办法",
   "music": 0
  },
  {
   "from": 179.49,
   "to": 181.47,
   "sid": 89,
   "location": 2,
   "content": "第一种先左后右",
   "music": 0
  },
  {
   "from": 181.47,
   "to": 183.28,
   "sid": 90,
   "location": 2,
   "content": "一二步合球",
   "music": 0
  },
  {
   "from": 184.32,
   "to": 187.38,
   "sid": 91,
   "location": 2,
   "content": "第二种两者一起落地",
   "music": 0
  },
  {
   "from": 188.739,
   "to": 191.159,
   "sid": 92,
   "location": 2,
   "content": "呃SAM把这个过程叫做调节奏",
   "music": 0
  },
  {
   "from": 191.159,
   "to": 192.18,
   "sid": 93,
   "location": 2,
   "content": "基本功很好",
   "music": 0
  },
  {
   "from": 192.18,
   "to": 193.17,
   "sid": 94,
   "location": 2,
   "content": "但没有用",
   "music": 0
  },
  {
   "from": 193.17,
   "to": 194.19,
   "sid": 95,
   "location": 2,
   "content": "什么意思呢",
   "music": 0
  },
  {
   "from": 194.19,
   "to": 196.02,
   "sid": 96,
   "location": 2,
   "content": "就是只要你忍住手",
   "music": 0
  },
  {
   "from": 196.02,
   "to": 197.01,
   "sid": 97,
   "location": 2,
   "content": "不要去发力",
   "music": 0
  },
  {
   "from": 197.01,
   "to": 199.68,
   "sid": 98,
   "location": 2,
   "content": "腿会更早的绷紧",
   "music": 0
  },
  {
   "from": 199.68,
   "to": 202.82,
   "sid": 99,
   "location": 2,
   "content": "吃上力手呢也会更加的轻松",
   "music": 0
  },
  {
   "from": 202.82,
   "to": 204.59,
   "sid": 100,
   "location": 2,
   "content": "那关于投篮节奏啊",
   "music": 0
  },
  {
   "from": 204.59,
   "to": 207.58,
   "sid": 101,
   "location": 2,
   "content": "勇士主教弗雷泽有一段话我觉得说的非常好啊",
   "music": 0
  },
  {
   "from": 207.58,
   "to": 208.36,
   "sid": 102,
   "location": 2,
   "content": "那没错",
   "music": 0
  },
  {
   "from": 208.36,
   "to": 211.51,
   "sid": 103,
   "location": 2,
   "content": "就是这个家伙就是经常给库里捡球的这个家伙",
   "music": 0
  },
  {
   "from": 211.51,
   "to": 214.21,
   "sid": 104,
   "location": 2,
   "content": "他也是诺维斯基和纳什以前的住校",
   "music": 0
  },
  {
   "from": 214.21,
   "to": 216.58,
   "sid": 105,
   "location": 2,
   "content": "他就说过诺维斯基和纳什呢",
   "music": 0
  },
  {
   "from": 216.58,
   "to": 219.58,
   "sid": 106,
   "location": 2,
   "content": "他们关注的是怎么在投篮动作里减少变量",
   "music": 0
  },
  {
   "from": 219.58,
   "to": 220.72,
   "sid": 107,
   "location": 2,
   "content": "而对库里来说",
   "music": 0
  },
  {
   "from": 220.72,
   "to": 221.98,
   "sid": 108,
   "location": 2,
   "content": "节奏是高于一切的",
   "music": 0
  },
  {
   "from": 221.98,
   "to": 223.24,
   "sid": 109,
   "location": 2,
   "content": "Let's get flowing",
   "music": 0
  },
  {
   "from": 223.24,
   "to": 226.87,
   "sid": 110,
   "location": 2,
   "content": "那flow这个词呢也多次出现在库里的签名鞋里",
   "music": 0
  },
  {
   "from": 226.87,
   "to": 228.64,
   "sid": 111,
   "location": 2,
   "content": "那如果你flow本来就比较好",
   "music": 0.11976047187062451
  },
  {
   "from": 228.64,
   "to": 230.32,
   "sid": 112,
   "location": 2,
   "content": "接下来就可以上力量了好吧",
   "music": 0
  },
  {
