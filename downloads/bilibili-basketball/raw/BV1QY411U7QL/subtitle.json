 "body": [
  {
   "from": 0,
   "to": 1.38,
   "sid": 1,
   "location": 2,
   "content": "哈登招牌的过人技巧",
   "music": 0
  },
  {
   "from": 1.38,
   "to": 1.8,
   "sid": 2,
   "location": 2,
   "content": "鲨鱼不",
   "music": 0
  },
  {
   "from": 1.8,
   "to": 2.43,
   "sid": 3,
   "location": 2,
   "content": "你会吗",
   "music": 0
  },
  {
   "from": 2.43,
   "to": 3.78,
   "sid": 4,
   "location": 2,
   "content": "你做出来的过人效果",
   "music": 0
  },
  {
   "from": 3.78,
   "to": 5.34,
   "sid": 5,
   "location": 2,
   "content": "是不是跟你想象的不太一样",
   "music": 0
  },
  {
   "from": 5.34,
   "to": 7.7,
   "sid": 6,
   "location": 2,
   "content": "这招的关键呢完全是在于你的节奏",
   "music": 0
  },
  {
   "from": 7.7,
   "to": 9.68,
   "sid": 7,
   "location": 2,
   "content": "胯下拖曳步的时候要放慢速度",
   "music": 0
  },
  {
   "from": 9.68,
   "to": 11.6,
   "sid": 8,
   "location": 2,
   "content": "等到你变向胯下突破的时候呢",
   "music": 0
  },
  {
   "from": 11.6,
   "to": 12.44,
   "sid": 9,
   "location": 2,
   "content": "就要加快速度",
   "music": 0
  },
  {
   "from": 12.44,
   "to": 14,
   "sid": 10,
   "location": 2,
   "content": "而你做出来的效果不好",
   "music": 0
  },
  {
   "from": 14,
   "to": 15.47,
   "sid": 11,
   "location": 2,
   "content": "也有可能是衔接的问题",
   "music": 0
  },
  {
   "from": 15.47,
   "to": 17,
   "sid": 12,
   "location": 2,
   "content": "胯下退一步是一个节奏",
   "music": 0
  },
  {
   "from": 17,
   "to": 18.56,
   "sid": 13,
   "location": 2,
   "content": "变向胯下是另一个节奏",
   "music": 0
  },
  {
   "from": 18.56,
   "to": 21.26,
   "sid": 14,
   "location": 2,
   "content": "你千万不要把拖曳步变相做成了一个节奏",
   "music": 0
  },
  {
   "from": 21.26,
   "to": 24.08,
   "sid": 15,
   "location": 2,
   "content": "而最后突破的那一下就只能靠一个胯下运球了",
   "music": 0
  },
  {
   "from": 24.08,
   "to": 26.86,
   "sid": 16,
   "location": 2,
   "content": "这就是我为什么强调节奏是不能关键",
   "music": 0
  },
  {
   "from": 26.86,
   "to": 27.88,
   "sid": 17,
   "location": 2,
   "content": "刚开始练的时候",
   "music": 0
  },
  {
   "from": 27.88,
   "to": 30.8,
   "sid": 18,
   "location": 2,
   "content": "你可以把胯下拖曳步和变向胯下分开练习",
   "music": 0
  },
  {
   "from": 30.8,
   "to": 33.41,
   "sid": 19,
   "location": 2,
   "content": "这样你可以比较轻松的掌握这两个节奏",
   "music": 0
  },
  {
   "from": 33.41,
   "to": 35.39,
   "sid": 20,
   "location": 2,
   "content": "以免你后面的衔接出现问题",
   "music": 0
  },
  {
   "from": 35.39,
   "to": 36.32,
   "sid": 21,
   "location": 2,
   "content": "那到这里",
   "music": 0
  },
  {
   "from": 36.32,
   "to": 38.98,
   "sid": 22,
   "location": 2,
   "content": "这招鲨鱼步你基本就学会了",
   "music": 0
  }
 ]
}