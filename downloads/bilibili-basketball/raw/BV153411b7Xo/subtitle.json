{
 "font_size": 0.4,
 "font_color": "#FFFFFF",
 "background_alpha": 0.5,
 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "en-v1.2.0.4-t0.3.c",
 "body": [
  {
   "from": 0.32,
   "to": 0.76,
   "sid": 1,
   "location": 2,
   "content": "怎么了？"
  },
  {
   "from": 0.76,
   "to": 1.6,
   "sid": 2,
   "location": 2,
   "content": "我喜欢篮球电视"
  },
  {
   "from": 1.6,
   "to": 2.64,
   "sid": 3,
   "location": 2,
   "content": "我是瑞安·拉祖基教练"
  },
  {
   "from": 2.64,
   "to": 6.36,
   "sid": 4,
   "location": 2,
   "content": "今天我要给你们十招，你们可以在真正的游戏中使用"
  },
  {
   "from": 6.36,
   "to": 7.36,
   "sid": 5,
   "location": 2,
   "content": "约翰和我在一起"
  },
  {
   "from": 7.36,
   "to": 8.62,
   "sid": 6,
   "location": 2,
   "content": "谁打大学篮球"
  },
  {
   "from": 8.62,
   "to": 10.2,
   "sid": 7,
   "location": 2,
   "content": "他今天要经历动作"
  },
  {
   "from": 14.6,
   "to": 15.16,
   "sid": 8,
   "location": 2,
   "content": "让我们开始吧"
  },
  {
   "from": 15.16,
   "to": 17.02,
   "sid": 9,
   "location": 2,
   "content": "你觉得有点太小了"
  },
  {
   "from": 17.02,
   "to": 18.04,
   "sid": 10,
   "location": 2,
   "content": "我有远大的目标"
  },
  {
   "from": 18.04,
   "to": 18.92,
   "sid": 11,
   "location": 2,
   "content": "宝贝"
  },
  {
   "from": 20.46,
   "to": 22.54,
   "sid": 12,
   "location": 2,
   "content": "所以你的前五个动作是在篮下"
  },
  {
   "from": 22.54,
   "to": 24.58,
   "sid": 13,
   "location": 2,
   "content": "确保我们能吸引接触和避免防御"
  },
  {
   "from": 24.58,
   "to": 26.04,
   "sid": 14,
   "location": 2,
   "content": "这样我们就可以在篮筐上完成了"
  },
  {
   "from": 26.04,
   "to": 28.6,
   "sid": 15,
   "location": 2,
   "content": "确保我们可以在那里转换，并获得免费的这些以及"
  },
  {
   "from": 28.6,
   "to": 30.68,
   "sid": 16,
   "location": 2,
   "content": "然后你就会进入你所有的跳投"
  },
  {
   "from": 30.68,
   "to": 32.96,
   "sid": 17,
   "location": 2,
   "content": "确保我们在不同类型的投篮中都有正确的步法"
  },
  {
   "from": 32.96,
   "to": 35.04,
   "sid": 18,
   "location": 2,
   "content": "你要拍下每一场比赛"
  },
  {
   "from": 35.04,
   "to": 37.16,
   "sid": 19,
   "location": 2,
   "content": "所以在篮下的第一个人将是一个转向步"
  },
  {
   "from": 37.16,
   "to": 37.96,
   "sid": 20,
   "location": 2,
   "content": "我要教你怎么做"
  },
  {
   "from": 37.96,
   "to": 39.06,
   "sid": 21,
   "location": 2,
   "content": "所以你可以先看到它"
  },
  {
   "from": 39.06,
   "to": 40.28,
   "sid": 22,
   "location": 2,
   "content": "但我们要打这里"
  },
  {
   "from": 40.28,
   "to": 42.7,
   "sid": 23,
   "location": 2,
   "content": "一个快速的小动作，然后运球"
  },
  {
   "from": 42.7,
   "to": 45.28,
   "sid": 24,
   "location": 2,
   "content": "我要从这里开始"
  },
  {
   "from": 45.28,
   "to": 45.92,
   "sid": 25,
   "location": 2,
   "content": "所以比较容易"
  },
  {
   "from": 45.92,
   "to": 47.38,
   "sid": 26,
   "location": 2,
   "content": "所以移动是这样工作的"
  },
  {
   "from": 48.96,
   "to": 51.4,
   "sid": 27,
   "location": 2,
   "content": "当我们推的时候左脚会碰到地面"
  },
  {
   "from": 51.4,
   "to": 52.48,
   "sid": 28,
   "location": 2,
   "content": "同时我们运球"
  },
  {
   "from": 52.48,
   "to": 54.64,
   "sid": 29,
   "location": 2,
   "content": "这意味着这不算是你的步骤之一"
  },
  {
   "from": 54.64,
   "to": 56.8,
   "sid": 30,
   "location": 2,
   "content": "现在我们可以在这之后走两步"
  },
  {
   "from": 56.8,
   "to": 58.4,
   "sid": 31,
   "location": 2,
   "content": "所以焦点准备好了"
  },
  {
   "from": 58.4,
   "to": 59.28,
   "sid": 32,
   "location": 2,
   "content": "这就是你能做到的"
  },
  {
   "from": 59.28,
   "to": 61.75,
   "sid": 33,
   "location": 2,
   "content": "你要在一次运球之间准备好"
  },
  {
   "from": 61.75,
   "to": 63.25,
   "sid": 34,
   "location": 2,
   "content": "和我在一起，现在和我在一起"
  },
  {
   "from": 63.25,
   "to": 64.25,
   "sid": 35,
   "location": 2,
   "content": "你现在要走两步"
  },
  {
   "from": 64.25,
   "to": 65.83,
   "sid": 36,
   "location": 2,
   "content": "所以第一步是努力前进"
  },
  {
   "from": 65.83,
   "to": 67.46,
   "sid": 37,
   "location": 2,
   "content": "就像这个繁荣"
  },
  {
   "from": 67.46,
   "to": 69.28,
   "sid": 38,
   "location": 2,
   "content": "第二步是防守"
  },
  {
   "from": 69.28,
   "to": 71.04,
   "sid": 39,
   "location": 2,
   "content": "就像这个嘣酷"
  },
  {
   "from": 71.04,
   "to": 72.42,
   "sid": 40,
   "location": 2,
   "content": "现在你要做这件事的方式"
  },
  {
   "from": 72.42,
   "to": 77.2,
   "sid": 41,
   "location": 2,
   "content": "正确的方法是确保你把左手放在右耳上是有意义的"
  },
  {
   "from": 78.62,
   "to": 79.44,
   "sid": 42,
   "location": 2,
   "content": "所以要小心"
  },
  {
   "from": 79.44,
   "to": 80.14,
   "sid": 43,
   "location": 2,
   "content": "所以我展示了它"
  },
  {
   "from": 80.14,
   "to": 85.24,
   "sid": 44,
   "location": 2,
   "content": "所以我们在中间，一次运球进入防守"
  },
  {
   "from": 85.24,
   "to": 88.68,
   "sid": 45,
   "location": 2,
   "content": "然后在那里完成上篮很有意义完美"
  },
  {
   "from": 88.68,
   "to": 89.4,
   "sid": 46,
   "location": 2,
   "content": "让我们找两个代表"
  },
  {
   "from": 89.4,
   "to": 90.28,
   "sid": 47,
   "location": 2,
   "content": "就像这样"
  },
  {
   "from": 92.48,
   "to": 93.68,
   "sid": 48,
   "location": 2,
   "content": "一二完美"
  },
  {
   "from": 94.76,
   "to": 96.04,
   "sid": 49,
   "location": 2,
   "content": "尽量不要褪色太多"
  },
  {
   "from": 96.04,
   "to": 96.44,
   "sid": 50,
   "location": 2,
   "content": "对呀"
  },
  {
   "from": 96.44,
   "to": 97.48,
   "sid": 51,
   "location": 2,
   "content": "你想撞我"
  },
  {
   "from": 97.48,
   "to": 99.16,
   "sid": 52,
   "location": 2,
   "content": "你想撞我，把我挪开"
  },
  {
   "from": 99.16,
   "to": 99.899,
   "sid": 53,
   "location": 2,
   "content": "你去"
  },
  {
   "from": 101.74,
   "to": 103.29,
   "sid": 54,
   "location": 2,
   "content": "一二完美"
  },
  {
   "from": 103.29,
   "to": 104.03,
   "sid": 55,
   "location": 2,
   "content": "就像这样"
  },
  {
   "from": 104.03,
   "to": 105.05,
   "sid": 56,
   "location": 2,
   "content": "所以这是你的第一步"
  },
  {
   "from": 105.05,
   "to": 106.11,
   "sid": 57,
   "location": 2,
   "content": "我知道这很简单"
  },
  {
   "from": 106.11,
   "to": 108.15,
   "sid": 58,
   "location": 2,
   "content": "但这是你的啤酒步"
  },
  {
   "from": 108.15,
   "to": 111.46,
   "sid": 59,
   "location": 2,
   "content": "你会看到玩家最常见的问题是当他们接触到"
  },
  {
   "from": 111.46,
   "to": 112.3,
   "sid": 60,
   "location": 2,
   "content": "他们是这样做的"
  },
  {
   "from": 112.3,
   "to": 112.64,
   "sid": 61,
   "location": 2,
   "content": "准备好了"
  },
  {
   "from": 112.64,
   "to": 114.1,
   "sid": 62,
   "location": 2,
   "content": "一二"
  },
  {
   "from": 114.1,
   "to": 115.02,
   "sid": 63,
   "location": 2,
   "content": "那里有什么问题？"
  },
  {
   "from": 115.02,
   "to": 115.84,
   "sid": 64,
   "location": 2,
   "content": "暴露的球"
  },
  {
   "from": 115.84,
   "to": 117.26,
   "sid": 65,
   "location": 2,
   "content": "所以让我们确保我们保持球的方式"
  },
  {
   "from": 117.26,
   "to": 118.24,
   "sid": 66,
   "location": 2,
   "content": "你做得很好"
  },
  {
   "from": 118.24,
   "to": 119.14,
   "sid": 67,
   "location": 2,
   "content": "下一个在这里"
  },
  {
   "from": 119.14,
   "to": 120.36,
   "sid": 68,
   "location": 2,
   "content": "我们要做同样的事情"
  },
  {
   "from": 120.48,
   "to": 123.22,
   "sid": 69,
   "location": 2,
   "content": "从三分线开始"
  },
  {
   "from": 123.22,
   "to": 124.32,
   "sid": 70,
   "location": 2,
   "content": "我们要运球两次"
  },
  {
   "from": 124.32,
   "to": 127.26,
   "sid": 71,
   "location": 2,
   "content": "所以我们在一个和现在之间"
  },
  {
   "from": 127.26,
   "to": 131.02,
   "sid": 72,
   "location": 2,
   "content": "在第二次运球时，你要在左脚击球的同时撞我"
  },
  {
   "from": 131.079,
   "to": 134.02,
   "sid": 73,
   "location": 2,
   "content": "所以现在在第二次运球时，你会砰的一声命中"
  },
  {
   "from": 134.2,
   "to": 135.94,
   "sid": 74,
   "location": 2,
   "content": "然后我们离开一步"
  },
  {
   "from": 135.94,
   "to": 137.48,
   "sid": 75,
   "location": 2,
   "content": "完成他的右手右脚"
  },
  {
   "from": 137.48,
   "to": 140.92,
   "sid": 76,
   "location": 2,
   "content": "所以你在后面一点和两次运球之间"
  },
  {
   "from": 141.5,
   "to": 144.42,
   "sid": 77,
   "location": 2,
   "content": "所以一个屁股我砰的一步"
  },
  {
   "from": 144.42,
   "to": 144.7,
   "sid": 78,
   "location": 2,
   "content": "是的"
  },
  {
   "from": 144.7,
   "to": 145.82,
   "sid": 79,
   "location": 2,
   "content": "你会拿到篮筐的"
  },
  {
   "from": 148.66,
   "to": 150.9,
   "sid": 80,
   "location": 2,
   "content": "完美的一步"
  },
  {
   "from": 150.9,
   "to": 151.24,
   "sid": 81,
   "location": 2,
   "content": "只是"
  },
  {
   "from": 151.24,
   "to": 151.46,
   "sid": 82,
   "location": 2,
   "content": "哦"
  },
  {
   "from": 151.46,
   "to": 151.92,
   "sid": 83,
   "location": 2,
   "content": "那很好"
  },
  {
   "from": 151.92,
   "to": 152.66,
   "sid": 84,
   "location": 2,
   "content": "太完美了"
  },
  {
   "from": 152.66,
   "to": 153.3,
   "sid": 85,
   "location": 2,
   "content": "再来两个代表"
  },
  {
   "from": 153.3,
   "to": 153.62,
   "sid": 86,
   "location": 2,
   "content": "你得到了它"
  },
  {
   "from": 153.62,
   "to": 154.42,
   "sid": 87,
   "location": 2,
   "content": "我抓住你了"
  },
  {
   "from": 156.44,
   "to": 157.72,
   "sid": 88,
   "location": 2,
   "content": "推一个肿块"
  },
  {
   "from": 157.72,
   "to": 158.16,
   "sid": 89,
   "location": 2,
   "content": "是呀"
  },
  {
   "from": 158.16,
   "to": 159.94,
   "sid": 90,
   "location": 2,
   "content": "现在你能给我一个更好的颠簸吗"
  },
  {
   "from": 159.94,
   "to": 161.48,
   "sid": 91,
   "location": 2,
   "content": "我真的很喜欢我"
  },
  {
   "from": 161.48,
   "to": 162.04,
   "sid": 92,
   "location": 2,
   "content": "同时"
  },
  {
   "from": 162.04,
   "to": 163.06,
   "sid": 93,
   "location": 2,
   "content": "你带球运球"
  },
  {
   "from": 167.979,
   "to": 168.619,
   "sid": 94,
   "location": 2,
   "content": "太完美了"
  },
  {
   "from": 168.619,
   "to": 169.859,
   "sid": 95,
   "location": 2,
   "content": "不过，现在听听这个"
  },
  {
   "from": 169.859,
   "to": 171.159,
   "sid": 96,
   "location": 2,
   "content": "这个动作很酷的地方是"
  },
  {
   "from": 171.159,
   "to": 173.92,
   "sid": 97,
   "location": 2,
   "content": "因为在运球的时候你是向前的"
  },
  {
   "from": 173.92,
   "to": 175.18,
   "sid": 98,
   "location": 2,
   "content": "我们只走了一步"
  },
  {
   "from": 175.18,
   "to": 175.94,
   "sid": 99,
   "location": 2,
   "content": "所以疯狂的是"
  },
  {
   "from": 175.94,
   "to": 177.76,
   "sid": 100,
   "location": 2,
   "content": "你实际上可以选择采取两步"
  },
  {
   "from": 177.76,
   "to": 179.23,
   "sid": 101,
   "location": 2,
   "content": "如果你更先进"
  },
  {
   "from": 179.23,
   "to": 180.79,
   "sid": 102,
   "location": 2,
   "content": "所以再试一次"
  },
  {
   "from": 180.79,
   "to": 181.93,
   "sid": 103,
   "location": 2,
   "content": "我要支持你"
  },
  {
   "from": 181.93,
   "to": 183.89,
   "sid": 104,
   "location": 2,
   "content": "你真的能撞到我，走两步"
  },
  {
   "from": 183.89,
   "to": 184.77,
   "sid": 105,
   "location": 2,
   "content": "在那个颠簸之后"
  },
  {
   "from": 184.77,
   "to": 185.62,
   "sid": 106,
   "location": 2,
   "content": "去吧"
  },
  {
   "from": 186.82,
   "to": 187.32,
   "sid": 107,
   "location": 2,
   "content": "嗯"
  },
  {
   "from": 187.32,
   "to": 189,
   "sid": 108,
   "location": 2,
   "content": "一个所以你拿了一个"
  },
  {
   "from": 189,
   "to": 190.42,
   "sid": 109,
   "location": 2,
   "content": "你喜欢看防守"
  },
  {
   "from": 190.42,
   "to": 191.4,
   "sid": 110,
   "location": 2,
   "content": "你可以拿两个"
  },
  {
   "from": 191.4,
   "to": 193.74,
   "sid": 111,
   "location": 2,
   "content": "对于有能力的玩家来说，这是超级先进的"
  },
  {
   "from": 193.74,
   "to": 194.22,
   "sid": 112,
   "location": 2,
   "content": "所以你在"
  },
  {
   "from": 194.22,
   "to": 194.58,
   "sid": 113,
   "location": 2,
   "content": "d"
  },
  {
   "from": 194.58,
   "to": 195.86,
   "sid": 114,
   "location": 2,
   "content": "如果我想来这里"
  },
  {
   "from": 195.86,
   "to": 199.15,
   "sid": 115,
   "location": 2,
   "content": "我可以去一二俱乐部"
  },
  {
   "from": 199.15,
   "to": 201.35,
   "sid": 116,
   "location": 2,
   "content": "因为我运球的同时我撞了"
  },
  {
   "from": 201.35,
   "to": 204.3,
   "sid": 117,
   "location": 2,
   "content": "但那是你的八磅"
  },
  {
   "from": 204.3,
   "to": 206.9,
   "sid": 118,
   "location": 2,
   "content": "所以你有运球碰撞的能力"
  },
  {
   "from": 206.9,
   "to": 208.64,
   "sid": 119,
   "location": 2,
   "content": "走一步或两步"
  },
  {
   "from": 208.64,
   "to": 210.329,
   "sid": 120,
   "location": 2,
   "content": "你在篮筐上看到很多强壮的球员"
  },
  {
   "from": 210.329,
   "to": 211.429,
   "sid": 121,
   "location": 2,
   "content": "试着画这个联系人"
  },
  {
   "from": 211.429,
   "to": 214.569,
   "sid": 122,
   "location": 2,
   "content": "它们一分开就可以选择更快地上升"
  },
  {
   "from": 214.569,
   "to": 217.649,
   "sid": 123,
   "location": 2,
   "content": "甚至可以选择继续在篮筐里移动"
  },
  {
   "from": 217.649,
   "to": 219.88,
   "sid": 124,
   "location": 2,
   "content": "来逆转我们的第三个"
  },
  {
   "from": 219.88,
   "to": 221.02,
   "sid": 125,
   "location": 2,
   "content": "我们要谈谈"
  },
  {
   "from": 221.02,
   "to": 222.919,
   "sid": 126,
   "location": 2,
   "content": "在"
  },
  {
   "from": 222.919,
   "to": 223.319,
   "sid": 127,
   "location": 2,
   "content": "空气"
  },
  {
   "from": 223.319,
   "to": 228.16,
   "sid": 128,
   "location": 2,
   "content": "所以你要抬高，试着把球带到篮筐"
  },
  {
   "from": 228.16,
   "to": 228.64,
   "sid": 129,
   "location": 2,
   "content": "对"
  },
  {
   "from": 228.64,
