 "body": [
  {
   "from": 0.36,
   "to": 4.18,
   "sid": 1,
   "location": 2,
   "content": "今天给兄弟们分享一下我们在实战中辅助手的三种用法"
  },
  {
   "from": 4.18,
   "to": 6.94,
   "sid": 2,
   "location": 2,
   "content": "首先第一种就是我们在持球三威胁的过程中"
  },
  {
   "from": 6.94,
   "to": 8.98,
   "sid": 3,
   "location": 2,
   "content": "我们可以利用辅助手去过掉防守"
  },
  {
   "from": 8.98,
   "to": 12.28,
   "sid": 4,
   "location": 2,
   "content": "如果防守人其实在这个过程中侵犯你的圆柱体"
  },
  {
   "from": 12.28,
   "to": 13.66,
   "sid": 5,
   "location": 2,
   "content": "或者给你上身体放松"
  },
  {
   "from": 13.66,
   "to": 16.3,
   "sid": 6,
   "location": 2,
   "content": "哎你可以利用你的辅助手直接挤压"
  },
  {
   "from": 16.3,
   "to": 16.88,
   "sid": 7,
   "location": 2,
   "content": "不"
  },
  {
   "from": 19.24,
   "to": 21.3,
   "sid": 8,
   "location": 2,
   "content": "之后飞过去"
  },
  {
   "from": 23.7,
   "to": 25.88,
   "sid": 9,
   "location": 2,
   "content": "第二种情况就是我们在突破过程中"
  },
  {
   "from": 25.88,
   "to": 30.23,
   "sid": 10,
   "location": 2,
   "content": "防守人习惯把手阻挡在你行进的路程路线上"
  },
  {
   "from": 30.23,
   "to": 32.21,
   "sid": 11,
   "location": 2,
   "content": "经常让你形成这种情况"
  },
  {
   "from": 32.21,
   "to": 33.5,
   "sid": 12,
   "location": 2,
   "content": "哎挡着你"
  },
  {
   "from": 33.5,
   "to": 36.22,
   "sid": 13,
   "location": 2,
   "content": "那这时候我们可以利用我们的辅助手"
  },
  {
   "from": 36.22,
   "to": 36.82,
   "sid": 14,
   "location": 2,
   "content": "小心啊"
  },
  {
   "from": 36.82,
   "to": 37.81,
   "sid": 15,
   "location": 2,
   "content": "有个加速"
  },
  {
   "from": 37.81,
   "to": 39.28,
   "sid": 16,
   "location": 2,
   "content": "走不动手"
  },
  {
   "from": 39.28,
   "to": 43.339,
   "sid": 17,
   "location": 2,
   "content": "来一步手打你右手来"
  },
  {
   "from": 46.8,
   "to": 48.74,
   "sid": 18,
   "location": 2,
   "content": "第三种就是我们在行进过程中"
  },
  {
   "from": 48.74,
   "to": 50.54,
   "sid": 19,
   "location": 2,
   "content": "我们在找突破机会过"
  },
  {
   "from": 50.54,
   "to": 53.96,
   "sid": 20,
   "location": 2,
   "content": "如果防守人的手始终站在你的身体前方"
  },
  {
   "from": 53.96,
   "to": 58.04,
   "sid": 21,
   "location": 2,
   "content": "你就可以朝它上手来配一只手去做空调加速"
  },
  {
   "from": 58.04,
   "to": 59.459,
   "sid": 22,
   "location": 2,
   "content": "直接手滑板"
  },
  {
   "from": 64.38,
   "to": 65.26,
   "sid": 23,
   "location": 2,
   "content": "啊"
  }
 ]
}