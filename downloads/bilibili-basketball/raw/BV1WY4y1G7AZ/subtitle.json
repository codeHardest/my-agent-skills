 "body": [
  {
   "from": 0.4,
   "to": 1.54,
   "sid": 1,
   "location": 2,
   "content": "今天给大家分享一下",
   "music": 0
  },
  {
   "from": 1.54,
   "to": 3.1,
   "sid": 2,
   "location": 2,
   "content": "新手如何训练一些反派拉回",
   "music": 0
  },
  {
   "from": 3.1,
   "to": 5.08,
   "sid": 3,
   "location": 2,
   "content": "让我们更快地运用到实战中",
   "music": 0
  },
  {
   "from": 5.08,
   "to": 7.18,
   "sid": 4,
   "location": 2,
   "content": "首先第一步我们过运球姿态",
   "music": 0
  },
  {
   "from": 7.18,
   "to": 11.3,
   "sid": 5,
   "location": 2,
   "content": "我们朝防守人45度的方向突破一次发运球",
   "music": 0
  },
  {
   "from": 11.3,
   "to": 13.96,
   "sid": 6,
   "location": 2,
   "content": "尽可能的把我们的胳膊舒展出去",
   "music": 0
  },
  {
   "from": 13.96,
   "to": 15.22,
   "sid": 7,
   "location": 2,
   "content": "只能做群体运球",
   "music": 0
  },
  {
   "from": 15.22,
   "to": 20.44,
   "sid": 8,
   "location": 2,
   "content": "这招我们我们收回换方向突破翻",
   "music": 0
  },
  {
   "from": 20.44,
   "to": 21.67,
   "sid": 9,
   "location": 2,
   "content": "这招不错",
   "music": 0
  },
  {
   "from": 21.67,
   "to": 24.24,
   "sid": 10,
   "location": 2,
   "content": "跟他手一起看上我心头",
   "music": 0
  },
  {
   "from": 40.019,
   "to": 40.619,
   "sid": 11,
   "location": 2,
   "content": "第二步呢",
   "music": 0
  },
  {
   "from": 40.619,
   "to": 43.019,
   "sid": 12,
   "location": 2,
   "content": "我们在第一步的基础上加入一个反胯下拉回",
   "music": 0
  },
  {
   "from": 43.019,
   "to": 44.819,
   "sid": 13,
   "location": 2,
   "content": "不要我们的运球姿态打开",
   "music": 0
  },
  {
   "from": 44.819,
   "to": 48.08,
   "sid": 14,
   "location": 2,
   "content": "这时候我们圈运球衔接圈圈以后",
   "music": 0
  },
  {
   "from": 48.08,
   "to": 50.81,
   "sid": 15,
   "location": 2,
   "content": "我们脚朝我们的追捧外上步",
   "music": 0
  },
  {
   "from": 50.81,
   "to": 52.84,
   "sid": 16,
   "location": 2,
   "content": "同时我腿好反胯下拉回",
   "music": 0
  },
  {
   "from": 57.9,
   "to": 60.059,
   "sid": 17,
   "location": 2,
   "content": "把腰进可可挺实战",
   "music": 0
  },
  {
   "from": 80.84,
   "to": 84.1,
   "sid": 18,
   "location": 2,
   "content": "最后一步我们为了贴合实战去做一次坠步行",
   "music": 0
  },
  {
   "from": 84.1,
   "to": 85.66,
   "sid": 19,
   "location": 2,
   "content": "第一的防滑拉胯球场后",
   "music": 0
  },
  {
   "from": 85.66,
   "to": 87.85,
   "sid": 20,
   "location": 2,
   "content": "我们连续就完全不住上",
   "music": 0
  },
  {
   "from": 87.85,
   "to": 88.9,
   "sid": 21,
   "location": 2,
   "content": "在这一过程中",
   "music": 0
  },
  {
   "from": 88.9,
   "to": 92.669,
   "sid": 22,
   "location": 2,
   "content": "通过我们在高速的情况下完成马赛拉图的动作",
   "music": 0
  },
  {
   "from": 92.669,
   "to": 97.19,
   "sid": 23,
   "location": 2,
   "content": "我的脚有一个朝内的一个地方是一个能量",
   "music": 0
  },
  {
   "from": 97.249,
   "to": 99.38,
   "sid": 24,
   "location": 2,
   "content": "这样会让我们的重心不稳",
   "music": 0
  },
  {
   "from": 99.38,
   "to": 102.5,
   "sid": 25,
   "location": 2,
   "content": "导致我们在一起前往中脚腕受伤",
   "music": 0
  },
  {
   "from": 103.02,
   "to": 104.39,
   "sid": 26,
   "location": 2,
   "content": "运球过高",
   "music": 0
  },
  {
   "from": 104.39,
   "to": 106.28,
   "sid": 27,
   "location": 2,
   "content": "我们在右边左右",
   "music": 0
  },
  {
   "from": 107.26,
   "to": 109.62,
   "sid": 28,
   "location": 2,
   "content": "这样可以有一个角度去",
   "music": 0
  },
  {
   "from": 109.62,
   "to": 111.24,
   "sid": 29,
   "location": 2,
   "content": "然后我们再写点退出",
   "music": 0
  },
  {
   "from": 111.24,
   "to": 112.5,
   "sid": 30,
   "location": 2,
   "content": "然后再往下推",
   "music": 0
  },
  {
   "from": 112.5,
   "to": 113.52,
   "sid": 31,
   "location": 2,
   "content": "是一个角度",
   "music": 0
  },
  {
   "from": 116.02,
   "to": 116.9,
   "sid": 32,
   "location": 2,
   "content": "住手",
   "music": 0
  }
 ]
