  {
   "from": 0,
   "to": 3.36,
   "sid": 1,
   "location": 2,
   "content": "如果你还不会球场上最优雅的小提琴变相过人"
  },
  {
   "from": 3.36,
   "to": 7.2,
   "sid": 2,
   "location": 2,
   "content": "楠哥分享一套嘎嘎好用的小提琴过人训练一招多用"
  },
  {
   "from": 7.2,
   "to": 8.58,
   "sid": 3,
   "location": 2,
   "content": "let's go bb"
  },
  {
   "from": 9.659,
   "to": 11.899,
   "sid": 4,
   "location": 2,
   "content": "首先去做这个惯性拉球"
  },
  {
   "from": 11.899,
   "to": 14.05,
   "sid": 5,
   "location": 2,
   "content": "利用惯性将球前后拉回"
  },
  {
   "from": 14.05,
   "to": 15.7,
   "sid": 6,
   "location": 2,
   "content": "多去感受手腕翻转"
  },
  {
   "from": 15.7,
   "to": 18.51,
   "sid": 7,
   "location": 2,
   "content": "接下来拖着球将球从后向前推"
  },
  {
   "from": 18.51,
   "to": 19.5,
   "sid": 8,
   "location": 2,
   "content": "再向后拉"
  },
  {
   "from": 19.5,
   "to": 21.27,
   "sid": 9,
   "location": 2,
   "content": "顺势做一个背后绕球"
  },
  {
   "from": 21.27,
   "to": 25.42,
   "sid": 10,
   "location": 2,
   "content": "做背后绕球时要注意球是从屁股上面过去的侧身"
  },
  {
   "from": 25.42,
   "to": 27.43,
   "sid": 11,
   "location": 2,
   "content": "同时让手臂像这样去绕"
  },
  {
   "from": 27.43,
   "to": 29.4,
   "sid": 12,
   "location": 2,
   "content": "熟练后就做口袋运球"
  },
  {
   "from": 29.4,
   "to": 34.61,
   "sid": 13,
   "location": 2,
   "content": "再将前面的推拉动作和背后绕球连在一起去做上面的手活都会了"
  },
  {
   "from": 34.61,
   "to": 35.9,
   "sid": 14,
   "location": 2,
   "content": "咱们做完口袋后"
  },
  {
   "from": 35.9,
   "to": 37.04,
   "sid": 15,
   "location": 2,
   "content": "马上形成坠步"
  },
  {
   "from": 37.04,
   "to": 39.59,
   "sid": 16,
   "location": 2,
   "content": "再向前迈步子时做推拉动作"
  },
  {
   "from": 39.59,
   "to": 41.6,
   "sid": 17,
   "location": 2,
   "content": "马上再衔接背后绕球即可"
  },
  {
   "from": 41.6,
   "to": 44.72,
   "sid": 18,
   "location": 2,
   "content": "这样对防守人的迷惑性和误导性是非常大的"
  },
  {
   "from": 44.72,
   "to": 48.24,
   "sid": 19,
   "location": 2,
   "content": "我们也可以在变相后去做小提琴动作训练时"
  },
  {
   "from": 48.24,
   "to": 50.22,
   "sid": 20,
   "location": 2,
   "content": "像我这样做完变向后"
  },
  {
   "from": 50.22,
   "to": 52.68,
   "sid": 21,
   "location": 2,
   "content": "在做推拉和背后绕球就ok了"
  },
  {
   "from": 57.75,
   "to": 59.4,
   "sid": 22,
   "location": 2,
   "content": "马上做推拉的动作"
  },
  {
   "from": 59.4,
   "to": 60.6,
   "sid": 23,
   "location": 2,
   "content": "在家背后绕球"
  },
  {
   "from": 60.6,
   "to": 61.56,
   "sid": 24,
   "location": 2,
   "content": "你学废了吗"
  },
  {
   "from": 61.56,
   "to": 63.36,
   "sid": 25,
   "location": 2,
   "content": "抓紧紧的收藏练起来吧"
  },
  {
   "from": 63.36,
