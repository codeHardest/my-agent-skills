   "sid": 1,
   "location": 2,
   "content": "所以这就是我们所缺少的"
  },
  {
   "from": 3.62,
   "to": 5.08,
   "sid": 2,
   "location": 2,
   "content": "所以你要穿越"
  },
  {
   "from": 5.08,
   "to": 6.86,
   "sid": 3,
   "location": 2,
   "content": "看看你是怎么弹的"
  },
  {
   "from": 6.86,
   "to": 11.84,
   "sid": 4,
   "location": 2,
   "content": "但要注意这个肘部保持在弯曲的位置"
  },
  {
   "from": 11.84,
   "to": 14.56,
   "sid": 5,
   "location": 2,
   "content": "所以现在你处于一个更好的位置把球击倒"
  },
  {
   "from": 14.56,
   "to": 16.219,
   "sid": 6,
   "location": 2,
   "content": "不要用球吹"
  },
  {
   "from": 16.219,
   "to": 18.62,
   "sid": 7,
   "location": 2,
   "content": "所以你首先要吸收它"
  },
  {
   "from": 18.64,
   "to": 20.34,
   "sid": 8,
   "location": 2,
   "content": "现在它可以浮起来了"
  },
  {
   "from": 20.34,
   "to": 21.08,
   "sid": 9,
   "location": 2,
   "content": "但我想看看"
  },
  {
   "from": 21.08,
   "to": 23.28,
   "sid": 10,
   "location": 2,
   "content": "如果我们能把肘部伸直一点"
  },
  {
   "from": 23.28,
   "to": 23.72,
   "sid": 11,
   "location": 2,
   "content": "现在"
  },
  {
   "from": 23.72,
   "to": 24.66,
   "sid": 12,
   "location": 2,
   "content": "我给你看看这个"
  },
  {
   "from": 24.66,
   "to": 28.76,
   "sid": 13,
   "location": 2,
   "content": "所以这就是我们还没找到的地方"
  },
  {
   "from": 28.76,
   "to": 30.2,
   "sid": 14,
   "location": 2,
   "content": "所以这将是一个拖累"
  },
  {
   "from": 30.2,
   "to": 32.019,
   "sid": 15,
   "location": 2,
   "content": "但它仍然是那个浮动位置"
  },
  {
   "from": 32.5,
   "to": 35.18,
   "sid": 16,
   "location": 2,
   "content": "把我们的肘部伸直"
  },
  {
   "from": 35.18,
   "to": 37.2,
   "sid": 17,
   "location": 2,
   "content": "完成交叉"
  },
  {
   "from": 37.2,
   "to": 41.05,
   "sid": 18,
   "location": 2,
   "content": "就像这是我们试图获得的一张很好的照片"
  },
  {
   "from": 41.05,
   "to": 43.73,
   "sid": 19,
   "location": 2,
   "content": "因为现在你的两个肘部都得到了充分的伸展"
  },
  {
   "from": 43.73,
   "to": 46.57,
   "sid": 20,
   "location": 2,
   "content": "我现在还没有看到任何真正的扩展"
  },
  {
   "from": 46.57,
   "to": 47.85,
   "sid": 21,
   "location": 2,
   "content": "当你到达你的口袋"
  },
  {
   "from": 47.85,
   "to": 49.26,
   "sid": 22,
   "location": 2,
   "content": "它就会流动"
  },
  {
   "from": 49.4,
   "to": 51.08,
   "sid": 23,
   "location": 2,
   "content": "然后它就会回来"
  },
  {
   "from": 51.08,
   "to": 53.08,
   "sid": 24,
   "location": 2,
   "content": "那是我们看到通风口位置的地方"
  },
  {
   "from": 53.08,
   "to": 54.82,
   "sid": 25,
   "location": 2,
   "content": "但我们不想在这里看到它"
  },
  {
   "from": 54.82,
   "to": 56.06,
   "sid": 26,
   "location": 2,
   "content": "我们想出去"
  },
  {
   "from": 56.06,
   "to": 57.04,
   "sid": 27,
   "location": 2,
   "content": "这就是我们所缺少的"
  },
  {
   "from": 57.04,
   "to": 57.82,
   "sid": 28,
   "location": 2,
   "content": "所以生气"
  },
  {
   "from": 57.82,
   "to": 58.72,
   "sid": 29,
   "location": 2,
   "content": "流出来"
  },
  {
   "from": 58.72,
   "to": 59.88,
   "sid": 30,
   "location": 2,
   "content": "然后操纵"
  }
 ]
