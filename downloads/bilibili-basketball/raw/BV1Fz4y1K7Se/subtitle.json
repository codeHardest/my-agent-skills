 "type": "AIsubtitle",
 "lang": "zh",
 "version": "v1.6.0.4",
 "body": [
  {
   "from": 0.18,
   "to": 2.91,
   "sid": 1,
   "location": 2,
   "content": "这是9月从香港远赴重庆来找我",
   "music": 0
  },
  {
   "from": 2.91,
   "to": 5.16,
   "sid": 2,
   "location": 2,
   "content": "做发力矫正与投篮技术优化的",
   "music": 0
  },
  {
   "from": 5.16,
   "to": 7.109,
   "sid": 3,
   "location": 2,
   "content": "一位中学篮球教练",
   "music": 0
  },
  {
   "from": 7.109,
   "to": 10.67,
   "sid": 4,
   "location": 2,
   "content": "这三分跳投已经真的有点很夸张",
   "music": 0
  },
  {
   "from": 10.67,
   "to": 11.87,
   "sid": 5,
   "location": 2,
   "content": "很夸张很夸张",
   "music": 0
  },
  {
   "from": 11.87,
   "to": 14.33,
   "sid": 6,
   "location": 2,
   "content": "他的主要需求是解决投篮发力卡顿",
   "music": 0
  },
  {
   "from": 14.33,
   "to": 16.18,
   "sid": 7,
   "location": 2,
   "content": "加快整体的出手速度",
   "music": 0
  },
  {
   "from": 16.18,
   "to": 17.56,
   "sid": 8,
   "location": 2,
   "content": "这是他之前的投篮",
   "music": 0
  },
  {
   "from": 17.56,
   "to": 19.45,
   "sid": 9,
   "location": 2,
   "content": "缺乏远距离的投篮的能力",
   "music": 0
  },
  {
   "from": 19.45,
   "to": 21.08,
   "sid": 10,
   "location": 2,
   "content": "这是调整后的投篮",
   "music": 0
  },
  {
   "from": 21.08,
   "to": 21.68,
   "sid": 11,
   "location": 2,
   "content": "调整后",
   "music": 0
  },
  {
   "from": 21.68,
   "to": 23.48,
   "sid": 12,
   "location": 2,
   "content": "他与克莱汤普森的发力模式",
   "music": 0
  },
  {
   "from": 23.48,
   "to": 25.22,
   "sid": 13,
   "location": 2,
   "content": "与技术动作都比较接近了",
   "music": 0
  },
  {
   "from": 25.22,
   "to": 27.61,
   "sid": 14,
   "location": 2,
   "content": "在三分距离的投篮也变得游刃有余",
   "music": 0
  },
  {
   "from": 27.61,
   "to": 30.43,
   "sid": 15,
   "location": 2,
   "content": "他之前的投篮也是以膝关节主导的",
   "music": 0
  },
  {
   "from": 30.43,
   "to": 31.18,
   "sid": 16,
   "location": 2,
   "content": "下肢蓄力",
   "music": 0
  },
  {
   "from": 31.18,
   "to": 32.89,
   "sid": 17,
   "location": 2,
   "content": "重心会有前冲的习惯",
   "music": 0
  },
  {
   "from": 32.89,
   "to": 34.57,
   "sid": 18,
   "location": 2,
   "content": "而他的关节刚性偏弱",
   "music": 0
  },
  {
   "from": 34.57,
   "to": 36.01,
   "sid": 19,
   "location": 2,
   "content": "以及立线不够正直",
   "music": 0
  },
  {
   "from": 36.01,
   "to": 39.2,
   "sid": 20,
   "location": 2,
   "content": "力量的传导与稳定性有较大的提升空间",
   "music": 0
  },
  {
   "from": 39.2,
   "to": 40.19,
   "sid": 21,
   "location": 2,
   "content": "灯升缓慢",
   "music": 0
  },
  {
   "from": 40.19,
   "to": 41.45,
   "sid": 22,
   "location": 2,
   "content": "上肢发力点较低",
   "music": 0
  },
  {
   "from": 41.45,
   "to": 44.74,
   "sid": 23,
   "location": 2,
   "content": "重心前冲投篮抗防守的干扰的能力偏弱",
   "music": 0
  },
  {
   "from": 44.74,
   "to": 46.96,
   "sid": 24,
   "location": 2,
   "content": "这也是大多数球友的通病",
   "music": 0
  },
  {
   "from": 46.96,
   "to": 49.69,
   "sid": 25,
   "location": 2,
   "content": "本期视频是对他投篮调整的简要总结",
   "music": 0
  },
  {
   "from": 49.69,
   "to": 52.84,
   "sid": 26,
   "location": 2,
   "content": "梳理出了四个重点方面供大家参考借鉴",
   "music": 0
  },
  {
   "from": 52.84,
   "to": 55.39,
   "sid": 27,
   "location": 2,
   "content": "第一方面是关于手型及立线的调整",
   "music": 0
  },
  {
   "from": 55.39,
   "to": 58.3,
   "sid": 28,
   "location": 2,
   "content": "之前他的出手由于躯干朝向与脚下站位不同",
   "music": 0
  },
  {
   "from": 58.3,
   "to": 59.36,
   "sid": 29,
   "location": 2,
   "content": "像出手时",
   "music": 0
  },
  {
   "from": 59.36,
   "to": 62.36,
   "sid": 30,
   "location": 2,
   "content": "他的投篮手会在水平面大幅度的向外扭转",
   "music": 0
  },
  {
   "from": 62.36,
   "to": 63.62,
   "sid": 31,
   "location": 2,
   "content": "造成过度的旋转",
   "music": 0
  },
  {
   "from": 63.62,
   "to": 67.15,
   "sid": 32,
   "location": 2,
   "content": "发力出手后手腕手指会形成大幅度的摆动",
   "music": 0
  },
  {
   "from": 67.15,
   "to": 69.82,
   "sid": 33,
   "location": 2,
   "content": "这里要求他的躯干与脚下站位同向",
   "music": 0
  },
  {
   "from": 69.82,
   "to": 71.2,
   "sid": 34,
   "location": 2,
   "content": "蹬地与乞求同向",
   "music": 0
  },
  {
   "from": 71.2,
   "to": 75.02,
   "sid": 35,
   "location": 2,
   "content": "也就是从脚下到髋部到躯干的整体向左蓄力",
   "music": 0
  },
  {
   "from": 75.02,
   "to": 76.7,
   "sid": 36,
   "location": 2,
   "content": "与瞄准肩背稳定下",
   "music": 0
  },
  {
   "from": 76.7,
   "to": 78.11,
   "sid": 37,
   "location": 2,
   "content": "积极的向上耸右肩",
   "music": 0
  },
  {
   "from": 78.11,
   "to": 78.74,
   "sid": 38,
   "location": 2,
   "content": "调整后",
   "music": 0
  },
  {
   "from": 78.74,
   "to": 79.97,
   "sid": 39,
   "location": 2,
   "content": "他的力线变得正直",
   "music": 0
  },
  {
   "from": 79.97,
   "to": 80.78,
   "sid": 40,
   "location": 2,
   "content": "手型稳定",
   "music": 0
  },
  {
   "from": 80.78,
   "to": 82.64,
   "sid": 41,
   "location": 2,
   "content": "不再摇摆",
   "music": 0
  },
  {
   "from": 86.3,
   "to": 88.93,
   "sid": 42,
   "location": 2,
   "content": "侧一点对对",
   "music": 0
  },
  {
   "from": 88.93,
   "to": 89.89,
   "sid": 43,
   "location": 2,
   "content": "这就顺畅了",
   "music": 0
  },
  {
   "from": 89.89,
   "to": 92.41,
   "sid": 44,
   "location": 2,
   "content": "第二方面是矫正他下肢的蓄力模式",
   "music": 0
  },
  {
   "from": 92.41,
   "to": 94.63,
   "sid": 45,
   "location": 2,
   "content": "他的投篮发力存在手快脚慢",
   "music": 0
  },
  {
   "from": 94.63,
   "to": 95.77,
   "sid": 46,
   "location": 2,
   "content": "发力脱节的问题",
   "music": 0
  },
  {
   "from": 95.77,
   "to": 97.84,
   "sid": 47,
   "location": 2,
   "content": "尤其远距离暴露的较为明显",
   "music": 0
  },
  {
   "from": 97.84,
   "to": 100.24,
   "sid": 48,
   "location": 2,
   "content": "下肢核心力量难以转化到篮球上",
   "music": 0
  },
  {
   "from": 100.24,
   "to": 102.28,
   "sid": 49,
   "location": 2,
   "content": "这里把他的发力由膝关节主导",
   "music": 0
  },
  {
   "from": 102.28,
   "to": 103.72,
   "sid": 50,
   "location": 2,
   "content": "调整到髋关节主导",
   "music": 0
  },
  {
   "from": 103.72,
   "to": 105.46,
   "sid": 51,
   "location": 2,
   "content": "用更少的蓄力幅度和时间",
   "music": 0
  },
  {
   "from": 105.46,
   "to": 107.31,
   "sid": 52,
   "location": 2,
   "content": "获得更高效的力量转化",
   "music": 0
  },
  {
   "from": 107.31,
   "to": 109.8,
   "sid": 53,
   "location": 2,
   "content": "之前他的踝膝髋关节的刚性偏弱",
   "music": 0
  },
  {
   "from": 109.8,
   "to": 111.36,
   "sid": 54,
   "location": 2,
   "content": "我们先从脚步上优化",
   "music": 0
  },
  {
   "from": 111.36,
   "to": 114.24,
   "sid": 55,
   "location": 2,
   "content": "在一二部中强调左脚偏重心稳定",
   "music": 0
  },
  {
   "from": 114.24,
   "to": 115.71,
   "sid": 56,
   "location": 2,
   "content": "右脚更多的轻弹",
   "music": 0
  },
  {
   "from": 115.71,
   "to": 117.54,
   "sid": 57,
   "location": 2,
   "content": "在店铺中使用双脚前置",
   "music": 0
  },
  {
   "from": 117.54,
   "to": 119.58,
   "sid": 58,
   "location": 2,
   "content": "双脚的前脚掌支撑与蹬地",
   "music": 0
  },
  {
   "from": 119.58,
   "to": 121.74,
   "sid": 59,
   "location": 2,
   "content": "再从意识上强化关节刚性",
   "music": 0
  },
  {
   "from": 121.74,
   "to": 123.52,
   "sid": 60,
   "location": 2,
   "content": "提高踝膝髋的整体链接",
   "music": 0
  },
  {
   "from": 123.52,
   "to": 124.93,
   "sid": 61,
   "location": 2,
   "content": "更多的利用了弹性",
   "music": 0
  },
  {
   "from": 124.93,
   "to": 126.55,
   "sid": 62,
   "location": 2,
   "content": "从而解决了脚慢的问题",
   "music": 0
  },
  {
   "from": 126.55,
   "to": 128.86,
   "sid": 63,
   "location": 2,
   "content": "整体发力随之变得快速流畅",
   "music": 0
  },
  {
   "from": 128.86,
   "to": 131.37,
   "sid": 64,
   "location": 2,
   "content": "第三方面是调整身体的重心",
   "music": 0
  },
  {
   "from": 131.37,
   "to": 133.56,
   "sid": 65,
   "location": 2,
   "content": "之前他膝关节主导发力的习惯",
   "music": 0
  },
  {
   "from": 133.56,
   "to": 135.18,
   "sid": 66,
   "location": 2,
   "content": "屈膝伸膝都是向前的",
   "music": 0
  },
  {
   "from": 135.18,
   "to": 136.769,
   "sid": 67,
   "location": 2,
   "content": "重心也跟随向前",
   "music": 0
  },
  {
   "from": 136.769,
   "to": 139.259,
   "sid": 68,
   "location": 2,
   "content": "从下肢到上肢都难以充分伸展",
   "music": 0
  },
  {
   "from": 139.259,
   "to": 140.339,
   "sid": 69,
   "location": 2,
   "content": "出手角度较低",
   "music": 0
  },
  {
   "from": 140.339,
   "to": 141.93,
   "sid": 70,
   "location": 2,
   "content": "篮球的弧度也偏低",
   "music": 0
  },
  {
   "from": 141.93,
   "to": 143.46,
   "sid": 71,
   "location": 2,
   "content": "要求他脚部前置",
   "music": 0
  },
  {
   "from": 143.46,
   "to": 144.96,
   "sid": 72,
   "location": 2,
   "content": "躯干保持相对直立",
   "music": 0
  },
  {
   "from": 144.96,
   "to": 145.95,
   "sid": 73,
   "location": 2,
   "content": "躯干在腿部之后",
   "music": 0
  },
  {
   "from": 145.95,
   "to": 147.3,
   "sid": 74,
   "location": 2,
   "content": "保证他向上发力",
   "music": 0
  },
  {
   "from": 147.3,
   "to": 149.31,
   "sid": 75,
   "location": 2,
   "content": "向上起跳",
   "music": 0
  },
  {
   "from": 150.21,
   "to": 151.43,
   "sid": 76,
   "location": 2,
   "content": "要不然就脱手了",
   "music": 0
  },
  {
   "from": 151.43,
   "to": 152.21,
   "sid": 77,
   "location": 2,
   "content": "往前走了",
   "music": 0
  },
  {
   "from": 152.21,
   "to": 155.12,
   "sid": 78,
   "location": 2,
   "content": "从脚下到躯干到上肢都能完整的伸展",
   "music": 0
  },
  {
   "from": 155.12,
   "to": 157.899,
   "sid": 79,
   "location": 2,
   "content": "触手角度与投篮弧度自然得到了提高",
   "music": 0
  },
  {
   "from": 157.899,
   "to": 160.929,
   "sid": 80,
   "location": 2,
   "content": "第四方面是同步他上下肢发力的节奏",
   "music": 0
  },
  {
   "from": 160.929,
   "to": 163.06,
   "sid": 81,
   "location": 2,
   "content": "消除他之后大幅降重心的习惯",
   "music": 0
  },
  {
   "from": 163.06,
   "to": 164.74,
   "sid": 82,
   "location": 2,
   "content": "养成提前降重型的习惯",
   "music": 0
  },
  {
   "from": 164.74,
   "to": 166.46,
   "sid": 83,
   "location": 2,
   "content": "面对来球更多的做输球",
   "music": 0
  },
  {
   "from": 166.46,
   "to": 167.63,
   "sid": 84,
   "location": 2,
   "content": "减少成球",
   "music": 0
  },
  {
   "from": 167.63,
   "to": 171.56,
   "sid": 85,
   "location": 2,
   "content": "明确降重心的同时是上下肢同时收紧的状态",
   "music": 0
  },
  {
   "from": 171.56,
   "to": 173.649,
   "sid": 86,
   "location": 2,
   "content": "蹬地的同时开始起球",
   "music": 0
  },
  {
   "from": 173.649,
   "to": 176.079,
   "sid": 87,
   "location": 2,
   "content": "上下肢蓄力发力的行程更加匹配",
   "music": 0
  },
  {
   "from": 176.079,
   "to": 177.849,
   "sid": 88,
   "location": 2,
   "content": "这能使上下肢协同发力",
   "music": 0
  },
  {
   "from": 177.849,
   "to": 179.83,
   "sid": 89,
   "location": 2,
   "content": "力量的传导更加高效",
   "music": 0
  },
  {
   "from": 179.83,
   "to": 182.5,
   "sid": 90,
   "location": 2,
   "content": "调整后他投篮的整体发力轻松快速",
   "music": 0
  },
  {
   "from": 182.5,
   "to": 184.14,
   "sid": 91,
   "location": 2,
   "content": "动作更加舒展美观",
   "music": 0
  },
  {
   "from": 184.14,
   "to": 185.4,
   "sid": 92,
   "location": 2,
   "content": "而且更具经济性",
   "music": 0
  },
  {
   "from": 185.4,
   "to": 186.57,
   "sid": 93,
   "location": 2,
   "content": "但长期来看",
   "music": 0
  },
  {
   "from": 186.57,
   "to": 188.13,
   "sid": 94,
   "location": 2,
   "content": "他还需通过专项训练",
   "music": 0
  },
  {
   "from": 188.13,
   "to": 191.8,
   "sid": 95,
   "location": 2,
   "content": "重点提高下肢整体的刚性与弹性",
   "music": 0
  },
  {
   "from": 193.86,
   "to": 195.16,
   "sid": 96,
   "location": 2,
   "content": "游戏的",
   "music": 0.9999991666673611
  }
 ]
}