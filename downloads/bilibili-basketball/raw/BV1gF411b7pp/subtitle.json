 "body": [
  {
   "from": 5.1,
   "to": 6.819,
   "sid": 1,
   "location": 2,
   "content": "怕输的不停"
  },
  {
   "from": 7.62,
   "to": 8.84,
   "sid": 2,
   "location": 2,
   "content": "i'll be with you"
  },
  {
   "from": 8.84,
   "to": 9.71,
   "sid": 3,
   "location": 2,
   "content": "i don't do"
  },
  {
   "from": 9.71,
   "to": 12.89,
   "sid": 4,
   "location": 2,
   "content": "今天给兄弟们安排一个非常简单实用的误导工人"
  },
  {
   "from": 12.89,
   "to": 14.47,
   "sid": 5,
   "location": 2,
   "content": "叫做横移误导过人"
  },
  {
   "from": 14.47,
   "to": 17.59,
   "sid": 6,
   "location": 2,
   "content": "首先我们在面对防守时进行一次画像"
  },
  {
   "from": 17.59,
   "to": 18.25,
   "sid": 7,
   "location": 2,
   "content": "画像后"
  },
  {
   "from": 18.25,
   "to": 19.75,
   "sid": 8,
   "location": 2,
   "content": "我们进行一个横移"
  },
  {
   "from": 19.75,
   "to": 20.47,
   "sid": 9,
   "location": 2,
   "content": "防疫过程中"
  },
  {
   "from": 20.47,
   "to": 23.719,
   "sid": 10,
   "location": 2,
   "content": "我们外侧脚抬起点地落球"
  },
  {
   "from": 23.719,
   "to": 25.339,
   "sid": 11,
   "location": 2,
   "content": "瞬间上步"
  },
  {
   "from": 25.339,
   "to": 26.899,
   "sid": 12,
   "location": 2,
   "content": "注意这时候是关键啊"
  },
  {
   "from": 26.899,
   "to": 29.509,
   "sid": 13,
   "location": 2,
   "content": "这时候我们进行一个向外的一个姿态"
  },
  {
   "from": 29.509,
   "to": 34.4,
   "sid": 14,
   "location": 2,
   "content": "在我们左脚落地瞬间抬起右脚向外进行了一次不倒的试探"
  },
  {
   "from": 34.4,
   "to": 35.87,
   "sid": 15,
   "location": 2,
   "content": "可以带动我们的身体"
  },
  {
   "from": 35.87,
   "to": 37.309,
   "sid": 16,
   "location": 2,
   "content": "眼睛不档"
  },
  {
   "from": 37.309,
   "to": 41.05,
   "sid": 17,
   "location": 2,
   "content": "让我们顺势将重心拉回向前进行动作"
  },
  {
   "from": 41.05,
   "to": 43.21,
   "sid": 18,
   "location": 2,
   "content": "我们慢点来做这个动作属性"
  },
  {
   "from": 52.54,
   "to": 53.9,
   "sid": 19,
   "location": 2,
   "content": "and hold me"
  },
  {
   "from": 54.2,
   "to": 55.94,
   "sid": 20,
   "location": 2,
   "content": "当我们同一个动作用多了"
  },
  {
   "from": 55.94,
   "to": 57.11,
   "sid": 21,
   "location": 2,
   "content": "对手也会提前预感"
  },
  {
   "from": 57.11,
   "to": 59.3,
   "sid": 22,
   "location": 2,
   "content": "所以我们在这个过程中加入我们小麦孔"
  },
  {
   "from": 59.3,
   "to": 60.58,
   "sid": 23,
   "location": 2,
   "content": "会影响不断的效果"
  },
  {
   "from": 60.58,
   "to": 62.39,
   "sid": 24,
   "location": 2,
   "content": "前面动作一下进步"
  },
  {
   "from": 65.15,
   "to": 66.95,
   "sid": 25,
   "location": 2,
   "content": "是让我们交叉一二"
  },
  {
   "from": 66.95,
   "to": 70.42,
   "sid": 26,
   "location": 2,
   "content": "至少一二双脚进行一个一二的落魄"
  },
  {
   "from": 70.58,
   "to": 72.74,
   "sid": 27,
   "location": 2,
   "content": "在我们形成投篮脚落的同时"
  },
  {
   "from": 76.58,
   "to": 77.99,
   "sid": 28,
   "location": 2,
   "content": "我们进行一个圈运营"
  },
  {
   "from": 77.99,
   "to": 79.7,
   "sid": 29,
   "location": 2,
   "content": "双手快要碰到球的时候"
  },
  {
   "from": 79.7,
   "to": 81.05,
   "sid": 30,
   "location": 2,
   "content": "就能进圈运球"
  }
 ]
}