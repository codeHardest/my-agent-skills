  {
   "from": 8.839,
   "to": 9.879,
   "sid": 3,
   "location": 2,
   "content": "2015年"
  },
  {
   "from": 9.879,
   "to": 13.209,
   "sid": 4,
   "location": 2,
   "content": "史蒂夫纳什成为了勇士队的球员发展顾问后"
  },
  {
   "from": 13.209,
   "to": 17.05,
   "sid": 5,
   "location": 2,
   "content": "他把身巨宽单脚投篮训练教授给了库里与杜兰特"
  },
  {
   "from": 17.05,
   "to": 18.43,
   "sid": 6,
   "location": 2,
   "content": "在上期的视频中"
  },
  {
   "from": 18.43,
   "to": 21.439,
   "sid": 7,
   "location": 2,
   "content": "很多球友反馈找不到投篮屈髋的发力感"
