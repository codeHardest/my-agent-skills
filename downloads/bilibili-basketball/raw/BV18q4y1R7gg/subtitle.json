{
 "font_size": 0.4,
 "font_color": "#FFFFFF",
 "background_alpha": 0.5,
 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "en-v1.2.0.4-t0.3.c",
 "body": [
  {
   "from": 0.14,
   "to": 1.26,
   "sid": 1,
   "location": 2,
   "content": "谈论逐渐消失"
  },
  {
   "from": 1.26,
   "to": 2.76,
   "sid": 2,
   "location": 2,
   "content": "让我们来谈谈基线逐渐消失"
  },
  {
   "from": 2.76,
   "to": 3.4,
   "sid": 3,
   "location": 2,
   "content": "好的"
  },
  {
   "from": 3.4,
   "to": 5.8,
   "sid": 4,
   "location": 2,
   "content": "所以我们唯一要做基线淡出的时候是"
  },
  {
   "from": 5.8,
   "to": 6.82,
   "sid": 5,
   "location": 2,
   "content": "如果你把墙围起来"
  },
  {
   "from": 6.82,
   "to": 7.12,
   "sid": 6,
   "location": 2,
   "content": "好的"
  },
  {
   "from": 7.12,
   "to": 7.96,
   "sid": 7,
   "location": 2,
   "content": "所以他把墙挡住了"
  },
  {
   "from": 9.63,
   "to": 11.97,
   "sid": 8,
   "location": 2,
   "content": "如果我们在这里的位置"
  },
  {
   "from": 11.97,
   "to": 15.15,
   "sid": 9,
   "location": 2,
   "content": "我们注意到他的肩膀拿走了我们的中间驱动器"
  },
  {
   "from": 15.15,
   "to": 17.05,
   "sid": 10,
   "location": 2,
   "content": "现在我们知道我们要去基线"
  },
  {
   "from": 17.05,
   "to": 17.39,
   "sid": 11,
   "location": 2,
   "content": "好的"
  },
  {
   "from": 17.39,
   "to": 19.41,
   "sid": 12,
   "location": 2,
   "content": "这意味着我们也许可以从它们中分离出来"
  },
  {
   "from": 19.41,
   "to": 21.51,
   "sid": 13,
   "location": 2,
   "content": "这意味着我们做一个基线淡出"
  },
  {
   "from": 21.51,
   "to": 23.89,
   "sid": 14,
   "location": 2,
   "content": "但我们知道我们不能真正攻击中间"
  },
  {
   "from": 25.75,
   "to": 26.94,
   "sid": 15,
   "location": 2,
   "content": "类似的东西"
  },
  {
   "from": 26.94,
   "to": 28.28,
   "sid": 16,
   "location": 2,
   "content": "所以帖子消失了"
  },
  {
   "from": 28.28,
   "to": 30.2,
   "sid": 17,
   "location": 2,
   "content": "我们首先需要的是一个很好的撞击"
  },
  {
   "from": 30.2,
   "to": 32.74,
   "sid": 18,
   "location": 2,
   "content": "我们想让他的势头倒退"
  },
  {
   "from": 32.74,
   "to": 33.48,
   "sid": 19,
   "location": 2,
   "content": "好的"
  },
  {
   "from": 33.48,
   "to": 35.64,
   "sid": 20,
   "location": 2,
   "content": "一个好的撞击始于一个好的运球"
  },
  {
   "from": 35.64,
   "to": 36.58,
   "sid": 21,
   "location": 2,
   "content": "所以是运球"
  },
  {
   "from": 36.58,
   "to": 39.08,
   "sid": 22,
   "location": 2,
   "content": "第一步把脚伸进去"
  },
  {
   "from": 39.08,
   "to": 41.38,
   "sid": 23,
   "location": 2,
   "content": "第二步，这样我们就可以在他下面"
  },
  {
   "from": 46.28,
   "to": 48.16,
   "sid": 24,
   "location": 2,
   "content": "我现在没有扔胳膊什么的"
  },
  {
   "from": 48.16,
   "to": 50.23,
   "sid": 25,
   "location": 2,
   "content": "一旦我现在创造了分离"
  },
  {
   "from": 50.23,
   "to": 53.09,
   "sid": 26,
   "location": 2,
   "content": "我有几个不同的步法选择，我可以使用"
  },
  {
   "from": 53.09,
   "to": 53.75,
   "sid": 27,
   "location": 2,
   "content": "好的"
  },
  {
   "from": 53.75,
   "to": 57.22,
   "sid": 28,
   "location": 2,
   "content": "所以现在记住运球台阶碰撞"
  },
  {
   "from": 57.22,
   "to": 60.24,
   "sid": 29,
   "location": 2,
   "content": "第一个选择是弹出你的脚"
  },
  {
   "from": 60.24,
   "to": 61.36,
   "sid": 30,
   "location": 2,
   "content": "把脚弹出来"
  },
  {
   "from": 61.36,
   "to": 62.56,
   "sid": 31,
   "location": 2,
   "content": "然后我要做的是"
  },
  {
   "from": 62.56,
   "to": 65.03,
   "sid": 32,
   "location": 2,
   "content": "我要扭断脚趾头或脚后跟"
  },
  {
   "from": 65.03,
   "to": 66.21,
   "sid": 33,
   "location": 2,
   "content": "如果我这样走"
  },
  {
   "from": 66.21,
   "to": 68.07,
   "sid": 34,
   "location": 2,
   "content": "我喜欢从脚后跟旋转"
  },
  {
   "from": 71.21,
   "to": 72.45,
   "sid": 35,
   "location": 2,
   "content": "如果你旋转你的脚趾"
  },
  {
   "from": 72.45,
   "to": 73.39,
   "sid": 36,
   "location": 2,
   "content": "完全一样的话"
  },
  {
   "from": 73.39,
   "to": 75.11,
   "sid": 37,
   "location": 2,
   "content": "我拿着这个运球砰的一声，砰的一声"
  },
  {
   "from": 75.11,
   "to": 77.6,
   "sid": 38,
   "location": 2,
   "content": "我也可以离开脚趾，在那里旋转"
  },
  {
   "from": 77.6,
   "to": 79.46,
   "sid": 39,
   "location": 2,
   "content": "你永远不会用脚旋转"
  },
  {
   "from": 79.46,
   "to": 81.74,
   "sid": 40,
   "location": 2,
   "content": "不是脚跟就是脚趾"
  },
  {
   "from": 82,
   "to": 84.8,
   "sid": 41,
   "location": 2,
   "content": "所以基本上如果你进入淡入淡出"
  },
  {
   "from": 84.8,
   "to": 88.1,
   "sid": 42,
   "location": 2,
   "content": "旋转上的大教学点曾经是"
  },
  {
   "from": 88.1,
   "to": 89.26,
   "sid": 43,
   "location": 2,
   "content": "我拿着这个运球"
  },
  {
   "from": 89.26,
   "to": 90.98,
   "sid": 44,
   "location": 2,
   "content": "我迈出这一步，我撞了一下"
  },
  {
   "from": 90.98,
   "to": 92.22,
   "sid": 45,
   "location": 2,
   "content": "我跳起我的脚"
  },
  {
   "from": 92.22,
   "to": 95.2,
   "sid": 46,
   "location": 2,
   "content": "所以第一件事是脚趾或脚后跟"
  },
  {
   "from": 95.4,
   "to": 98.58,
   "sid": 47,
   "location": 2,
   "content": "第二件事是我想把这只脚弄到四五"
  },
  {
   "from": 98.66,
   "to": 99.94,
   "sid": 48,
   "location": 2,
   "content": "如果我不这么说"
  },
  {
   "from": 99.94,
   "to": 101.54,
   "sid": 49,
   "location": 2,
   "content": "我现在把它放在那里了"
  },
  {
   "from": 101.54,
   "to": 103.26,
   "sid": 50,
   "location": 2,
   "content": "我不能让我的臀部打开"
  },
  {
   "from": 103.26,
   "to": 105.94,
   "sid": 51,
   "location": 2,
   "content": "所以如果你把这个鞋跟放在这里"
  },
  {
   "from": 105.94,
   "to": 107.1,
   "sid": 52,
   "location": 2,
   "content": "四点五过去"
  },
  {
   "from": 107.1,
   "to": 109.15,
   "sid": 53,
   "location": 2,
   "content": "我的整个身体都可以旋转"
  },
  {
   "from": 109.15,
   "to": 109.91,
   "sid": 54,
   "location": 2,
   "content": "好的"
  },
  {
   "from": 109.91,
   "to": 113.759,
   "sid": 55,
   "location": 2,
   "content": "最后一件事是在保持平衡的同时保护好球"
  },
  {
   "from": 113.84,
   "to": 114.32,
   "sid": 56,
   "location": 2,
   "content": "好的"
  },
  {
   "from": 114.32,
   "to": 115.44,
   "sid": 57,
   "location": 2,
   "content": "所以颠簸上的三件事"
  },
  {
   "from": 115.44,
   "to": 116.42,
   "sid": 58,
   "location": 2,
   "content": "你把墙挡住了"
  },
  {
   "from": 116.42,
   "to": 118.32,
   "sid": 59,
   "location": 2,
   "content": "运球台阶碰撞"
  },
  {
   "from": 118.38,
   "to": 120.9,
   "sid": 60,
   "location": 2,
   "content": "这三件事基本上是旋转的"
  },
  {
   "from": 120.9,
   "to": 122.4,
   "sid": 61,
   "location": 2,
   "content": "会是脚后跟还是脚趾"
  },
  {
   "from": 122.4,
   "to": 125.52,
   "sid": 62,
   "location": 2,
   "content": "四五和护球器保持平衡"
  },
  {
   "from": 125.52,
   "to": 126.8,
   "sid": 63,
   "location": 2,
   "content": "然后在镜头上"
  },
  {
   "from": 130.079,
   "to": 132.019,
   "sid": 64,
   "location": 2,
   "content": "把球送到我们的口袋里"
  },
  {
   "from": 132.019,
   "to": 134.259,
   "sid": 65,
   "location": 2,
   "content": "双腿完全伸展"
  },
  {
   "from": 134.259,
   "to": 136.24,
   "sid": 66,
   "location": 2,
   "content": "然后用高弧线射击"
  },
  {
   "from": 136.339,
   "to": 138.599,
   "sid": 67,
   "location": 2,
   "content": "你们一定要记住当你们拍摄淡出"
  },
  {
   "from": 138.599,
   "to": 139.779,
   "sid": 68,
   "location": 2,
   "content": "所以如果你拍一个正常的跳跃"
  },
  {
   "from": 139.779,
   "to": 141.179,
   "sid": 69,
   "location": 2,
   "content": "拍我的口袋是"
  },
  {
   "from": 141.179,
   "to": 142.92,
   "sid": 70,
   "location": 2,
   "content": "你知道90到95"
  },
  {
   "from": 142.92,
   "to": 144.34,
   "sid": 71,
   "location": 2,
   "content": "如果我向后倾斜"
  },
  {
   "from": 144.34,
   "to": 147.339,
   "sid": 72,
   "location": 2,
   "content": "我现在应该还有九十五到九十五"
  },
  {
   "from": 147.339,
   "to": 149.539,
   "sid": 73,
   "location": 2,
   "content": "如果我们想完成我们的拍摄"
  },
  {
   "from": 149.539,
   "to": 151.299,
   "sid": 74,
   "location": 2,
   "content": "我们常说肘眉"
  },
  {
   "from": 151.299,
   "to": 153.139,
   "sid": 75,
   "location": 2,
   "content": "我们的后续行动会发生什么"
  },
  {
   "from": 153.139,
   "to": 154.63,
   "sid": 76,
   "location": 2,
   "content": "如果我们向后倾斜"
  },
  {
   "from": 154.63,
   "to": 155.99,
   "sid": 77,
   "location": 2,
   "content": "看看它有多高"
  },
  {
   "from": 155.99,
   "to": 158.71,
   "sid": 78,
   "location": 2,
   "content": "所以我们仍然需要同样精确的弧角"
  },
  {
   "from": 158.71,
   "to": 160.25,
   "sid": 79,
   "location": 2,
   "content": "所以当我们拍摄淡入淡出的方式"
  },
  {
   "from": 160.25,
   "to": 162.23,
   "sid": 80,
   "location": 2,
   "content": "我们需要确保嘣"
  },
  {
   "from": 162.23,
   "to": 162.8,
   "sid": 81,
   "location": 2,
   "content": "我们弹出"
  },
  {
   "from": 162.8,
   "to": 163.4,
   "sid": 82,
   "location": 2,
   "content": "我们翻滚"
  },
  {
   "from": 163.4,
   "to": 165.08,
   "sid": 83,
   "location": 2,
   "content": "我们上去的时候把球保护好"
  },
  {
   "from": 165.08,
   "to": 166.62,
   "sid": 84,
   "location": 2,
   "content": "我们会自然地把球射得更高"
  },
  {
   "from": 166.62,
   "to": 168.9,
   "sid": 85,
   "location": 2,
   "content": "因为我们保持了相同的弧角"
  },
  {
   "from": 168.9,
   "to": 170.94,
   "sid": 86,
   "location": 2,
   "content": "这应该是九十五到九十五"
  },
  {
   "from": 170.98,
   "to": 173.78,
   "sid": 87,
   "location": 2,
   "content": "这里又是一模一样的东西"
  },
  {
   "from": 173.78,
   "to": 176.62,
   "sid": 88,
   "location": 2,
   "content": "所以我们和身体保持着同样的关系"
  },
  {
   "from": 176.62,
   "to": 179.79,
   "sid": 89,
   "location": 2,
   "content": "另一个你可以做完全相同的颠簸"
  },
  {
   "from": 179.79,
   "to": 182.37,
   "sid": 90,
   "location": 2,
   "content": "所以运球台阶碰撞"
  },
  {
   "from": 182.37,
   "to": 184.57,
   "sid": 91,
   "location": 2,
   "content": "现在我们在这里保持体重"
  },
  {
   "from": 184.57,
   "to": 185.83,
   "sid": 92,
   "location": 2,
   "content": "我们把这只脚推开"
  },
  {
   "from": 185.83,
   "to": 187.29,
   "sid": 93,
   "location": 2,
   "content": "又在这里"
  },
  {
   "from": 187.29,
   "to": 188.17,
   "sid": 94,
   "location": 2,
   "content": "我要把这个拿出来"
  },
  {
   "from": 188.17,
   "to": 190.01,
   "sid": 95,
   "location": 2,
   "content": "所以基本上一旦我撞到这里"
  },
  {
   "from": 190.01,
   "to": 192.07,
   "sid": 96,
   "location": 2,
   "content": "我撞了一下，带着这个走了出来"
  },
  {
   "from": 192.07,
   "to": 194.45,
   "sid": 97,
   "location": 2,
   "content": "所以我把我的内侧脚推到外侧脚"
  },
  {
   "from": 194.45,
   "to": 195.77,
   "sid": 98,
   "location": 2,
   "content": "我又翻滚了"
  },
  {
   "from": 195.77,
   "to": 197.6,
   "sid": 99,
   "location": 2,
   "content": "四五保持平衡"
  },
  {
   "from": 197.6,
   "to": 199.22,
   "sid": 100,
   "location": 2,
   "content": "把球保护在我的臀部"
  },
  {
   "from": 199.22,
   "to": 200.36,
   "sid": 101,
   "location": 2,
   "content": "同样的攻击倾斜"
  },
  {
   "from": 200.36,
   "to": 200.8,
   "sid": 102,
   "location": 2,
   "content": "把球捡回来"
  },
  {
   "from": 200.8,
   "to": 202.079,
   "sid": 103,
   "location": 2,
   "content": "口袋把它射高"
  },
  {
   "from": 202.079,
   "to": 203.639,
   "sid": 104,
   "location": 2,
   "content": "所以这是完全一样的事情"
  },
  {
   "from": 203.639,
   "to": 204.679,
   "sid": 105,
   "location": 2,
   "content": "注意我的体重"
  },
  {
   "from": 204.679,
   "to": 207.67,
   "sid": 106,
   "location": 2,
   "content": "我不能在任何岗位上移动"
  },
  {
   "from": 207.67,
   "to": 210.26,
   "sid": 107,
   "location": 2,
   "content": "把我的重量压在我的内侧脚上"
  },
  {
   "from": 210.399,
   "to": 212.479,
   "sid": 108,
   "location": 2,
   "content": "我的体重总是压在我的后脚上"
  },
  {
   "from": 212.479,
   "to": 214.219,
   "sid": 109,
   "location": 2,
   "content": "这样我就可以弹出来了"
  },
  {
   "from": 214.219,
   "to": 215.659,
   "sid": 110,
   "location": 2,
   "content": "你会看到男人这样做"
  },
  {
   "from": 215.659,
   "to": 217.359,
   "sid": 111,
   "location": 2,
   "content": "他们双击这只脚"
  },
  {
   "from": 217.359,
   "to": 220.059,
   "sid": 112,
   "location": 2,
   "content": "所以看着这个推"
  },
  {
   "from": 220.059,
   "to": 223.779,
   "sid": 113,
   "location": 2,
   "content": "你会看到一些家伙像那样旋转"
  },
  {
   "from": 223.779,
   "to": 225.199,
   "sid": 114,
   "location": 2,
   "content": "如果你像那样旋转"
  },
  {
   "from": 225.199,
   "to": 226.64,
   "sid": 115,
   "location": 2,
   "content": "你得把球挡在外面"
  },
  {
   "from": 226.64,
   "to": 228.4,
   "sid": 116,
   "location": 2,
   "content": "所以它必须像口袋运球一样"
  },
  {
   "from": 228.4,
   "to": 229.76,
   "sid": 117,
   "location": 2,
   "content": "因为你要用你的运球"
  },
  {
   "from": 229.76,
   "to": 230.84,
   "sid": 118,
   "location": 2,
   "content": "如果你像那样撞"
  },
  {
   "from": 230.84,
   "to": 231.9,
   "sid": 119,
   "location": 2,
   "content": "如果你弹出来"
  },
  {
   "from": 231.9,
   "to": 233.74,
   "sid": 120,
   "location": 2,
   "content": "你会看到球挂了一点"
  },
  {
   "from": 233.74,
   "to": 236.67,
   "sid": 121,
   "location": 2,
   "content": "然后如果你胡言乱语，跳到那里"
  },
  {
   "from": 236.67,
   "to": 240.38,
   "sid": 122,
   "location": 2,
   "content": "你只需要在捡球前确保你的脚站稳"
  },
  {
   "from": 240.38,
   "to": 241.76,
   "sid": 123,
   "location": 2,
   "content": "你不想运球"
  },
  {
   "from": 241.76,
   "to": 242.52,
   "sid": 124,
   "location": 2,
   "content": "捡起来"
  },
  {
   "from": 242.52,
   "to": 244.32,
   "sid": 125,
   "location": 2,
   "content": "因为这样你就会很自然地向前倾"
  },
  {
   "from": 244.32,
   "to": 245.58,
   "sid": 126,
   "location": 2,
   "content": "你让球挂着"
  },
  {
   "from": 245.58,
