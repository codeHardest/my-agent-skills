  {
   "from": 5.44,
   "to": 6.52,
   "sid": 1,
   "location": 2,
   "content": "最近有兄弟们私信"
  },
  {
   "from": 6.52,
   "to": 8.62,
   "sid": 2,
   "location": 2,
   "content": "我想我出一期关于双后撤的教学"
  },
  {
   "from": 8.62,
   "to": 9.94,
   "sid": 3,
   "location": 2,
   "content": "那今天我就来分享一下"
  },
  {
   "from": 9.94,
   "to": 11.56,
   "sid": 4,
   "location": 2,
   "content": "库里经常用到的一个对抗"
  },
  {
   "from": 11.56,
   "to": 13.059,
   "sid": 5,
   "location": 2,
   "content": "之后的一个双后撤"
  },
  {
   "from": 13.059,
   "to": 14.319,
   "sid": 6,
   "location": 2,
   "content": "那首先说到后撤"
  },
  {
   "from": 14.319,
   "to": 15.519,
   "sid": 7,
   "location": 2,
   "content": "我们就要注意两点问题"
  },
  {
   "from": 15.519,
   "to": 16.91,
   "sid": 8,
   "location": 2,
   "content": "第一点就是合球时机"
  },
  {
   "from": 16.91,
   "to": 20.03,
   "sid": 9,
   "location": 2,
   "content": "第二点就是大部分同学说我后撤完了之后"
  },
  {
   "from": 20.03,
   "to": 20.63,
   "sid": 10,
   "location": 2,
   "content": "投不到"
  },
  {
   "from": 20.63,
   "to": 23.09,
   "sid": 11,
   "location": 2,
   "content": "帮助上帝一个动作连贯的一个问题"
  },
  {
   "from": 23.09,
   "to": 25.07,
   "sid": 12,
   "location": 2,
   "content": "围绕这两点我们进行一个讲解"
  },
  {
   "from": 25.07,
   "to": 27.22,
   "sid": 13,
   "location": 2,
   "content": "那首先护理在面对方小时"
  },
  {
   "from": 27.22,
   "to": 28.93,
   "sid": 14,
   "location": 2,
   "content": "利用外侧脚的一个急停"
  },
  {
   "from": 28.93,
   "to": 30.39,
   "sid": 15,
   "location": 2,
   "content": "制造一个身体对抗"
  },
  {
   "from": 30.39,
   "to": 33.51,
   "sid": 16,
   "location": 2,
   "content": "外侧脚向后进行和单脚的脚步重置"
  },
  {
   "from": 33.51,
   "to": 35.88,
   "sid": 17,
   "location": 2,
   "content": "注意这时候进行一个核球助手"
  },
  {
   "from": 35.88,
   "to": 36.69,
   "sid": 18,
   "location": 2,
   "content": "012"
  },
  {
   "from": 36.69,
   "to": 39.57,
   "sid": 19,
   "location": 2,
   "content": "如果我们在对象时进行了一波球"
  },
  {
   "from": 39.57,
   "to": 40.9,
   "sid": 20,
   "location": 2,
   "content": "这时候我不喝酒"
  },
  {
   "from": 41.64,
   "to": 43.52,
   "sid": 21,
   "location": 2,
   "content": "012我们就不错了"
  },
  {
   "from": 43.52,
   "to": 45.02,
   "sid": 22,
   "location": 2,
   "content": "所以我们第一点要注意"
  },
  {
   "from": 45.02,
   "to": 47.78,
   "sid": 23,
   "location": 2,
   "content": "就是对抗这一下不要不行"
  },
  {
   "from": 47.78,
   "to": 49.919,
   "sid": 24,
   "location": 2,
   "content": "我们在做012的时候过来"
  },
  {
   "from": 50.02,
   "to": 51.01,
   "sid": 25,
   "location": 2,
   "content": "就是那个出手"
  },
  {
   "from": 51.01,
   "to": 53.23,
   "sid": 26,
   "location": 2,
   "content": "那第二点就是我们的动作流畅"
  },
  {
   "from": 53.23,
   "to": 56.08,
   "sid": 27,
   "location": 2,
   "content": "就是为什么你投的那很多同学犯的错误"
  },
  {
   "from": 56.08,
   "to": 59.04,
   "sid": 28,
   "location": 2,
   "content": "在于拜托下去"
  },
  {
   "from": 59.04,
   "to": 61.26,
   "sid": 29,
   "location": 2,
   "content": "再那么正确做"
  },
  {
   "from": 61.26,
   "to": 66.6,
   "sid": 30,
   "location": 2,
   "content": "做法是我们直接张总现在价格中心时"
  },
  {
   "from": 66.6,
   "to": 68.82,
   "sid": 31,
   "location": 2,
   "content": "我们的球一定要回到我们出手点中"
  },
  {
   "from": 68.82,
   "to": 69.84,
   "sid": 32,
   "location": 2,
   "content": "顺势登顶"
  },
  {
   "from": 69.84,
   "to": 70.68,
   "sid": 33,
   "location": 2,
   "content": "直接出手"
  },
  {
   "from": 70.68,
   "to": 74.32,
   "sid": 34,
   "location": 2,
   "content": "而不是我们撤不完过来一套再降一级"
  },
  {
   "from": 74.32,
   "to": 75.64,
   "sid": 35,
   "location": 2,
   "content": "再再等你再这样"
  },
  {
   "from": 75.64,
   "to": 77.2,
   "sid": 36,
   "location": 2,
   "content": "我们的动作还可以脱鞋啊"
  },
  {
   "from": 77.2,
   "to": 78.4,
   "sid": 37,
   "location": 2,
   "content": "所以大部分人读不到"
  },
  {
   "from": 78.4,
