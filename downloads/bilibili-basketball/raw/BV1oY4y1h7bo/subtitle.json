 "body": [
  {
   "from": 0.2,
   "to": 1.46,
   "sid": 1,
   "location": 2,
   "content": "遇到手快的防守人"
  },
  {
   "from": 1.46,
   "to": 2.63,
   "sid": 2,
   "location": 2,
   "content": "你有没有这种烦恼"
  },
  {
   "from": 2.63,
   "to": 3.62,
   "sid": 3,
   "location": 2,
   "content": "不管怎么运"
  },
  {
   "from": 3.62,
   "to": 5.09,
   "sid": 4,
   "location": 2,
   "content": "只要求一暴露就被断"
  },
  {
   "from": 5.09,
   "to": 6.56,
   "sid": 5,
   "location": 2,
   "content": "今天给兄弟们分享一招"
  },
  {
   "from": 6.56,
   "to": 8.039,
   "sid": 6,
   "location": 2,
   "content": "立刻解决此问题"
  },
  {
   "from": 8.039,
   "to": 11.759,
   "sid": 7,
   "location": 2,
   "content": "很多兄弟被掏都是因为在突破时不做压肩"
  },
  {
   "from": 11.759,
   "to": 14.219,
   "sid": 8,
   "location": 2,
   "content": "正直的这样冲过去了"
  },
  {
   "from": 14.219,
   "to": 15.689,
   "sid": 9,
   "location": 2,
   "content": "这样就很容易被掏"
  },
  {
   "from": 15.689,
   "to": 17.14,
   "sid": 10,
   "location": 2,
   "content": "没有肩部的保护"
  },
  {
   "from": 17.3,
   "to": 19.01,
   "sid": 11,
   "location": 2,
   "content": "我们在进行突破时"
  },
  {
   "from": 19.01,
   "to": 20.3,
   "sid": 12,
   "location": 2,
   "content": "为了防止断桥"
  },
  {
   "from": 20.3,
   "to": 22.66,
   "sid": 13,
   "location": 2,
   "content": "我们应该将肩部做一个下压啊"
  },
  {
   "from": 22.86,
   "to": 25.14,
   "sid": 14,
   "location": 2,
   "content": "但作为一个下压进行吐槽"
  },
  {
   "from": 31.299,
   "to": 33.449,
   "sid": 15,
   "location": 2,
   "content": "这样他掏我们就是个犯规"
  },
  {
   "from": 33.449,
   "to": 35.489,
   "sid": 16,
   "location": 2,
   "content": "因为我们有了肩部的保护"
  },
  {
   "from": 35.489,
   "to": 36.719,
   "sid": 17,
   "location": 2,
   "content": "这个时候他在想掏"
  },
  {
   "from": 36.719,
   "to": 38.519,
   "sid": 18,
   "location": 2,
   "content": "我们就会戳到我们身体"
  },
  {
   "from": 38.519,
   "to": 40.239,
   "sid": 19,
   "location": 2,
   "content": "立刻造他一个犯规"
  },
  {
   "from": 40.52,
   "to": 43.8,
   "sid": 20,
   "location": 2,
   "content": "我们可以通过以下方法来找一下压肩的感觉"
  },
  {
   "from": 43.8,
   "to": 45.24,
   "sid": 21,
   "location": 2,
   "content": "身体在做下压时"
  },
  {
   "from": 45.24,
   "to": 46.8,
   "sid": 22,
   "location": 2,
   "content": "脚腕一定要跟随扭动"
  },
  {
   "from": 46.8,
   "to": 48.78,
   "sid": 23,
   "location": 2,
   "content": "以便于我们更好的启动突破"
  },
  {
   "from": 48.78,
   "to": 50.36,
   "sid": 24,
   "location": 2,
   "content": "背后如何防止被掏呢"
  },
  {
   "from": 50.36,
   "to": 51.44,
   "sid": 25,
   "location": 2,
   "content": "这个就比较简单了"
  },
  {
   "from": 51.44,
   "to": 52.7,
   "sid": 26,
   "location": 2,
   "content": "我们过了防守人之后"
  },
  {
   "from": 52.7,
   "to": 54.14,
   "sid": 27,
   "location": 2,
   "content": "一定要把球往前放"
  },
  {
   "from": 54.14,
   "to": 56.54,
   "sid": 28,
   "location": 2,
   "content": "或者直接做变相完成突破上篮"
  }
 ]
}