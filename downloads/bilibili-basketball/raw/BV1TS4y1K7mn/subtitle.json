 "body": [
  {
   "from": 0.38,
   "to": 2.6,
   "sid": 1,
   "location": 2,
   "content": "如果你想把撤步投篮做到无解"
  },
  {
   "from": 2.6,
   "to": 5.6,
   "sid": 2,
   "location": 2,
   "content": "那么哈登后撤步绝对是必备神器"
  },
  {
   "from": 5.6,
   "to": 8.84,
   "sid": 3,
   "location": 2,
   "content": "这男朋友教你四个嘎嘎好用的哈登后撤步"
  },
  {
   "from": 8.84,
   "to": 10.2,
   "sid": 4,
   "location": 2,
   "content": "let's go baby"
  },
  {
   "from": 11.459,
   "to": 13.369,
   "sid": 5,
   "location": 2,
   "content": "一胯下刺探步后撤"
  },
  {
   "from": 13.369,
   "to": 15.079,
   "sid": 6,
   "location": 2,
   "content": "在逼近防守人的过程中"
  },
  {
   "from": 15.079,
   "to": 16.579,
   "sid": 7,
   "location": 2,
   "content": "利用连续胯下的节奏"
  },
  {
   "from": 16.579,
   "to": 18.259,
   "sid": 8,
   "location": 2,
   "content": "再加上突然的胯下姿态"
  },
  {
   "from": 18.259,
   "to": 19.479,
   "sid": 9,
   "location": 2,
   "content": "带动重心向前"
  },
  {
   "from": 19.479,
   "to": 21.249,
   "sid": 10,
   "location": 2,
   "content": "迅速收脚完成投篮"
  },
  {
   "from": 21.249,
   "to": 25.599,
   "sid": 11,
   "location": 2,
   "content": "突然的胯下刺探和脚连点两次地会让防守人迅速后撤"
  },
  {
   "from": 25.599,
   "to": 27.3,
   "sid": 12,
   "location": 2,
   "content": "从而获得出手空间"
  },
  {
   "from": 27.3,
   "to": 28.98,
   "sid": 13,
   "location": 2,
   "content": "出其不意完成投篮"
  },
  {
   "from": 28.98,
   "to": 32.439,
   "sid": 14,
   "location": 2,
   "content": "胯下012后撤与第一种的区别在于"
  },
  {
   "from": 32.439,
   "to": 34.299,
   "sid": 15,
   "location": 2,
   "content": "胯下后无需再做刺探"
  },
  {
   "from": 34.299,
   "to": 37.18,
   "sid": 16,
   "location": 2,
   "content": "而是收前脚的同时直接拉回"
  },
  {
   "from": 37.18,
   "to": 39.31,
   "sid": 17,
   "location": 2,
   "content": "此时防守员会认为你要去投篮"
  },
  {
   "from": 39.31,
   "to": 40.48,
   "sid": 18,
   "location": 2,
   "content": "对你进行封盖"
  },
  {
   "from": 40.48,
   "to": 44.26,
   "sid": 19,
   "location": 2,
   "content": "这时利用收回的前脚蹬地获得更大的出手空间"
  },
  {
   "from": 44.26,
   "to": 45.16,
   "sid": 20,
   "location": 2,
   "content": "完成后撤"
  },
  {
   "from": 45.16,
   "to": 48.58,
   "sid": 21,
   "location": 2,
   "content": "不会做012的小伙伴做这个击打板凳的训练"
  },
  {
   "from": 48.58,
   "to": 52.36,
   "sid": 22,
   "location": 2,
   "content": "胯下交叉步后撤是登哥绝杀凯尔特人的绝活"
  },
  {
   "from": 52.36,
   "to": 54.49,
   "sid": 23,
   "location": 2,
   "content": "利用胯下拖曳步接近对手"
  },
  {
   "from": 54.49,
   "to": 56.14,
   "sid": 24,
   "location": 2,
   "content": "迅速完成胯下突破"
  },
  {
   "from": 56.14,
   "to": 57.7,
   "sid": 25,
   "location": 2,
   "content": "此时会形成交叉步"
  },
  {
   "from": 57.7,
   "to": 59.08,
   "sid": 26,
   "location": 2,
   "content": "同时炸球后撤"
  },
  {
   "from": 59.08,
   "to": 60.55,
   "sid": 27,
   "location": 2,
   "content": "012完成投篮"
  },
  {
   "from": 60.55,
   "to": 63.849,
   "sid": 28,
   "location": 2,
   "content": "背后后撤是哈登最爱用的一种招式"
  },
  {
   "from": 63.849,
   "to": 67.119,
   "sid": 29,
   "location": 2,
   "content": "在连续胯下运球中加入一次背后换手"
  },
  {
   "from": 67.119,
   "to": 69.429,
   "sid": 30,
   "location": 2,
   "content": "随后内侧脚蹬地回收的时候"
  },
  {
   "from": 69.429,
   "to": 71.629,
   "sid": 31,
   "location": 2,
   "content": "合球向侧面横移一大步"
  },
  {
   "from": 71.629,
   "to": 73.4,
   "sid": 32,
   "location": 2,
   "content": "拉开空间进行投篮"
  },
  {
   "from": 73.4,
   "to": 77.18,
   "sid": 33,
   "location": 2,
   "content": "不会背后012的小伙伴做这个背后击打的训练"
  },
  {
   "from": 77.18,
   "to": 78.35,
   "sid": 34,
   "location": 2,
   "content": "还想学什么"
  },
  {
   "from": 78.35,
   "to": 79.94,
   "sid": 35,
   "location": 2,
   "content": "评论区告诉南哥"
  },
  {
   "from": 82.9,
   "to": 84.12,
   "sid": 36,
   "location": 2,
   "content": "嘎嘎好用"
  }
 ]
}