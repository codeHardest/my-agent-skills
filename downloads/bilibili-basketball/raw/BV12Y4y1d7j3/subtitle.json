   "location": 2,
   "content": "学会就简单了",
   "music": 0
  },
  {
   "from": 34.1,
   "to": 35.86,
   "sid": 21,
   "location": 2,
   "content": "接下来我们看一下完整动作",
   "music": 0
  },
  {
   "from": 35.86,
   "to": 37.96,
   "sid": 22,
   "location": 2,
   "content": "首先全球同时主角的力发力",
