  },
  {
   "from": 21.759,
   "to": 23.66,
   "sid": 13,
   "location": 2,
   "content": "左脚快速上步并侧身",
   "music": 0
  },
  {
   "from": 23.66,
   "to": 25.22,
   "sid": 14,
   "location": 2,
   "content": "紧接着第二次运球",
   "music": 0
  },
  {
   "from": 25.22,
   "to": 25.97,
   "sid": 15,
   "location": 2,
   "content": "左脚撤回",
   "music": 0
  },
  {
   "from": 25.97,
   "to": 28.61,
   "sid": 16,
   "location": 2,
   "content": "然后右手全球同时左脚蹬地发力",
   "music": 0
  },
  {
   "from": 28.61,
   "to": 29.72,
   "sid": 17,
   "location": 2,
   "content": "右脚大步迈出",
   "music": 0
  },
  {
   "from": 29.72,
   "to": 31.46,
   "sid": 18,
   "location": 2,
   "content": "形成弓步后炸球急停",
