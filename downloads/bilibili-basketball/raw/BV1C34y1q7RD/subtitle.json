   "content": "我一直在移动卡洛斯"
  },
  {
   "from": 4.44,
   "to": 6.04,
   "sid": 2,
   "location": 2,
   "content": "和我没有麻烦"
  },
  {
   "from": 6.04,
   "to": 7.52,
   "sid": 3,
   "location": 2,
   "content": "试着保持平静"
  },
  {
   "from": 7.52,
