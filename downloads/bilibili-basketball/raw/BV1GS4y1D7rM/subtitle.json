  {
   "from": 20.259,
   "to": 21.069,
   "sid": 10,
   "location": 2,
   "content": "他加盟后"
  },
  {
   "from": 21.069,
   "to": 22.9,
   "sid": 11,
   "location": 2,
   "content": "热火的三分产量连创新高"
  },
  {
   "from": 22.9,
   "to": 23.8,
   "sid": 12,
   "location": 2,
   "content": "斯波教练说"
  },
  {
   "from": 23.8,
   "to": 25.75,
   "sid": 13,
   "location": 2,
   "content": "他是这一行里最好的家伙"
  },
  {
   "from": 25.75,
   "to": 27.49,
   "sid": 14,
   "location": 2,
   "content": "所以看到他出付费课程"
  },
  {
   "from": 27.49,
   "to": 29.53,
   "sid": 15,
   "location": 2,
   "content": "我们就像是喝了烧酒去烤火"
  },
  {
   "from": 29.53,
   "to": 30.52,
   "sid": 16,
   "location": 2,
   "content": "浑身发热"
  },
  {
   "from": 30.52,
   "to": 32.9,
   "sid": 17,
   "location": 2,
   "content": "支付宝到账600"
  },
  {
   "from": 33.92,
   "to": 34.84,
   "sid": 18,
   "location": 2,
   "content": "要不叫投篮"
  },
  {
   "from": 34.84,
   "to": 36.76,
   "sid": 19,
   "location": 2,
   "content": "最大的特点就是喜欢往物理上靠"
  },
  {
   "from": 36.76,
