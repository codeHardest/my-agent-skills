   "sid": 22,
   "location": 2,
   "content": "哈就认为是一个简单的弹球问题"
  },
  {
   "from": 41.53,
   "to": 44.25,
   "sid": 23,
   "location": 2,
   "content": "我们弹球之后如果到了顶点再去播"
  },
  {
   "from": 44.25,
   "to": 45.63,
   "sid": 24,
   "location": 2,
   "content": "就是挺费力的"
  },
  {
   "from": 45.63,
   "to": 46.54,
   "sid": 25,
   "location": 2,
   "content": "像这样"
  },
  {
   "from": 49.1,
   "to": 50.56,
   "sid": 26,
   "location": 2,
   "content": "但是如果球在上升段"
  },
  {
   "from": 50.56,
   "to": 53.56,
   "sid": 27,
   "location": 2,
   "content": "我们就去拨它诶"
  },
  {
   "from": 53.56,
   "to": 55.04,
   "sid": 28,
   "location": 2,
   "content": "就非常轻松对吧"
