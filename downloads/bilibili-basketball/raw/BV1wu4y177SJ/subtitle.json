  },
  {
   "from": 16.1,
   "to": 18.86,
   "sid": 7,
   "location": 2,
   "content": "今天介绍两个注意事项和两个训练方法",
   "music": 0
  },
  {
   "from": 18.86,
   "to": 22.01,
   "sid": 8,
   "location": 2,
   "content": "让你初步掌握后仰跳投的第一点站位问题",
   "music": 0
  },
  {
   "from": 22.01,
   "to": 25.11,
   "sid": 9,
   "location": 2,
   "content": "很多人脚尖正向篮筐横着走",
   "music": 0
  },
  {
   "from": 25.11,
   "to": 26.04,
   "sid": 10,
   "location": 2,
   "content": "重心不稳",
