  },
  {
   "from": 30.15,
   "to": 31.65,
   "sid": 14,
   "location": 2,
   "content": "从而保持身体的平衡",
   "music": 0
  },
  {
   "from": 31.65,
   "to": 32.83,
   "sid": 15,
   "location": 2,
   "content": "提高投篮命中率",
   "music": 0
  },
  {
   "from": 32.83,
   "to": 33.85,
   "sid": 16,
   "location": 2,
   "content": "对于他来说",
   "music": 0
  },
  {
   "from": 33.85,
   "to": 35.65,
   "sid": 17,
   "location": 2,
   "content": "他投篮落地脚是右脚",
