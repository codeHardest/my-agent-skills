  {
   "from": 37.06,
   "to": 38.29,
   "sid": 19,
   "location": 2,
   "content": "斜着站位投篮",
   "music": 0
  },
  {
   "from": 38.29,
   "to": 40.74,
   "sid": 20,
   "location": 2,
   "content": "落地脚是左脚",
