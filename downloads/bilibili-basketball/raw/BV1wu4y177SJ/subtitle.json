   "from": 27.24,
   "to": 28.77,
   "sid": 12,
   "location": 2,
   "content": "练习中应该斜着站位",
   "music": 0
  },
  {
   "from": 28.77,
   "to": 30.15,
   "sid": 13,
   "location": 2,
   "content": "这样可以更好的发力",
