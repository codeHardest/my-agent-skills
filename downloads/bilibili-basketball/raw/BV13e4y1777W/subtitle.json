{
 "font_size": 0.4,
 "font_color": "#FFFFFF",
 "background_alpha": 0.5,
 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "v1.4.0.4",
 "body": [
  {
   "from": 0,
   "to": 2.16,
   "sid": 1,
   "location": 2,
   "content": "球场上最尴尬的事莫过于"
  },
  {
   "from": 2.16,
   "to": 4.11,
   "sid": 2,
   "location": 2,
   "content": "你做了一套精彩绝伦的连招后"
  },
  {
   "from": 4.11,
   "to": 6.48,
   "sid": 3,
   "location": 2,
   "content": "请用一个变相潇洒摆脱对手"
  },
  {
   "from": 6.48,
   "to": 8.4,
   "sid": 4,
   "location": 2,
   "content": "结果此时发现防守人"
  },
  {
   "from": 8.4,
   "to": 10.11,
   "sid": 5,
   "location": 2,
   "content": "根本没有被你的变相骗到"
  },
  {
   "from": 10.11,
   "to": 11.34,
   "sid": 6,
   "location": 2,
   "content": "如此尴尬的情况"
  },
  {
   "from": 11.34,
   "to": 13.059,
   "sid": 7,
   "location": 2,
   "content": "我们应该如何化解呢"
  },
  {
   "from": 13.059,
   "to": 15.34,
   "sid": 8,
   "location": 2,
   "content": "今天kt分享五个思路"
  },
  {
   "from": 15.58,
   "to": 17.86,
   "sid": 9,
   "location": 2,
   "content": "一背后急停加跳投"
  },
  {
   "from": 17.86,
   "to": 20.26,
   "sid": 10,
   "location": 2,
   "content": "如果你在做完一顿连招衔接变向后"
  },
  {
   "from": 20.26,
   "to": 22.31,
   "sid": 11,
   "location": 2,
   "content": "发现防守人不仅没有失位"
  },
  {
   "from": 22.31,
   "to": 24.08,
   "sid": 12,
   "location": 2,
   "content": "还很聪明的再往里走"
  },
  {
   "from": 24.08,
   "to": 25.67,
   "sid": 13,
   "location": 2,
   "content": "准备去封盖你的上篮呢"
  },
  {
   "from": 25.67,
   "to": 27.229,
   "sid": 14,
   "location": 2,
   "content": "那我们应该怎么办呢"
  },
  {
   "from": 27.229,
   "to": 30.169,
   "sid": 15,
   "location": 2,
   "content": "他往里我们往外立马做一个背后变向"
  },
  {
   "from": 30.169,
   "to": 32.68,
   "sid": 16,
   "location": 2,
   "content": "拉开空间投他就完事儿了"
  },
  {
   "from": 32.68,
   "to": 34.06,
   "sid": 17,
   "location": 2,
   "content": "二背后急停"
  },
  {
   "from": 34.06,
   "to": 35.379,
   "sid": 18,
   "location": 2,
   "content": "加尼克杨转身"
  },
  {
   "from": 35.379,
   "to": 37.449,
   "sid": 19,
   "location": 2,
   "content": "同样是变相没有过掉防守人"
  },
  {
   "from": 37.449,
   "to": 39.309,
   "sid": 20,
   "location": 2,
   "content": "不过这次他不往里走了"
  },
  {
   "from": 39.309,
   "to": 41.829,
   "sid": 21,
   "location": 2,
   "content": "而选择直接一个横移挡在你的面前"
  },
  {
   "from": 41.829,
   "to": 43.32,
   "sid": 22,
   "location": 2,
   "content": "不给投篮的空间"
  },
  {
   "from": 43.32,
   "to": 44.94,
   "sid": 23,
   "location": 2,
   "content": "这时应该怎么办呢"
  },
  {
   "from": 44.94,
   "to": 45.9,
   "sid": 24,
   "location": 2,
   "content": "没关系"
  },
  {
   "from": 45.9,
   "to": 48.24,
   "sid": 25,
   "location": 2,
   "content": "尼克杨老师曾经在球场上告诉我们"
  },
  {
   "from": 48.24,
   "to": 49.05,
   "sid": 26,
   "location": 2,
   "content": "一套连招"
  },
  {
   "from": 49.05,
   "to": 50.25,
   "sid": 27,
   "location": 2,
   "content": "找不到投篮机会"
  },
  {
   "from": 50.25,
   "to": 52.879,
   "sid": 28,
   "location": 2,
   "content": "再加一个转身就能完美化解"
  },
  {
   "from": 52.96,
   "to": 55.81,
   "sid": 29,
   "location": 2,
   "content": "三背后急停加锁定转身"
  },
  {
   "from": 55.81,
   "to": 57.7,
   "sid": 30,
   "location": 2,
   "content": "如果你是一个节奏型球员"
  },
  {
   "from": 57.7,
   "to": 59.08,
   "sid": 31,
   "location": 2,
   "content": "而在被封堵的时候"
  },
  {
   "from": 59.08,
   "to": 61.98,
   "sid": 32,
   "location": 2,
   "content": "你可以在背后急停后衔接锁定转身"
  },
  {
   "from": 61.98,
   "to": 63.84,
   "sid": 33,
   "location": 2,
   "content": "背后变向完全不住球"
  },
  {
   "from": 63.84,
   "to": 64.74,
   "sid": 34,
   "location": 2,
   "content": "稍作停顿"
  },
  {
   "from": 64.74,
   "to": 66.72,
   "sid": 35,
   "location": 2,
   "content": "随后快速做一个转身换手"
  },
  {
   "from": 66.72,
   "to": 67.86,
   "sid": 36,
   "location": 2,
   "content": "一慢一快的节奏"
  },
  {
   "from": 67.86,
   "to": 70.38,
   "sid": 37,
   "location": 2,
   "content": "很容易就能把对手定在原地"
  },
  {
   "from": 70.46,
   "to": 73.43,
   "sid": 38,
   "location": 2,
   "content": "四背后急停加晃肩翻身跳投"
  },
  {
   "from": 73.43,
   "to": 75.98,
   "sid": 39,
   "location": 2,
   "content": "如果你想用同样的套路再打对手一个"
  },
  {
   "from": 75.98,
   "to": 77.57,
   "sid": 40,
   "location": 2,
   "content": "那我们可以把锁定转身"
  },
  {
   "from": 77.57,
   "to": 79.85,
   "sid": 41,
   "location": 2,
   "content": "换成科比招牌的背身晃肩"
  },
  {
   "from": 79.85,
   "to": 82.31,
   "sid": 42,
   "location": 2,
   "content": "同样是做完背后急停后悬浮住球"
  },
  {
   "from": 82.31,
   "to": 84.74,
   "sid": 43,
   "location": 2,
   "content": "不过这一次我们要在下球的一瞬间"
  },
  {
   "from": 84.74,
   "to": 86.78,
   "sid": 44,
   "location": 2,
   "content": "做一个向底线方向的火箭"
  },
  {
   "from": 86.78,
   "to": 89,
   "sid": 45,
   "location": 2,
   "content": "诱导防守人向底线方向封堵"
  },
  {
   "from": 89,
   "to": 91.19,
   "sid": 46,
   "location": 2,
   "content": "随后我们的转回上线去投篮"
  },
  {
   "from": 91.19,
   "to": 92.84,
   "sid": 47,
   "location": 2,
   "content": "你以为我要做锁定转身"
  },
  {
   "from": 92.84,
   "to": 95.48,
   "sid": 48,
   "location": 2,
   "content": "其实我早就预判了你的预判"
  },
  {
   "from": 95.54,
   "to": 96.44,
   "sid": 49,
   "location": 2,
   "content": "讲到这里"
  },
  {
   "from": 96.44,
   "to": 97.64,
   "sid": 50,
   "location": 2,
   "content": "肯定有小伙伴要问了"
  },
  {
   "from": 97.64,
   "to": 99.32,
   "sid": 51,
   "location": 2,
   "content": "刚才的连招很实用"
  },
  {
   "from": 99.32,
   "to": 102.07,
   "sid": 52,
   "location": 2,
   "content": "但有没有更秀一点的动作可以化解封堵"
  },
  {
   "from": 102.07,
   "to": 103.12,
   "sid": 53,
   "location": 2,
   "content": "当然有"
  },
  {
   "from": 103.12,
   "to": 105.22,
   "sid": 54,
   "location": 2,
   "content": "同样是变相后被对手封堵住"
  },
  {
   "from": 105.22,
   "to": 107.77,
   "sid": 55,
   "location": 2,
   "content": "我们可以先用背后急停慢下节奏"
  },
  {
   "from": 107.77,
   "to": 110.05,
   "sid": 56,
   "location": 2,
   "content": "随后立马衔接一个转身回马枪"
  },
  {
   "from": 110.05,
   "to": 111.53,
   "sid": 57,
   "location": 2,
   "content": "潇洒摆脱对手"
  },
  {
   "from": 111.53,
   "to": 114.01,
   "sid": 58,
   "location": 2,
   "content": "这个动作的过程原理和锁定转身类似"
  },
  {
   "from": 114.01,
   "to": 116.41,
   "sid": 59,
   "location": 2,
   "content": "可观赏性就高出了好几个档次"
  },
  {
   "from": 116.41,
   "to": 119.33,
   "sid": 60,
   "location": 2,
   "content": "如果能在实战当中成功用出这招"
  },
  {
   "from": 119.33,
   "to": 120.83,
   "sid": 61,
   "location": 2,
   "content": "那场下的女球友们"
  },
  {
   "from": 120.83,
   "to": 123.84,
   "sid": 62,
   "location": 2,
   "content": "一定会为你的高光时刻而惊叫连连"
  },
  {
   "from": 124.22,
   "to": 127.73,
   "sid": 63,
   "location": 2,
   "content": "最后上述这几个连招你最喜欢哪个呢"
  },
  {
   "from": 127.73,
   "to": 129.38,
   "sid": 64,
   "location": 2,
   "content": "评论区里说一说吧"
  }
 ]
}