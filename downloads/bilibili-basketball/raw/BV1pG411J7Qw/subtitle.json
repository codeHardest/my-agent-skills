 "body": [
  {
   "from": 0.16,
   "to": 1.33,
   "sid": 1,
   "location": 2,
   "content": "作为一个篮球up主"
  },
  {
   "from": 1.33,
   "to": 3.13,
   "sid": 2,
   "location": 2,
   "content": "我邮箱里全是问投篮的邮件"
  },
  {
   "from": 3.13,
   "to": 5.1,
   "sid": 3,
   "location": 2,
   "content": "其中问的最多的问题有两类"
  },
  {
   "from": 5.1,
   "to": 6.87,
   "sid": 4,
   "location": 2,
   "content": "一是为什么我总是往前跳"
  },
  {
   "from": 6.87,
   "to": 7.77,
   "sid": 5,
   "location": 2,
   "content": "距离越远"
  },
  {
   "from": 7.77,
   "to": 8.85,
   "sid": 6,
   "location": 2,
   "content": "跳得越厉害"
  },
  {
   "from": 8.85,
   "to": 10.56,
   "sid": 7,
   "location": 2,
   "content": "二是为什么总感觉不流畅"
  },
  {
   "from": 10.56,
   "to": 11.85,
   "sid": 8,
   "location": 2,
   "content": "脑子里是one motion"
  },
  {
   "from": 11.85,
   "to": 13.27,
   "sid": 9,
   "location": 2,
   "content": "露出来却是秃谋神"
  },
  {
   "from": 13.27,
   "to": 15.31,
   "sid": 10,
   "location": 2,
   "content": "但实际上往前跳一点"
  },
  {
   "from": 15.31,
   "to": 15.91,
   "sid": 11,
   "location": 2,
   "content": "卡一点"
  },
  {
   "from": 15.91,
   "to": 18.37,
   "sid": 12,
   "location": 2,
   "content": "可能是很多人唯一能够三分钟破的方式"
  },
  {
   "from": 18.37,
   "to": 19.75,
   "sid": 13,
   "location": 2,
   "content": "这样他完全不往前"
  },
  {
   "from": 19.75,
   "to": 20.62,
   "sid": 14,
   "location": 2,
   "content": "完全不卡"
  },
  {
   "from": 20.62,
   "to": 21.98,
   "sid": 15,
   "location": 2,
   "content": "他反而会三不沾"
  },
  {
   "from": 21.98,
   "to": 23.21,
   "sid": 16,
   "location": 2,
   "content": "所以我一直觉得"
  },
  {
   "from": 23.21,
   "to": 25.1,
   "sid": 17,
   "location": 2,
   "content": "这里面一定有一个反直觉的点"
  },
  {
   "from": 25.1,
   "to": 26.36,
   "sid": 18,
   "location": 2,
   "content": "是我们看了这么多教学"
  },
  {
   "from": 26.36,
   "to": 27.44,
   "sid": 19,
   "location": 2,
   "content": "也没有人知道的"
  },
  {
   "from": 27.44,
   "to": 29.66,
   "sid": 20,
   "location": 2,
   "content": "直到我看了一个很神奇的片段"
  },
  {
   "from": 29.66,
   "to": 31.58,
   "sid": 21,
   "location": 2,
   "content": "i saw you focus on keeping the ball"
  },
  {
   "from": 31.58,
   "to": 33.35,
   "sid": 22,
   "location": 2,
   "content": "right here get to the ball"
  },
  {
   "from": 33.35,
   "to": 34.37,
   "sid": 23,
   "location": 2,
   "content": "right now"
  },
  {
   "from": 34.37,
   "to": 35.63,
   "sid": 24,
   "location": 2,
   "content": "i would be like this"
  },
  {
   "from": 35.63,
   "to": 38.66,
   "sid": 25,
   "location": 2,
   "content": "you to go and get y"
  },
  {
   "from": 39.74,
   "to": 41.86,
   "sid": 26,
   "location": 2,
   "content": "这个片段反直觉的地方在于"
  },
  {
   "from": 41.86,
   "to": 43.27,
   "sid": 27,
   "location": 2,
   "content": "它不是往上举球"
  },
  {
   "from": 43.27,
   "to": 44.94,
   "sid": 28,
   "location": 2,
   "content": "而是整个人往脚下钻"
  },
  {
   "from": 44.94,
   "to": 46.86,
   "sid": 29,
   "location": 2,
   "content": "实际上人往中路下面钻"
  },
  {
   "from": 46.86,
   "to": 48.349,
   "sid": 30,
   "location": 2,
   "content": "在奥局里是非常普遍的"
  },
  {
   "from": 48.349,
   "to": 50.569,
   "sid": 31,
   "location": 2,
   "content": "很多朋友都说自己感受不到价值的礼"
  },
  {
   "from": 50.569,
   "to": 52.019,
   "sid": 32,
   "location": 2,
   "content": "或者一投三分就泄力"
  },
  {
   "from": 52.019,
   "to": 54.449,
   "sid": 33,
   "location": 2,
   "content": "我认为和不会往下钻有很大的关系"
  },
  {
   "from": 54.449,
   "to": 56.519,
   "sid": 34,
   "location": 2,
   "content": "因为它有两个地方是很反直觉的"
  },
  {
   "from": 56.519,
   "to": 57.66,
   "sid": 35,
   "location": 2,
   "content": "一是足背屈"
  },
  {
   "from": 57.66,
   "to": 58.8,
   "sid": 36,
   "location": 2,
   "content": "不必去说人话"
  },
  {
   "from": 58.8,
   "to": 59.7,
   "sid": 37,
   "location": 2,
   "content": "就是勾脚尖"
  },
  {
   "from": 59.7,
   "to": 60.66,
   "sid": 38,
   "location": 2,
   "content": "主动勾脚"
  },
  {
   "from": 60.66,
   "to": 62.61,
   "sid": 39,
   "location": 2,
   "content": "我发现自己的脚踝更有力了"
  },
  {
   "from": 62.61,
   "to": 63.7,
   "sid": 40,
   "location": 2,
   "content": "弧度也更高了"
  },
  {
   "from": 63.7,
   "to": 65.14,
   "sid": 41,
   "location": 2,
   "content": "我们来看一个对比"
  },
  {
   "from": 65.14,
   "to": 66.13,
   "sid": 42,
   "location": 2,
   "content": "左边是勾脚"
  },
  {
   "from": 66.13,
   "to": 67.18,
   "sid": 43,
   "location": 2,
   "content": "右边是踮脚"
  },
  {
   "from": 67.18,
   "to": 69.73,
   "sid": 44,
   "location": 2,
   "content": "右边在下降时就有明显的前倾趋势"
  },
  {
   "from": 69.73,
   "to": 72.259,
   "sid": 45,
   "location": 2,
   "content": "左边的重心则要直上直下的多"
  },
  {
   "from": 78.52,
   "to": 79.23,
   "sid": 46,
   "location": 2,
   "content": "出走"
  },
  {
   "from": 79.23,
   "to": 80.7,
   "sid": 47,
   "location": 2,
   "content": "我在看粉丝路线的时候"
  },
  {
   "from": 80.7,
   "to": 82.08,
   "sid": 48,
   "location": 2,
   "content": "发现一个很神奇的事儿"
  },
  {
   "from": 82.08,
   "to": 84.69,
   "sid": 49,
   "location": 2,
   "content": "很多人的出手速度其实比库里还快"
  },
  {
   "from": 84.69,
   "to": 85.95,
   "sid": 50,
   "location": 2,
   "content": "他们之所以这么快"
  },
  {
   "from": 85.95,
   "to": 88.77,
   "sid": 51,
   "location": 2,
   "content": "是因为手刚翻到球下面就开始往前推了"
  },
  {
   "from": 88.77,
   "to": 90.44,
   "sid": 52,
   "location": 2,
   "content": "缺少了一个出轴的环节"
  },
  {
   "from": 90.44,
   "to": 92.57,
   "sid": 53,
   "location": 2,
   "content": "出手在举重里是一个很重要的动作"
  },
  {
   "from": 92.57,
   "to": 94.36,
   "sid": 54,
   "location": 2,
   "content": "能让借力推变得更轻松"
  },
  {
   "from": 94.36,
   "to": 95.59,
   "sid": 55,
   "location": 2,
   "content": "对投篮来说"
  },
  {
   "from": 95.59,
   "to": 98.73,
   "sid": 56,
   "location": 2,
   "content": "早出走加小手脚也能让三分更轻松"
  },
  {
   "from": 98.73,
   "to": 102.18,
   "sid": 57,
   "location": 2,
   "content": "在nba早出手加小手脚正变得越来越流行"
  },
  {
   "from": 102.18,
   "to": 103.92,
   "sid": 58,
   "location": 2,
   "content": "连威少都在往这个方向改"
  },
  {
   "from": 103.92,
   "to": 105.24,
   "sid": 59,
   "location": 2,
   "content": "这是曾经的威少"
  },
  {
   "from": 105.24,
   "to": 106.47,
   "sid": 60,
   "location": 2,
   "content": "这是最近的威少"
  },
  {
   "from": 106.47,
   "to": 108,
   "sid": 61,
   "location": 2,
   "content": "是不是变化很大"
  },
  {
   "from": 111.46,
   "to": 114.22,
   "sid": 62,
   "location": 2,
   "content": "三练习投篮有点像斗机机"
  },
  {
   "from": 114.22,
   "to": 115.36,
   "sid": 63,
   "location": 2,
   "content": "近端很用力"
  },
  {
   "from": 115.36,
   "to": 116.56,
   "sid": 64,
   "location": 2,
   "content": "远端是放松的"
  },
  {
   "from": 116.56,
   "to": 119.17,
   "sid": 65,
   "location": 2,
   "content": "但在投篮时我发现自己很容易反过来"
  },
  {
   "from": 119.17,
   "to": 120.28,
   "sid": 66,
   "location": 2,
   "content": "变成上肢紧张"
  },
  {
   "from": 120.28,
   "to": 121.28,
   "sid": 67,
   "location": 2,
   "content": "下肢放松"
  },
  {
   "from": 121.28,
   "to": 122.36,
   "sid": 68,
   "location": 2,
   "content": "对于这个问题"
  },
  {
   "from": 122.36,
   "to": 124.52,
   "sid": 69,
   "location": 2,
   "content": "经典的矫正方案是慢下快起"
  },
  {
   "from": 124.52,
   "to": 126.77,
   "sid": 70,
   "location": 2,
   "content": "慢下时下肢会自然紧张"
  },
  {
   "from": 126.77,
   "to": 127.64,
   "sid": 71,
   "location": 2,
   "content": "此消彼长"
  },
  {
   "from": 127.64,
   "to": 129.42,
   "sid": 72,
   "location": 2,
   "content": "上肢就没那么紧张了"
  },
  {
   "from": 129.959,
   "to": 131.969,
   "sid": 73,
   "location": 2,
   "content": "最后给大家推荐一本书"
  },
  {
   "from": 131.969,
   "to": 133.319,
   "sid": 74,
   "location": 2,
   "content": "里面对哪里该放松"
  },
  {
   "from": 133.319,
   "to": 134.279,
   "sid": 75,
   "location": 2,
   "content": "哪里该紧张"
  },
  {
   "from": 134.279,
   "to": 135.479,
   "sid": 76,
   "location": 2,
   "content": "描写的都特别好"
  },
  {
   "from": 135.479,
   "to": 137.64,
   "sid": 77,
   "location": 2,
   "content": "这本书的电子版我会放到评论区里"
  },
  {
   "from": 137.64,
   "to": 139.42,
   "sid": 78,
   "location": 2,
   "content": "希望大家能给个一键三连"
  }
 ]
}