{
 "font_size": 0.4,
 "font_color": "#FFFFFF",
 "background_alpha": 0.5,
 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "v1.6.0.4",
 "body": [
  {
   "from": 0.02,
   "to": 3.02,
   "sid": 1,
   "location": 2,
   "content": "这个恶鼠的反胯下绕腿突破你应该见过",
   "music": 0
  },
  {
   "from": 3.02,
   "to": 5.34,
   "sid": 2,
   "location": 2,
   "content": "但是我们在慢动作的情况下去回看",
   "music": 0
  },
  {
   "from": 5.34,
   "to": 7.32,
   "sid": 3,
   "location": 2,
   "content": "它并不只是一个小小的瑕疵",
   "music": 0
  },
  {
   "from": 7.32,
   "to": 10.2,
   "sid": 4,
   "location": 2,
   "content": "而是整只脚已经迈出了一整步出去",
   "music": 0
  },
  {
   "from": 10.2,
   "to": 13.07,
   "sid": 5,
   "location": 2,
   "content": "现在我们对反胯下这个动作进行一个升级",
   "music": 0
  },
  {
   "from": 13.07,
   "to": 15.51,
   "sid": 6,
   "location": 2,
   "content": "让它更快并且瑕疵更小",
   "music": 0
  },
  {
   "from": 15.51,
   "to": 18.09,
   "sid": 7,
   "location": 2,
   "content": "我们可以在反胯下绕腿完之后",
   "music": 0
  },
  {
   "from": 18.09,
   "to": 19.92,
   "sid": 8,
   "location": 2,
   "content": "前脚先进行一个挖步",
   "music": 0
  },
  {
   "from": 19.92,
   "to": 23.26,
   "sid": 9,
   "location": 2,
   "content": "此时抬起中轴脚和下球几乎是同时的",
   "music": 0
  },
  {
   "from": 23.26,
   "to": 26.22,
   "sid": 10,
   "location": 2,
   "content": "下球之后我们再进行一个内侧脚的挖步",
   "music": 0
  },
  {
   "from": 26.22,
   "to": 28.32,
   "sid": 11,
   "location": 2,
   "content": "外侧脚内侧脚依次挖步",
   "music": 0
  },
  {
   "from": 28.32,
   "to": 30.84,
   "sid": 12,
   "location": 2,
   "content": "会让你获得一个超快的启动加速",
   "music": 0
  },
  {
   "from": 30.84,
   "to": 32.52,
   "sid": 13,
   "location": 2,
   "content": "在肉眼的情况下去看",
   "music": 0
  },
  {
   "from": 32.52,
   "to": 34.3,
   "sid": 14,
   "location": 2,
   "content": "几乎是没有任何瑕疵的",
   "music": 0
  },
  {
   "from": 34.3,
   "to": 35.56,
   "sid": 15,
   "location": 2,
   "content": "如何去练习",
   "music": 0
  },
  {
   "from": 35.56,
   "to": 37.9,
   "sid": 16,
   "location": 2,
   "content": "首先我们在进行反胯下绕腿的时候",
   "music": 0
  },
  {
   "from": 37.9,
   "to": 40,
   "sid": 17,
   "location": 2,
   "content": "先要找到重心转移的感觉",
   "music": 0
  },
  {
   "from": 40,
   "to": 42.28,
   "sid": 18,
   "location": 2,
   "content": "第二个就是在你挖不的一瞬间",
   "music": 0
  },
  {
   "from": 42.28,
   "to": 43.78,
   "sid": 19,
   "location": 2,
   "content": "要瞬间去下球",
   "music": 0
  },
  {
   "from": 43.78,
   "to": 44.5,
   "sid": 20,
   "location": 2,
   "content": "第三点",
   "music": 0
  },
  {
   "from": 44.5,
   "to": 45.58,
   "sid": 21,
   "location": 2,
   "content": "在下完球之后",
   "music": 0
  },
  {
   "from": 45.58,
   "to": 47.44,
   "sid": 22,
   "location": 2,
   "content": "左脚不要进行大的上门",
   "music": 0
  },
  {
   "from": 47.44,
   "to": 50.18,
   "sid": 23,
   "location": 2,
   "content": "而是进行一个小的内侧脚的挖步",
   "music": 0
  },
  {
   "from": 50.18,
   "to": 52.68,
   "sid": 24,
   "location": 2,
   "content": "兄弟们来给这个动作起个名字吧",
   "music": 0
  }
 ]
}