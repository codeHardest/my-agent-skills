{
 "font_size": 0.4,
 "font_color": "#FFFFFF",
 "background_alpha": 0.5,
 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "en-v1.2.0.4-t0.3.c",
 "body": [
  {
   "from": 0.26,
   "to": 2.64,
   "sid": 1,
   "location": 2,
   "content": "教练马库斯带着IB精英训练来了"
  },
  {
   "from": 2.64,
   "to": 5.48,
   "sid": 2,
   "location": 2,
   "content": "今天我要给你们七强"
  },
  {
   "from": 5.48,
   "to": 7.12,
   "sid": 3,
   "location": 2,
   "content": "势不可挡一对一"
  },
  {
   "from": 7.12,
   "to": 8.28,
   "sid": 4,
   "location": 2,
   "content": "你不想错过男人"
  },
  {
   "from": 8.28,
   "to": 9.66,
   "sid": 5,
   "location": 2,
   "content": "我们自己去拿吧"
  },
  {
   "from": 9.66,
   "to": 10.44,
   "sid": 6,
   "location": 2,
   "content": "现在"
  },
  {
   "from": 10.44,
   "to": 12.3,
   "sid": 7,
   "location": 2,
   "content": "把地窖拆了"
  },
  {
   "from": 12.3,
   "to": 14.54,
   "sid": 8,
   "location": 2,
   "content": "这是一个伟大的举动"
  },
  {
   "from": 14.54,
   "to": 16.7,
   "sid": 9,
   "location": 2,
   "content": "第一个是一磅一磅"
  },
  {
   "from": 16.7,
   "to": 18.76,
   "sid": 10,
   "location": 2,
   "content": "有史以来最好的球员"
  },
  {
   "from": 18.76,
   "to": 19.93,
   "sid": 11,
   "location": 2,
   "content": "一磅一磅"
  },
  {
   "from": 19.93,
   "to": 21.97,
   "sid": 12,
   "location": 2,
   "content": "艾伦·艾弗森六英尺"
  },
  {
   "from": 21.97,
   "to": 23.57,
   "sid": 13,
   "location": 2,
   "content": "如果那六十五"
  },
  {
   "from": 23.57,
   "to": 24.65,
   "sid": 14,
   "location": 2,
   "content": "这就是他斤斤计较的原因"
  },
  {
   "from": 24.65,
   "to": 26.47,
   "sid": 15,
   "location": 2,
   "content": "有史以来最好的篮球运动员"
  },
  {
   "from": 26.47,
   "to": 27.53,
   "sid": 16,
   "location": 2,
   "content": "依我看"
  },
  {
   "from": 27.53,
   "to": 28.35,
   "sid": 17,
   "location": 2,
   "content": "没有辩论"
  },
  {
   "from": 28.35,
   "to": 29.51,
   "sid": 18,
   "location": 2,
   "content": "但这是他的跨界"
  },
  {
   "from": 29.51,
   "to": 32.29,
   "sid": 19,
   "location": 2,
   "content": "他的杀手级交叉防守势不可挡"
  },
  {
   "from": 32.29,
   "to": 33.89,
   "sid": 20,
   "location": 2,
   "content": "你们在迈克尔·乔丹身上看到了"
  },
  {
   "from": 33.89,
   "to": 37,
   "sid": 21,
   "location": 2,
   "content": "他可能也是有史以来最好的球员之一"
  },
  {
   "from": 37,
   "to": 38.92,
   "sid": 22,
   "location": 2,
   "content": "他把那个人从鞋子里划掉了。"
  },
  {
   "from": 38.92,
   "to": 40.85,
   "sid": 23,
   "location": 2,
   "content": "他是怎么做到的"
  },
  {
   "from": 40.85,
   "to": 44.59,
   "sid": 24,
   "location": 2,
   "content": "他明白乔丹是如何保护他的，给了他一个小圈套"
  },
  {
   "from": 44.59,
   "to": 45.55,
   "sid": 25,
   "location": 2,
   "content": "交叉优先"
  },
  {
   "from": 45.55,
   "to": 47.36,
   "sid": 26,
   "location": 2,
   "content": "所以如果你能去看看片段"
  },
  {
   "from": 47.36,
   "to": 48.14,
   "sid": 27,
   "location": 2,
   "content": "你会注意到"
  },
  {
   "from": 48.14,
   "to": 49.88,
   "sid": 28,
   "location": 2,
   "content": "当他从左到右"
  },
  {
   "from": 49.88,
   "to": 51.4,
   "sid": 29,
   "location": 2,
   "content": "他有点陷害他"
  },
  {
   "from": 51.4,
   "to": 55.37,
   "sid": 30,
   "location": 2,
   "content": "他明白迈克尔·乔丹咬了或者不只是迈克尔·乔丹"
  },
  {
   "from": 55.37,
   "to": 57.91,
   "sid": 31,
   "location": 2,
   "content": "但每个人都会开始以自己的方式咬人"
  },
  {
   "from": 57.91,
   "to": 61.07,
   "sid": 32,
   "location": 2,
   "content": "这是一个完美的时间来建立最终的左或右"
  },
  {
   "from": 61.07,
   "to": 63.47,
   "sid": 33,
   "location": 2,
   "content": "交叉真的让你的基础很宽"
  },
  {
   "from": 63.47,
   "to": 64.65,
   "sid": 34,
   "location": 2,
   "content": "使用该链接"
  },
  {
   "from": 64.65,
   "to": 65.63,
   "sid": 35,
   "location": 2,
   "content": "如果你有的话"
  },
  {
   "from": 65.63,
   "to": 67.79,
   "sid": 36,
   "location": 2,
   "content": "如果不确保球在你的口袋里"
  },
  {
   "from": 67.79,
   "to": 71.3,
   "sid": 37,
   "location": 2,
   "content": "把我的重心转移到一个方向"
  },
  {
   "from": 71.7,
   "to": 74.16,
   "sid": 38,
   "location": 2,
   "content": "把球拉过来，把球传过来"
  },
  {
   "from": 74.16,
   "to": 77.97,
   "sid": 39,
   "location": 2,
   "content": "所以第一名是艾伦·艾弗森的跨界"
  },
  {
   "from": 77.97,
   "to": 79.67,
   "sid": 40,
   "location": 2,
   "content": "与艾伦·艾弗森交叉"
  },
  {
   "from": 79.67,
   "to": 81.33,
   "sid": 41,
   "location": 2,
   "content": "这将是关于他的内侧脚"
  },
  {
   "from": 81.33,
   "to": 82.71,
   "sid": 42,
   "location": 2,
   "content": "也就是他的右腿"
  },
  {
   "from": 82.71,
   "to": 84.45,
   "sid": 43,
   "location": 2,
   "content": "因为他喜欢从左到右"
  },
  {
   "from": 84.45,
   "to": 86.25,
   "sid": 44,
   "location": 2,
   "content": "所以当他运球的时候"
  },
  {
   "from": 86.25,
   "to": 88.51,
   "sid": 45,
   "location": 2,
   "content": "他会运球，然后踩右脚"
  },
  {
   "from": 88.51,
   "to": 91.59,
   "sid": 46,
   "location": 2,
   "content": "然后加一个小跳跃来推动那个推"
  },
  {
   "from": 91.59,
   "to": 94.33,
   "sid": 47,
   "location": 2,
   "content": "给人一种错觉，以为他会从你身边飞过"
  },
  {
   "from": 94.33,
   "to": 96.29,
   "sid": 48,
   "location": 2,
   "content": "所以在这里我有我的运球"
  },
  {
   "from": 96.29,
   "to": 97.13,
   "sid": 49,
   "location": 2,
   "content": "我会运球"
  },
  {
   "from": 97.13,
   "to": 98.73,
   "sid": 50,
   "location": 2,
   "content": "我会轻敲和推动"
  },
  {
   "from": 98.73,
   "to": 99.93,
   "sid": 51,
   "location": 2,
   "content": "这是我的设置"
  },
  {
   "from": 99.93,
   "to": 101.49,
   "sid": 52,
   "location": 2,
   "content": "我从左向右穿越"
  },
  {
   "from": 101.49,
   "to": 102.58,
   "sid": 53,
   "location": 2,
   "content": "所以我会去这里"
  },
  {
   "from": 104.03,
   "to": 105.45,
   "sid": 54,
   "location": 2,
   "content": "那是我的跨界曲"
  },
  {
   "from": 105.45,
   "to": 108.18,
   "sid": 55,
   "location": 2,
   "content": "当我把球传过来时的另一个关键点"
  },
  {
   "from": 108.18,
   "to": 111.58,
   "sid": 56,
   "location": 2,
   "content": "让我们确保这只左脚几乎要跟着篮球走"
  },
  {
   "from": 111.58,
   "to": 115.6,
   "sid": 57,
   "location": 2,
   "content": "所以当我把球传中时，左脚跟着球"
  },
  {
   "from": 115.6,
   "to": 117.92,
   "sid": 58,
   "location": 2,
   "content": "我会看到很多球员传中"
  },
  {
   "from": 117.92,
   "to": 120.24,
   "sid": 59,
   "location": 2,
   "content": "他们会越过，几乎漏斗跳过"
  },
  {
   "from": 120.24,
   "to": 121.539,
   "sid": 60,
   "location": 2,
   "content": "他们会这样走"
  },
  {
   "from": 121.58,
   "to": 124.26,
   "sid": 61,
   "location": 2,
   "content": "所以他们增加了一个额外的步骤或一个额外的层"
  },
  {
   "from": 124.26,
   "to": 126.3,
   "sid": 62,
   "location": 2,
   "content": "这会降低他们的速度"
  },
  {
   "from": 137.14,
   "to": 138.42,
   "sid": 63,
   "location": 2,
   "content": "我不知道"
  },
  {
   "from": 143.3,
   "to": 144.7,
   "sid": 64,
   "location": 2,
   "content": "把他们安排好"
  },
  {
   "from": 148.579,
   "to": 150.039,
   "sid": 65,
   "location": 2,
   "content": "当他穿越到"
  },
  {
   "from": 150.039,
   "to": 151.219,
   "sid": 66,
   "location": 2,
   "content": "他有安排"
  },
  {
   "from": 151.219,
   "to": 152.419,
   "sid": 67,
   "location": 2,
   "content": "但他一穿过"
  },
  {
   "from": 152.419,
   "to": 154.62,
   "sid": 68,
   "location": 2,
   "content": "他会传中，直接射门"
  },
  {
   "from": 163.139,
   "to": 167.619,
   "sid": 69,
   "location": 2,
   "content": "第二个不可阻挡的动作将是我的脚趾轻敲交叉"
  },
  {
   "from": 167.619,
   "to": 171.419,
   "sid": 70,
   "location": 2,
   "content": "斯蒂芬·库里以这样做而闻名他的脚非常非常自律"
  },
  {
   "from": 171.419,
   "to": 173.379,
   "sid": 71,
   "location": 2,
   "content": "当我把球转向左边时"
  },
  {
   "from": 173.379,
   "to": 177.819,
   "sid": 72,
   "location": 2,
   "content": "现在我想在这里加上小脚趾轻敲"
  },
  {
   "from": 177.819,
   "to": 179.859,
   "sid": 73,
   "location": 2,
   "content": "所以我的脚非常忙碌"
  },
  {
   "from": 179.859,
   "to": 182.279,
   "sid": 74,
   "location": 2,
   "content": "但是球在我手里会放松"
  },
  {
   "from": 182.279,
   "to": 184.68,
   "sid": 75,
   "location": 2,
   "content": "但一旦防守者开始看到它们的脚在动"
  },
  {
   "from": 184.68,
   "to": 185.9,
   "sid": 76,
   "location": 2,
   "content": "他们往往会惊慌失措"
  },
  {
   "from": 185.9,
   "to": 188.24,
   "sid": 77,
   "location": 2,
   "content": "尤其是如果它是一个如果你的花园的斯蒂芬咖喱"
  },
  {
   "from": 188.24,
   "to": 190.08,
   "sid": 78,
   "location": 2,
   "content": "然后就在那里，几乎是一个猜谜游戏"
  },
  {
   "from": 190.08,
   "to": 191.28,
   "sid": 79,
   "location": 2,
   "content": "你知道如果你后退"
  },
  {
   "from": 191.28,
   "to": 195.08,
   "sid": 80,
   "location": 2,
   "content": "你可以有适当的步法来投篮"
  },
  {
   "from": 195.08,
   "to": 198.02,
   "sid": 81,
   "location": 2,
   "content": "但现在我想让我们的交叉步法正确"
  },
  {
   "from": 198.02,
   "to": 199.22,
   "sid": 82,
   "location": 2,
   "content": "所以当我出来的时候"
  },
  {
   "from": 199.22,
   "to": 200.52,
   "sid": 83,
   "location": 2,
   "content": "我们会轻敲轻敲"
  },
  {
   "from": 200.52,
   "to": 202.399,
   "sid": 84,
   "location": 2,
   "content": "然后我们会在这个下降的姿势"
  },
  {
   "from": 202.399,
   "to": 204.359,
   "sid": 85,
   "location": 2,
   "content": "和艾伦·艾弗森的交叉一样"
  },
  {
   "from": 204.359,
   "to": 205.999,
   "sid": 86,
   "location": 2,
   "content": "看起来我在往一个方向走"
  },
  {
   "from": 205.999,
   "to": 207.599,
   "sid": 87,
   "location": 2,
   "content": "我的脚站得很宽"
  },
  {
   "from": 207.599,
   "to": 209.54,
   "sid": 88,
   "location": 2,
   "content": "我把球传过来"
  },
  {
   "from": 209.54,
   "to": 211.62,
   "sid": 89,
   "location": 2,
   "content": "最大的不同是这里的设置"
  },
  {
   "from": 211.62,
   "to": 212.459,
   "sid": 90,
   "location": 2,
   "content": "脚趾轻敲"
  },
  {
   "from": 212.459,
   "to": 214.499,
   "sid": 91,
   "location": 2,
   "content": "我去的时候可以帮你安排一下"
  },
  {
   "from": 214.499,
   "to": 216.979,
   "sid": 92,
   "location": 2,
   "content": "然后我会轻敲轻敲砰砰"
  },
  {
   "from": 216.979,
   "to": 217.979,
   "sid": 93,
   "location": 2,
   "content": "然后我穿过"
  },
  {
   "from": 217.979,
   "to": 218.86,
   "sid": 94,
   "location": 2,
   "content": "球过去了"
  },
  {
   "from": 250.239,
   "to": 254.95,
   "sid": 95,
   "location": 2,
   "content": "第三个最不可阻挡的举动将是投票率交叉"
  },
  {
   "from": 254.95,
   "to": 257.19,
   "sid": 96,
   "location": 2,
   "content": "所以我们没有给out加上结尾"
  },
  {
   "from": 257.19,
   "to": 259.17,
   "sid": 97,
   "location": 2,
   "content": "我只想直接进入这个姿势"
  },
  {
   "from": 259.17,
   "to": 260.66,
   "sid": 98,
   "location": 2,
   "content": "我想去转弯"
  },
  {
   "from": 260.66,
   "to": 261.459,
   "sid": 99,
   "location": 2,
   "content": "就像这样"
  },
  {
   "from": 261.459,
   "to": 263.34,
   "sid": 100,
   "location": 2,
   "content": "我想再一次转身踏步"
  },
  {
   "from": 263.34,
   "to": 264.34,
   "sid": 101,
   "location": 2,
   "content": "我站得很宽"
  },
  {
   "from": 264.34,
   "to": 265.5,
   "sid": 102,
   "location": 2,
   "content": "我左手上的球"
  },
  {
   "from": 265.5,
   "to": 266.8,
   "sid": 103,
   "location": 2,
   "content": "我只是真的在这里"
  },
  {
   "from": 266.8,
   "to": 270.27,
   "sid": 104,
   "location": 2,
   "content": "当我转身时，球先落地"
  },
  {
   "from": 270.27,
   "to": 272.05,
   "sid": 105,
   "location": 2,
   "content": "然后我也注意到了"
  },
  {
   "from": 272.05,
   "to": 272.97,
   "sid": 106,
   "location": 2,
   "content": "i更改级别"
  },
  {
   "from": 272.97,
   "to": 275.44,
   "sid": 107,
   "location": 2,
   "content": "我真的想在这里保持放松的姿势"
  },
  {
   "from": 275.44,
   "to": 277.04,
   "sid": 108,
   "location": 2,
   "content": "感受防守"
  },
  {
   "from": 277.04,
   "to": 278.28,
   "sid": 109,
   "location": 2,
   "content": "然后不知从哪里冒出来"
  },
  {
   "from": 278.28,
   "to": 279.42,
   "sid": 110,
   "location": 2,
   "content": "我要简单地把"
  },
  {
   "from": 279.42,
   "to": 281.35,
   "sid": 111,
   "location": 2,
   "content": "当我变成砰的一声"
  },
  {
   "from": 281.35,
   "to": 284.55,
   "sid": 112,
   "location": 2,
   "content": "我正在从右到左或从左到右进行交叉"
  },
  {
   "from": 284.55,
   "to": 287.54,
   "sid": 113,
   "location": 2,
   "content": "所以三个道岔交叉"
  },
  {
   "from": 319.1,
   "to": 321.54,
   "sid": 114,
   "location": 2,
   "content": "第四步是前拖"
  },
  {
   "from": 321.54,
   "to": 322.97,
   "sid": 115,
   "location": 2,
   "content": "所以任何设置移动"
  },
  {
   "from": 322.97,
   "to": 325.29,
   "sid": 116,
   "location": 2,
   "content": "我可以让我的防守者臀部开始转动"
  },
  {
   "from": 325.29,
   "to": 327.59,
   "sid": 117,
   "location": 2,
   "content": "但真的会是停止分离"
  },
  {
   "from": 327.59,
   "to": 328.27,
   "sid": 118,
   "location": 2,
   "content": "所以想象一下"
  },
  {
   "from": 328.27,
   "to": 329.43,
   "sid": 119,
   "location": 2,
   "content": "如果我向左行驶"
  },
  {
   "from": 329.43,
   "to": 330.55,
   "sid": 120,
   "location": 2,
   "content": "当我移动的时候"
  },
  {
   "from": 330.55,
   "to": 333.65,
   "sid": 121,
   "location": 2,
   "content": "我想超越到我左脚在这里的地方"
  },
  {
   "from": 333.65,
   "to": 336.28,
   "sid": 122,
   "location": 2,
   "content": "一旦我看到我的防守者的臀部开始移动"
  },
  {
   "from": 336.28,
   "to": 339.88,
   "sid": 123,
   "location": 2,
   "content": "这是当我有这个前拖非常紧我的身体"
  },
  {
   "from": 339.88,
   "to": 342.95,
   "sid": 124,
   "location": 2,
   "content": "我把球拉回来，要么我可以替换"
  },
  {
