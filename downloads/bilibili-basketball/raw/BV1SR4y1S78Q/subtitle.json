  {
   "from": 0.12,
   "to": 4.02,
   "sid": 1,
   "location": 2,
   "content": "如果在急停投篮撤步投篮时经常偏出不稳定",
   "music": 0
  },
  {
   "from": 4.02,
   "to": 6.68,
   "sid": 2,
   "location": 2,
   "content": "那一定是缺少了针对的稳定性训练",
   "music": 0
  },
  {
   "from": 6.68,
   "to": 9.98,
   "sid": 3,
   "location": 2,
   "content": "南哥给兄弟们分享一套嘎嘎具有针对性的训练",
   "music": 0
  },
  {
   "from": 9.98,
   "to": 11.7,
   "sid": 4,
   "location": 2,
   "content": "而且非常高效",
   "music": 0
  },
  {
   "from": 11.7,
   "to": 13.62,
   "sid": 5,
   "location": 2,
   "content": "第一个咱们单脚拍球",
   "music": 0
  },
  {
   "from": 13.62,
   "to": 15.75,
   "sid": 6,
   "location": 2,
   "content": "同时屈膝屈髋完成投篮",
   "music": 0
  },
  {
   "from": 15.75,
   "to": 17.98,
   "sid": 7,
   "location": 2,
   "content": "这个动作可以刺激核心发力",
   "music": 0
  },
  {
   "from": 17.98,
   "to": 19.72,
   "sid": 8,
   "location": 2,
   "content": "让你的力传导更稳定",
   "music": 0
  },
  {
   "from": 19.72,
   "to": 21.52,
   "sid": 9,
   "location": 2,
   "content": "接下来侧身做弓箭步",
   "music": 0
  },
  {
   "from": 21.52,
   "to": 22.6,
   "sid": 10,
   "location": 2,
   "content": "合球的时候",
   "music": 0
  },
  {
   "from": 22.6,
   "to": 23.47,
   "sid": 11,
   "location": 2,
   "content": "转向篮筐",
   "music": 0
  },
  {
   "from": 23.47,
   "to": 27.31,
   "sid": 12,
   "location": 2,
   "content": "可以提升我们在急停撤步中旋转的稳定性",
   "music": 0
  },
  {
   "from": 27.31,
   "to": 30.19,
   "sid": 13,
   "location": 2,
   "content": "第三咱们抛球倒退接球投篮",
   "music": 0
  },
  {
   "from": 30.19,
   "to": 33.9,
   "sid": 14,
   "location": 2,
   "content": "这个动作可以大幅度提升你后撤时投篮稳定性",
   "music": 0
  },
  {
   "from": 33.9,
   "to": 36.78,
   "sid": 15,
   "location": 2,
   "content": "最后我们做炸球侧灯投篮",
   "music": 0
  },
  {
   "from": 36.78,
   "to": 38.55,
   "sid": 16,
   "location": 2,
   "content": "可以提升侧面的稳定性",
   "music": 0
  },
  {
   "from": 38.55,
   "to": 41.04,
   "sid": 17,
   "location": 2,
   "content": "有了这套全面的投篮稳定性练习",
   "music": 0
  },
  {
   "from": 41.04,
   "to": 43.05,
   "sid": 18,
   "location": 2,
   "content": "你还愁自己的投篮不稳吗",
   "music": 0
