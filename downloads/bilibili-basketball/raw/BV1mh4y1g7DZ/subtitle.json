  },
  {
   "from": 94.34,
   "to": 95.9,
   "sid": 53,
   "location": 2,
   "content": "完成空心入框",
   "music": 0
  },
  {
   "from": 95.9,
   "to": 98.6,
   "sid": 54,
   "location": 2,
   "content": "好反复左右进十个球",
