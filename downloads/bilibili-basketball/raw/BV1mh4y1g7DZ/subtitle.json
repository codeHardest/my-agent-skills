 "body": [
  {
   "from": 0.12,
   "to": 2.64,
   "sid": 1,
   "location": 2,
   "content": "上一期视频我讲了如何提高你的投篮能力",
   "music": 0
  },
  {
   "from": 2.64,
   "to": 3.6,
   "sid": 2,
   "location": 2,
   "content": "在实战当中",
   "music": 0
  },
  {
   "from": 3.6,
   "to": 5.4,
   "sid": 3,
   "location": 2,
   "content": "那这一期有粉丝私信我",
   "music": 0
  },
  {
   "from": 5.4,
   "to": 6.48,
   "sid": 4,
   "location": 2,
   "content": "或者在底下留言",
   "music": 0
  },
  {
   "from": 6.48,
   "to": 9.06,
   "sid": 5,
   "location": 2,
   "content": "想听一下投篮姿势该如何调整",
   "music": 0
  },
  {
   "from": 9.06,
   "to": 12.08,
   "sid": 6,
   "location": 2,
   "content": "那么今天我就给大家详细讲解一下你的姿势",
   "music": 0
  },
  {
   "from": 12.08,
   "to": 12.98,
   "sid": 7,
   "location": 2,
   "content": "该如何去调整",
   "music": 0
  },
  {
   "from": 12.98,
   "to": 14.12,
   "sid": 8,
   "location": 2,
   "content": "关于投篮姿势问题",
   "music": 0
  },
  {
   "from": 14.12,
   "to": 14.78,
   "sid": 9,
   "location": 2,
   "content": "我们要注意",
   "music": 0
  },
  {
   "from": 14.78,
   "to": 16.13,
   "sid": 10,
   "location": 2,
   "content": "如果球要进框",
