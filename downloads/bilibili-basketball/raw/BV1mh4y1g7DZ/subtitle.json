  },
  {
   "from": 133.1,
   "to": 135.03,
   "sid": 70,
   "location": 2,
   "content": "脚尖正对着篮筐",
   "music": 0
  },
  {
   "from": 135.91,
   "to": 138.93,
   "sid": 71,
   "location": 2,
   "content": "再去完成空心入框好",
   "music": 0
  },
  {
   "from": 138.93,
   "to": 140.1,
   "sid": 72,
   "location": 2,
   "content": "如果没有空心",
   "music": 0
  },
  {
   "from": 140.1,
   "to": 142.74,
   "sid": 73,
   "location": 2,
   "content": "我们就尽量去完成空心入框",
   "music": 0
  },
  {
   "from": 142.74,
   "to": 146.04,
   "sid": 74,
   "location": 2,
   "content": "上步转好",
   "music": 0
  },
  {
   "from": 146.04,
   "to": 147.06,
   "sid": 75,
   "location": 2,
   "content": "关于方向调整",
   "music": 0
  },
  {
   "from": 147.06,
   "to": 147.86,
   "sid": 76,
   "location": 2,
   "content": "还有一个重点",
   "music": 0
  },
  {
   "from": 147.86,
   "to": 150.38,
   "sid": 77,
   "location": 2,
   "content": "之前我讲的是脚下的脚步该如何调整",
   "music": 0
  },
  {
   "from": 150.38,
   "to": 151.61,
   "sid": 78,
   "location": 2,
   "content": "你的宽该如何调整",
   "music": 0
  },
  {
   "from": 151.61,
   "to": 153.41,
   "sid": 79,
   "location": 2,
   "content": "接下来我要讲手腕的动作",
