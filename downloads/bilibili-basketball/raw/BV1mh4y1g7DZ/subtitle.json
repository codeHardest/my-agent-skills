  },
  {
   "from": 16.13,
   "to": 17.66,
   "sid": 11,
   "location": 2,
   "content": "首先是方向",
   "music": 0
  },
  {
   "from": 17.66,
   "to": 19.28,
   "sid": 12,
   "location": 2,
   "content": "你有了正确的方向",
   "music": 0
  },
  {
   "from": 19.28,
   "to": 22,
   "sid": 13,
   "location": 2,
   "content": "不偏不左不右还好进球",
   "music": 0
  },
  {
   "from": 22,
   "to": 23.5,
   "sid": 14,
   "location": 2,
   "content": "如果你方向都没对",
   "music": 0
  },
  {
   "from": 23.5,
   "to": 26.38,
   "sid": 15,
   "location": 2,
   "content": "你的力度就算完美也不会进框",
   "music": 0
  },
  {
   "from": 26.38,
   "to": 28.48,
   "sid": 16,
   "location": 2,
   "content": "所以关于方向的调整",
   "music": 0
  },
  {
   "from": 28.48,
   "to": 29.44,
   "sid": 17,
   "location": 2,
   "content": "我有几点要说",
   "music": 0
  },
  {
   "from": 29.44,
   "to": 30.94,
   "sid": 18,
   "location": 2,
   "content": "第一最好调整方向",
   "music": 0
  },
  {
   "from": 30.94,
   "to": 32.74,
   "sid": 19,
   "location": 2,
   "content": "控制方向的一些细节",
   "music": 0
  },
  {
   "from": 32.74,
   "to": 35.58,
   "sid": 20,
   "location": 2,
   "content": "是你的身体最好正对着篮筐",
   "music": 0
  },
  {
   "from": 35.58,
   "to": 37.26,
   "sid": 21,
   "location": 2,
   "content": "根据自己的关节活动度",
   "music": 0
  },
  {
   "from": 37.26,
   "to": 38.97,
   "sid": 22,
   "location": 2,
   "content": "跟自己的身体状况的不一样",
   "music": 0
  },
  {
   "from": 38.97,
   "to": 40.239,
   "sid": 23,
   "location": 2,
   "content": "会侧身一点",
   "music": 0
  },
  {
   "from": 40.239,
   "to": 41.199,
   "sid": 24,
   "location": 2,
   "content": "这个也不要紧",
   "music": 0
  },
  {
   "from": 41.199,
   "to": 42.579,
   "sid": 25,
   "location": 2,
   "content": "但是不要太侧了",
   "music": 0
  },
  {
   "from": 42.579,
   "to": 45.009,
   "sid": 26,
   "location": 2,
   "content": "太侧了会影响你的发力和方向",
   "music": 0
  },
  {
   "from": 45.009,
   "to": 48.73,
   "sid": 27,
   "location": 2,
   "content": "教练建议最好的是养成一个良好的习惯",
   "music": 0
  },
  {
   "from": 48.73,
   "to": 50.08,
   "sid": 28,
   "location": 2,
   "content": "在平时的训练当中",
   "music": 0
  },
  {
   "from": 50.08,
   "to": 52.66,
   "sid": 29,
   "location": 2,
   "content": "脚尖膝盖髋关节都正对着篮筐",
   "music": 0
  },
  {
   "from": 52.66,
   "to": 53.62,
   "sid": 30,
   "location": 2,
   "content": "如果你觉得不舒服",
   "music": 0
  },
  {
   "from": 53.62,
   "to": 54.58,
   "sid": 31,
   "location": 2,
   "content": "如果你觉得有点卡顿",
   "music": 0
  },
  {
   "from": 54.58,
   "to": 55.68,
   "sid": 32,
   "location": 2,
   "content": "你可以稍微偏一点",
   "music": 0
  },
  {
   "from": 55.68,
   "to": 58.56,
   "sid": 33,
   "location": 2,
   "content": "甚至喜欢一前脚后脚前脚后",
   "music": 0
  },
  {
   "from": 58.56,
   "to": 59.52,
   "sid": 34,
   "location": 2,
   "content": "这个也不要紧啊",
   "music": 0
  },
  {
   "from": 59.52,
   "to": 60.54,
   "sid": 35,
   "location": 2,
   "content": "这个也是非常正常",
   "music": 0
  },
  {
   "from": 60.54,
   "to": 61.32,
   "sid": 36,
   "location": 2,
   "content": "也是非常好的",
   "music": 0
  },
  {
   "from": 61.32,
   "to": 62.58,
   "sid": 37,
   "location": 2,
   "content": "右脚前左脚后",
   "music": 0
  },
  {
   "from": 62.58,
   "to": 63.6,
   "sid": 38,
   "location": 2,
   "content": "如果他是右手球员的话",
   "music": 0
  },
  {
   "from": 63.6,
   "to": 64.5,
   "sid": 39,
   "location": 2,
   "content": "如果是左手球员",
   "music": 0
  },
  {
   "from": 64.5,
   "to": 67.36,
   "sid": 40,
   "location": 2,
   "content": "可以左脚前右脚后这样去做投篮",
   "music": 0
  },
  {
   "from": 67.36,
   "to": 69.16,
   "sid": 41,
   "location": 2,
   "content": "那大的方向是不变的",
   "music": 0
  },
  {
   "from": 69.16,
   "to": 73.4,
   "sid": 42,
   "location": 2,
   "content": "脚尖膝盖和髋关节都正对着篮筐啊",
