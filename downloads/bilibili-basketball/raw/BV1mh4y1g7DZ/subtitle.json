  },
  {
   "from": 128.41,
   "to": 129.73,
   "sid": 67,
   "location": 2,
   "content": "所以我现在左手运球",
   "music": 0
  },
  {
   "from": 129.73,
   "to": 131.72,
   "sid": 68,
   "location": 2,
   "content": "然后上步去合球",
