  },
  {
   "from": 176.62,
   "to": 177.88,
   "sid": 92,
   "location": 2,
   "content": "不要歪的太明显",
   "music": 0
  },
  {
   "from": 177.88,
   "to": 178.48,
   "sid": 93,
   "location": 2,
   "content": "就很好",
   "music": 0
  },
  {
   "from": 178.48,
   "to": 179.74,
   "sid": 94,
   "location": 2,
   "content": "很多球员是这样去投篮",
   "music": 0
  },
  {
   "from": 179.74,
   "to": 182.5,
   "sid": 95,
   "location": 2,
   "content": "那你想你这么出手的方向能正吗",
