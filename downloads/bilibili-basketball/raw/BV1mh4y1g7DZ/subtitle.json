  },
  {
   "from": 167.159,
   "to": 168.479,
   "sid": 87,
   "location": 2,
   "content": "这一点大家一定要记住",
   "music": 0
  },
  {
   "from": 168.479,
   "to": 170.219,
   "sid": 88,
   "location": 2,
   "content": "那在这个的前提之下",
   "music": 0
  },
  {
   "from": 170.219,
   "to": 172.499,
   "sid": 89,
   "location": 2,
   "content": "我希望你在举球的时候",
   "music": 0
  },
  {
   "from": 172.499,
   "to": 175,
   "sid": 90,
   "location": 2,
   "content": "手肘我是要正对着篮筐啊",
