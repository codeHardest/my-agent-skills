   "location": 2,
   "content": "我现在可以右手运球",
   "music": 0
  },
  {
   "from": 76.4,
   "to": 80.98,
   "sid": 45,
   "location": 2,
   "content": "脚尖宽和我的胸膝盖都正对着篮筐",
   "music": 0
  },
  {
   "from": 80.98,
   "to": 82,
   "sid": 46,
   "location": 2,
   "content": "右手运球",
   "music": 0
  },
  {
   "from": 82,
   "to": 82.62,
   "sid": 47,
   "location": 2,
   "content": "第一步",
   "music": 0
  },
  {
   "from": 82.62,
   "to": 84.6,
   "sid": 48,
   "location": 2,
   "content": "我在合球的时候下蹲",
   "music": 0
  },
  {
   "from": 84.6,
   "to": 89.2,
   "sid": 49,
   "location": 2,
   "content": "然后举球的时候蹬地去完成空心入框",
   "music": 0
  },
  {
   "from": 90.22,
   "to": 91.87,
   "sid": 50,
   "location": 2,
   "content": "第二个我们开始左手运球",
