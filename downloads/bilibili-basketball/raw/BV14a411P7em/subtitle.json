   "sid": 1,
   "location": 2,
   "content": "如果你运气不好"
  },
  {
   "from": 1.2,
   "to": 3.18,
   "sid": 2,
   "location": 2,
   "content": "那你一定要学这个简单实用的延伸"
  },
  {
   "from": 3.18,
   "to": 6.29,
   "sid": 3,
   "location": 2,
   "content": "不过人南哥分享一套嘎嘎好用的训练方法"
  },
  {
   "from": 6.29,
   "to": 8.09,
   "sid": 4,
   "location": 2,
   "content": "让你轻松地安排在实战上"
  },
  {
   "from": 8.09,
   "to": 9.94,
   "sid": 5,
   "location": 2,
   "content": "let's go baby"
  },
  {
   "from": 10.559,
   "to": 12.559,
   "sid": 6,
   "location": 2,
   "content": "首先像我这样抛球拉球"
  },
  {
   "from": 12.559,
   "to": 14.179,
   "sid": 7,
   "location": 2,
   "content": "找到口袋运球的感觉"
  },
  {
   "from": 14.179,
   "to": 15.619,
   "sid": 8,
   "location": 2,
   "content": "等口袋运球熟练后"
  },
  {
   "from": 15.619,
   "to": 18.92,
   "sid": 9,
   "location": 2,
   "content": "我们拍球慢一侧角口袋的瞬间垫一小下"
  },
  {
   "from": 18.92,
   "to": 20.27,
   "sid": 10,
   "location": 2,
   "content": "再向前迈一大步"
  },
  {
   "from": 20.27,
   "to": 22.28,
   "sid": 11,
   "location": 2,
   "content": "利用大步子拉近防守"
  },
  {
   "from": 22.28,
   "to": 23.83,
   "sid": 12,
   "location": 2,
   "content": "发现与防守人持平"
  },
  {
   "from": 23.83,
   "to": 25.06,
   "sid": 13,
   "location": 2,
   "content": "直接加速过掉"
  },
  {
   "from": 25.06,
   "to": 27.06,
   "sid": 14,
   "location": 2,
   "content": "第二我们在蔓延伸布时"
  },
  {
   "from": 27.06,
   "to": 30.42,
   "sid": 15,
   "location": 2,
   "content": "发现防守人在我们身前马上做胯下攻击"
  },
  {
   "from": 30.42,
   "to": 31.65,
   "sid": 16,
   "location": 2,
   "content": "前脚加速突破"
  },
  {
   "from": 31.65,
   "to": 34.87,
   "sid": 17,
   "location": 2,
   "content": "训练时把延伸部加胯下做到顺畅"
  },
  {
   "from": 34.87,
   "to": 35.86,
   "sid": 18,
   "location": 2,
   "content": "不掉球即可"
  },
  {
   "from": 35.86,
   "to": 37.84,
   "sid": 19,
   "location": 2,
   "content": "第三我们做完延伸步后"
  },
  {
   "from": 37.84,
   "to": 41.11,
   "sid": 20,
   "location": 2,
   "content": "发现防守人后退也可以直接收后脚投篮"
  },
  {
   "from": 41.11,
   "to": 44.29,
   "sid": 21,
   "location": 2,
   "content": "训练时把延伸部手脚投篮练准即可"
  },
  {
   "from": 44.29,
   "to": 46.07,
   "sid": 22,
   "location": 2,
   "content": "第四有了上次投篮"
  },
  {
   "from": 46.07,
   "to": 48.89,
   "sid": 23,
   "location": 2,
   "content": "我们这次可以在收脚的瞬间去做拜佛"
  },
  {
   "from": 48.89,
   "to": 50.21,
   "sid": 24,
   "location": 2,
   "content": "发现防守人迟疑"
  },
  {
   "from": 50.21,
   "to": 51.71,
   "sid": 25,
   "location": 2,
   "content": "马上胯下加速突破"
  },
  {
   "from": 51.71,
   "to": 56.28,
   "sid": 26,
   "location": 2,
   "content": "训练时像我这样去找上角假合球加抬头的同步拍子"
  },
  {
   "from": 56.28,
   "to": 59.22,
   "sid": 27,
   "location": 2,
   "content": "第五我们做完延伸步也可以马上衔接"
  },
  {
   "from": 59.22,
   "to": 61.22,
   "sid": 28,
   "location": 2,
   "content": "变向是最简单的动作了"
  },
  {
   "from": 61.22,
   "to": 63.11,
   "sid": 29,
   "location": 2,
   "content": "训练时把变相练快即可"
  },
  {
   "from": 63.11,
   "to": 64.01,
   "sid": 30,
   "location": 2,
   "content": "你学废了吗"
  },
  {
   "from": 64.01,
   "to": 65.729,
   "sid": 31,
   "location": 2,
   "content": "抓紧简单收藏练起来吧"
  },
  {
