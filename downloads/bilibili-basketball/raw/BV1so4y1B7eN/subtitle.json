 "body": [
  {
   "from": 0.66,
   "to": 3.65,
   "sid": 1,
   "location": 2,
   "content": "今天给大家分享一下我的投篮出手点",
   "music": 0
  },
  {
   "from": 3.65,
   "to": 5.96,
   "sid": 2,
   "location": 2,
   "content": "一个适合自己的投篮出手点",
   "music": 0
  },
  {
   "from": 5.96,
   "to": 7.64,
   "sid": 3,
   "location": 2,
   "content": "会让自己的投篮更加的美观",
   "music": 0
  },
  {
   "from": 7.64,
   "to": 9.4,
   "sid": 4,
   "location": 2,
   "content": "并且发力更加轻松",
   "music": 0
  },
  {
   "from": 9.4,
   "to": 11.44,
   "sid": 5,
   "location": 2,
   "content": "甚至投三分也会更加轻松",
   "music": 0
  },
  {
   "from": 13.66,
   "to": 15.4,
   "sid": 6,
   "location": 2,
   "content": "人们常说的投篮出手点",
   "music": 0
  },
  {
   "from": 15.4,
   "to": 17.06,
   "sid": 7,
   "location": 2,
   "content": "不是投篮出手时候的位置",
   "music": 0
  },
  {
   "from": 17.06,
   "to": 18.74,
   "sid": 8,
   "location": 2,
   "content": "而是起始发力点",
   "music": 0
  },
  {
   "from": 18.74,
   "to": 20.57,
   "sid": 9,
   "location": 2,
   "content": "英文名管它叫swine",
   "music": 0
  },
  {
   "from": 20.57,
   "to": 23.3,
   "sid": 10,
   "location": 2,
   "content": "因为投篮是一个先向上后向前的过程",
   "music": 0
  },
  {
   "from": 23.3,
   "to": 26.24,
   "sid": 11,
   "location": 2,
   "content": "由上到前过渡的这个点就是投篮出手点",
   "music": 0
  },
  {
   "from": 26.24,
   "to": 28.52,
   "sid": 12,
   "location": 2,
   "content": "投篮出手点和臂展有很大的关系",
   "music": 0
  },
  {
   "from": 28.52,
   "to": 31.16,
   "sid": 13,
   "location": 2,
   "content": "所以我们不能随便模仿NBA球员的投篮",
   "music": 0
  },
  {
   "from": 31.16,
   "to": 32.75,
   "sid": 14,
   "location": 2,
   "content": "我的臂展只有170",
   "music": 0
  },
  {
   "from": 32.75,
   "to": 35.51,
   "sid": 15,
   "location": 2,
   "content": "所以我需要找到一个适合自己的投篮出手点",
   "music": 0
  },
  {
   "from": 35.51,
   "to": 37.46,
   "sid": 16,
   "location": 2,
   "content": "让我的投篮发力更加轻松",
   "music": 0
  },
  {
   "from": 37.46,
   "to": 39.62,
   "sid": 17,
   "location": 2,
   "content": "想要找到适合自己的投篮出手点",
   "music": 0
  },
  {
   "from": 39.62,
   "to": 40.97,
   "sid": 18,
   "location": 2,
   "content": "主要看三个地方",
   "music": 0
  },
  {
   "from": 40.97,
   "to": 42.23,
   "sid": 19,
   "location": 2,
   "content": "球的位置",
   "music": 0
  },
  {
   "from": 42.23,
   "to": 44.32,
   "sid": 20,
   "location": 2,
   "content": "肘的高度和手臂夹角",
   "music": 0
  },
  {
   "from": 44.56,
   "to": 46.78,
   "sid": 21,
   "location": 2,
   "content": "当我把球举过头顶",
   "music": 0.18367346001665982
  },
  {
   "from": 46.78,
   "to": 48.98,
   "sid": 22,
   "location": 2,
   "content": "那么我的肘的位置也会超过肩膀",
   "music": 0
  },
  {
   "from": 48.98,
   "to": 50.06,
   "sid": 23,
   "location": 2,
   "content": "而这样的出手点",
   "music": 0
  },
  {
   "from": 50.06,
   "to": 51.92,
   "sid": 24,
   "location": 2,
   "content": "我的大臂就无法参与投篮",
   "music": 0
  },
  {
   "from": 51.92,
   "to": 53.36,
   "sid": 25,
   "location": 2,
   "content": "近距离的话无所谓",
   "music": 0
  },
  {
   "from": 53.36,
   "to": 54.68,
   "sid": 26,
   "location": 2,
   "content": "但是一旦距离稍远",
   "music": 0
  },
  {
   "from": 54.68,
   "to": 55.94,
   "sid": 27,
   "location": 2,
   "content": "我就无法用上力气",
   "music": 0
  },
  {
   "from": 55.94,
   "to": 59.36,
   "sid": 28,
   "location": 2,
   "content": "我现在的出手点是将球放在我的额头高度",
   "music": 0
  },
  {
   "from": 59.36,
   "to": 62.33,
   "sid": 29,
   "location": 2,
   "content": "此时我的肘部也是比肩膀稍高",
   "music": 0
  },
  {
   "from": 62.33,
   "to": 64.58,
   "sid": 30,
   "location": 2,
   "content": "手臂夹角小于等于90度",
   "music": 0
  },
  {
   "from": 64.58,
   "to": 67.79,
   "sid": 31,
   "location": 2,
   "content": "这样的出手点可以充分利用的大臂和小臂",
   "music": 0
  },
  {
   "from": 67.79,
   "to": 69.62,
   "sid": 32,
   "location": 2,
   "content": "球的位置离额头越近",
   "music": 0
  },
  {
   "from": 69.62,
   "to": 71,
   "sid": 33,
   "location": 2,
   "content": "手臂夹角越小",
   "music": 0
  },
  {
   "from": 71,
   "to": 73.25,
   "sid": 34,
   "location": 2,
   "content": "就更能用上大臂的力量",
   "music": 0.10769230216962217
  },
  {
   "from": 73.25,
   "to": 75.14,
   "sid": 35,
   "location": 2,
   "content": "如果只关注肘的高度",
   "music": 0.09433961670820358
  },
  {
   "from": 75.14,
   "to": 76.52,
   "sid": 36,
   "location": 2,
   "content": "不关注球的位置",
   "music": 0
  },
  {
   "from": 76.52,
   "to": 78.08,
   "sid": 37,
   "location": 2,
   "content": "也会让你的投篮很别扭",
   "music": 0
  },
  {
   "from": 78.08,
   "to": 79.4,
   "sid": 38,
   "location": 2,
   "content": "在投远距离的时候",
   "music": 0
  },
  {
   "from": 79.4,
   "to": 81.56,
   "sid": 39,
   "location": 2,
   "content": "我会在肘的高度不变的情况下",
   "music": 0
  },
  {
   "from": 81.56,
   "to": 82.7,
   "sid": 40,
   "location": 2,
   "content": "压缩手臂夹角",
   "music": 0
  },
  {
   "from": 82.7,
   "to": 84.65,
   "sid": 41,
   "location": 2,
   "content": "将球的位置放在我眼前",
   "music": 0
  },
  {
   "from": 84.65,
   "to": 86.78,
   "sid": 42,
   "location": 2,
   "content": "让我的三分投得更加轻松",
   "music": 0
  },
  {
   "from": 86.78,
   "to": 89.66,
   "sid": 43,
   "location": 2,
   "content": "希望你也能找到适合自己的投篮出手点",
   "music": 0
  },
  {
   "from": 89.66,
   "to": 91.12,
   "sid": 44,
   "location": 2,
   "content": "感谢观看",
   "music": 0
  }
 ]
}