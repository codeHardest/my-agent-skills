 "body": [
  {
   "from": 0.14,
   "to": 3.08,
   "sid": 1,
   "location": 2,
   "content": "上个视频给兄弟们分享了40分钟的投篮计划",
   "music": 0
  },
  {
   "from": 3.08,
   "to": 5.3,
   "sid": 2,
   "location": 2,
   "content": "有兄弟反映说三分球投不到的问题",
   "music": 0
  },
  {
   "from": 5.3,
   "to": 7.7,
   "sid": 3,
   "location": 2,
   "content": "那今天给兄弟们分享五种投篮细节",
   "music": 0
  },
  {
   "from": 7.7,
   "to": 9.94,
   "sid": 4,
   "location": 2,
   "content": "以及两种能够训练投篮发力的方法",
   "music": 0
  },
  {
   "from": 9.94,
   "to": 11.44,
   "sid": 5,
   "location": 2,
   "content": "帮助你们改善投篮问题",
   "music": 0
  },
  {
   "from": 11.44,
   "to": 12.43,
   "sid": 6,
   "location": 2,
   "content": "首先第一个问题",
   "music": 0
  },
  {
   "from": 12.43,
   "to": 14.52,
   "sid": 7,
   "location": 2,
   "content": "也是大部分兄弟犯错误的主要原因",
   "music": 0
  },
  {
   "from": 14.52,
   "to": 17.34,
   "sid": 8,
   "location": 2,
   "content": "就是我们在起球的过程中去降重心",
   "music": 0
  },
  {
   "from": 17.34,
   "to": 19.56,
   "sid": 9,
   "location": 2,
   "content": "这是你发力不连贯的主要原因",
   "music": 0
  },
  {
   "from": 19.56,
   "to": 21.24,
   "sid": 10,
   "location": 2,
   "content": "因为我们在出手的过程中",
   "music": 0
  },
  {
   "from": 21.24,
   "to": 23.79,
   "sid": 11,
   "location": 2,
   "content": "如果我们的球已经举起来了",
   "music": 0
  },
  {
   "from": 23.79,
   "to": 25.74,
   "sid": 12,
   "location": 2,
   "content": "此时我们是重心向下的",
   "music": 0
  },
  {
   "from": 25.74,
   "to": 27.12,
   "sid": 13,
   "location": 2,
   "content": "那这个力是相互的",
   "music": 0
  },
  {
   "from": 27.12,
   "to": 27.62,
   "sid": 14,
   "location": 2,
   "content": "相反的",
   "music": 0
  },
  {
   "from": 27.62,
   "to": 28.67,
   "sid": 15,
   "location": 2,
   "content": "相互抵消的",
   "music": 0
  },
  {
   "from": 28.67,
   "to": 32.38,
   "sid": 16,
   "location": 2,
   "content": "所以这时候我们仍靠手臂的力量去往前去推球",
   "music": 0
  },
  {
   "from": 32.38,
   "to": 34.15,
   "sid": 17,
   "location": 2,
   "content": "那我们正确的做法是",
   "music": 0
  },
  {
   "from": 34.15,
   "to": 37,
   "sid": 18,
   "location": 2,
   "content": "球应该随着身体同时往上升",
   "music": 0
  },
  {
   "from": 37,
   "to": 39.28,
   "sid": 19,
   "location": 2,
   "content": "这时候我们能借用到腿的力量",
   "music": 0
  },
  {
   "from": 39.28,
   "to": 42.88,
   "sid": 20,
   "location": 2,
   "content": "同时也能借用到手臂向上的一个惯性的力量",
   "music": 0
  },
  {
   "from": 42.88,
   "to": 45.88,
   "sid": 21,
   "location": 2,
   "content": "两个力量相互在一起去完成投篮",
   "music": 0
  },
  {
   "from": 45.88,
   "to": 47.92,
   "sid": 22,
   "location": 2,
   "content": "这样会让我们投篮更轻松",
   "music": 0
  },
  {
   "from": 56.1,
   "to": 58.19,
   "sid": 23,
   "location": 2,
   "content": "第二个问题是关于全球的",
   "music": 0
  },
  {
   "from": 58.19,
   "to": 59.66,
   "sid": 24,
   "location": 2,
   "content": "我们在投远距离的过程中",
   "music": 0
  },
  {
   "from": 59.66,
   "to": 62,
   "sid": 25,
   "location": 2,
   "content": "我们可以适当将球的位置存在更低",
   "music": 0
  },
  {
   "from": 62,
   "to": 63.34,
   "sid": 26,
   "location": 2,
   "content": "这样我们的髋关节",
   "music": 0
  },
  {
   "from": 63.34,
   "to": 65.29,
   "sid": 27,
   "location": 2,
   "content": "还有我们膝关节参与发力的更多",
   "music": 0
  },
  {
   "from": 65.29,
   "to": 66.88,
   "sid": 28,
   "location": 2,
   "content": "这样我们的射程会更远",
   "music": 0
  },
  {
   "from": 66.88,
   "to": 67.78,
   "sid": 29,
   "location": 2,
   "content": "对比于篮下",
   "music": 0
  },
  {
   "from": 67.78,
   "to": 69.88,
   "sid": 30,
   "location": 2,
   "content": "我们可能将球放置在我们的胸口",
   "music": 0
  },
  {
   "from": 69.88,
   "to": 72.28,
   "sid": 31,
   "location": 2,
   "content": "或者说在我们的胸口稍微偏下一点",
   "music": 0
  },
  {
   "from": 72.28,
   "to": 73.78,
   "sid": 32,
   "location": 2,
   "content": "在这合球完成出手",
   "music": 0
  },
  {
   "from": 73.78,
   "to": 74.68,
   "sid": 33,
   "location": 2,
   "content": "那远距离的话",
   "music": 0
  },
  {
   "from": 74.68,
   "to": 76.03,
   "sid": 34,
   "location": 2,
   "content": "我们将球沉得更低",
   "music": 0
  },
  {
   "from": 76.03,
   "to": 77.2,
   "sid": 35,
   "location": 2,
   "content": "这时候我们的髋部",
   "music": 0
  },
  {
   "from": 77.2,
   "to": 79.36,
   "sid": 36,
   "location": 2,
   "content": "我们的膝关节都会下沉的更低",
   "music": 0
  },
  {
   "from": 79.36,
   "to": 80.62,
   "sid": 37,
   "location": 2,
   "content": "这样我们在起球过程中",
   "music": 0
  },
  {
   "from": 80.62,
   "to": 81.98,
   "sid": 38,
   "location": 2,
   "content": "我们的序列也更久",
   "music": 0
  },
  {
   "from": 81.98,
   "to": 84.98,
   "sid": 39,
   "location": 2,
   "content": "这样会让我们投射的距离更远",
   "music": 0.10679611132057645
  },
  {
   "from": 86.44,
   "to": 88.36,
   "sid": 40,
   "location": 2,
   "content": "就一条路如此",
   "music": 0
  },
  {
   "from": 89.5,
   "to": 92.14,
   "sid": 41,
   "location": 2,
   "content": "而且我逃掉了",
   "music": 0
  },
  {
   "from": 92.14,
   "to": 93.22,
   "sid": 42,
   "location": 2,
   "content": "第三个问题",
   "music": 0
  },
  {
   "from": 93.22,
   "to": 94.84,
   "sid": 43,
   "location": 2,
   "content": "关于我们手臂夹角问题",
   "music": 0
  },
  {
   "from": 94.84,
   "to": 95.98,
   "sid": 44,
   "location": 2,
   "content": "我们在起球时",
   "music": 0
  },
  {
   "from": 95.98,
   "to": 97.98,
   "sid": 45,
   "location": 2,
   "content": "球是顺着我们的身体起球",
   "music": 0
  },
  {
   "from": 97.98,
   "to": 100.08,
   "sid": 46,
   "location": 2,
   "content": "切记不要远离身体起球",
   "music": 0
  },
  {
   "from": 100.08,
   "to": 101.43,
   "sid": 47,
   "location": 2,
   "content": "这样起球是错误的",
   "music": 0
  },
  {
   "from": 101.43,
   "to": 103.02,
   "sid": 48,
   "location": 2,
   "content": "我们要顺着身体起球",
   "music": 0
  },
  {
   "from": 103.02,
   "to": 104.34,
   "sid": 49,
   "location": 2,
   "content": "同时收小臂",
   "music": 0
  },
  {
   "from": 104.34,
   "to": 106.32,
   "sid": 50,
   "location": 2,
   "content": "我们小臂的夹角越小",
   "music": 0
  },
  {
   "from": 106.32,
   "to": 108.82,
   "sid": 51,
   "location": 2,
   "content": "对于我们向外拨的力量就会越大",
   "music": 0
  },
  {
   "from": 108.82,
   "to": 110.59,
   "sid": 52,
   "location": 2,
   "content": "如果我们手臂是90度",
   "music": 0
  },
  {
   "from": 110.59,
   "to": 112.66,
   "sid": 53,
   "location": 2,
   "content": "那我们从90度向外拨球",
   "music": 0
  },
  {
   "from": 112.66,
   "to": 114.7,
   "sid": 54,
   "location": 2,
   "content": "只能从这个位置开始往前拨",
   "music": 0
  },
  {
   "from": 114.7,
   "to": 116.74,
   "sid": 55,
   "location": 2,
   "content": "那如果我们的角度收球",
   "music": 0
  },
  {
   "from": 116.74,
   "to": 117.97,
   "sid": 56,
   "location": 2,
   "content": "起球角度越小",
   "music": 0
  },
  {
   "from": 117.97,
   "to": 121.52,
   "sid": 57,
   "location": 2,
   "content": "那这个过程中我们向外展开发出的力就越大",
   "music": 0
  },
  {
   "from": 121.52,
   "to": 123.44,
   "sid": 58,
   "location": 2,
   "content": "所以我们在投远距离的过程中",
   "music": 0
  },
  {
   "from": 123.44,
   "to": 125.24,
   "sid": 59,
   "location": 2,
   "content": "我建议大家起球过程中",
   "music": 0
  },
  {
   "from": 125.24,
   "to": 127.83,
   "sid": 60,
   "location": 2,
   "content": "将小臂的夹角相应地放小",
   "music": 0
  },
  {
   "from": 127.83,
   "to": 130.47,
   "sid": 61,
   "location": 2,
   "content": "这时候再完成投篮",
   "music": 0
  },
  {
   "from": 130.47,
   "to": 132.42,
   "sid": 62,
   "location": 2,
   "content": "向外拨球",
   "music": 0
  },
  {
   "from": 140.74,
   "to": 142.8,
   "sid": 63,
   "location": 2,
   "content": "第四个问题关于屈髋的问题",
   "music": 0
  },
  {
   "from": 142.8,
   "to": 145.42,
   "sid": 64,
   "location": 2,
   "content": "大部分兄弟在投篮时没有充分的去屈髋",
   "music": 0
  },
  {
   "from": 145.42,
   "to": 147.67,
   "sid": 65,
   "location": 2,
   "content": "屈髋对于我们投篮帮助是非常大的",
   "music": 0
  },
  {
   "from": 147.67,
   "to": 148.36,
   "sid": 66,
   "location": 2,
   "content": "举一个例子",
   "music": 0
  },
  {
   "from": 148.36,
   "to": 149.8,
   "sid": 67,
   "location": 2,
   "content": "很多兄弟们在投篮时",
   "music": 0
  },
  {
   "from": 149.8,
   "to": 151.58,
   "sid": 68,
   "location": 2,
   "content": "他的膝盖过于超前了",
   "music": 0
  },
  {
   "from": 151.58,
   "to": 153.56,
   "sid": 69,
   "location": 2,
   "content": "而他的上半身过于挺直",
   "music": 0
  },
  {
   "from": 153.56,
   "to": 156.26,
   "sid": 70,
   "location": 2,
   "content": "那这时候他就没有完成一个充分的屈髋",
   "music": 0
  },
  {
   "from": 156.26,
   "to": 157.04,
   "sid": 71,
   "location": 2,
   "content": "他在投篮时",
   "music": 0
  },
  {
   "from": 157.04,
   "to": 160.57,
   "sid": 72,
   "location": 2,
   "content": "大拇指力量是来源来源于他的腿给他的力量",
   "music": 0
  },
  {
   "from": 160.57,
   "to": 163.12,
   "sid": 73,
   "location": 2,
   "content": "所以他没有利用到髋部伸展的这个力量",
   "music": 0
  },
  {
   "from": 163.12,
   "to": 164.38,
   "sid": 74,
   "location": 2,
   "content": "没有用到髋部的力量",
   "music": 0
  },
  {
   "from": 164.38,
   "to": 167.44,
   "sid": 75,
   "location": 2,
   "content": "那我们正确的做法是先将我们的腿站直",
   "music": 0
  },
  {
   "from": 167.44,
   "to": 168.64,
   "sid": 76,
   "location": 2,
   "content": "屁股向后",
   "music": 0
  },
  {
   "from": 168.64,
   "to": 169.63,
   "sid": 77,
   "location": 2,
   "content": "身体朝前",
   "music": 0
  },
  {
   "from": 169.63,
   "to": 170.32,
   "sid": 78,
   "location": 2,
   "content": "腰背挺直",
   "music": 0
  },
  {
   "from": 170.32,
   "to": 172.34,
   "sid": 79,
   "location": 2,
   "content": "注意这时候我们再完成一个屈膝",
   "music": 0
  },
  {
   "from": 172.34,
   "to": 174.56,
   "sid": 80,
   "location": 2,
   "content": "这样我们就有了一个屈膝屈髋",
   "music": 0
  },
  {
   "from": 174.56,
   "to": 175.64,
   "sid": 81,
   "location": 2,
   "content": "那我们在投篮时呢",
   "music": 0
  },
  {
   "from": 175.64,
   "to": 177.35,
   "sid": 82,
   "location": 2,
   "content": "我们的髋部伸展",
   "music": 0
  },
  {
   "from": 177.35,
   "to": 179.03,
   "sid": 83,
   "location": 2,
   "content": "同时利用脚尖蹬地",
   "music": 0
  },
  {
   "from": 179.03,
   "to": 181.34,
   "sid": 84,
   "location": 2,
   "content": "这样我们两个力量去协调发力",
   "music": 0
  },
  {
   "from": 181.34,
   "to": 185.92,
   "sid": 85,
   "location": 2,
   "content": "同时将球向上完成出手",
   "music": 0
  },
  {
   "from": 193.08,
   "to": 195.09,
   "sid": 86,
   "location": 2,
   "content": "第五个问题",
   "music": 0
  },
  {
   "from": 195.09,
   "to": 195.96,
   "sid": 87,
   "location": 2,
   "content": "在我们投篮时",
   "music": 0
  },
  {
   "from": 195.96,
   "to": 197.94,
   "sid": 88,
   "location": 2,
   "content": "我们要学会利用前脚掌去发力",
   "music": 0
  },
