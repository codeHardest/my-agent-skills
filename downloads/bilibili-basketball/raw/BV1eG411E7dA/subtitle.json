   "from": 197.94,
   "to": 199.92,
   "sid": 89,
   "location": 2,
   "content": "也就是用我们的脚尖蹬地",
   "music": 0
  },
  {
   "from": 199.92,
   "to": 201.36,
   "sid": 90,
   "location": 2,
   "content": "我们在做投篮过程中",
   "music": 0
  },
  {
   "from": 201.36,
   "to": 203.82,
   "sid": 91,
   "location": 2,
   "content": "如果我们是用整个脚面去蹬地的话",
