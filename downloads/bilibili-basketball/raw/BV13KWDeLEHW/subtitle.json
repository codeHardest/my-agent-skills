 "body": [
  {
   "from": 0.38,
   "to": 2.36,
   "sid": 1,
   "location": 2,
   "content": "侧腕是现代投篮的主流方式",
   "music": 0
  },
  {
   "from": 2.36,
   "to": 2.9,
   "sid": 2,
   "location": 2,
   "content": "起球快",
   "music": 0
  },
  {
   "from": 2.9,
   "to": 3.6,
   "sid": 3,
   "location": 2,
   "content": "出手顺",
   "music": 0
  },
  {
   "from": 3.6,
   "to": 6.2,
   "sid": 4,
   "location": 2,
   "content": "但很多人始终找不到转弯回正的感觉",
   "music": 0
  },
  {
   "from": 6.2,
   "to": 7.99,
   "sid": 5,
   "location": 2,
   "content": "导致投出去忽左忽右",
   "music": 0
  },
  {
   "from": 7.99,
   "to": 10.23,
   "sid": 6,
   "location": 2,
   "content": "今天分享一个小技巧",
   "music": 0
  },
  {
   "from": 12.12,
   "to": 14.48,
   "sid": 7,
   "location": 2,
   "content": "转弯就是将小臂旋前",
   "music": 0
  },
  {
   "from": 14.48,
   "to": 16.46,
   "sid": 8,
   "location": 2,
   "content": "也就是向外旋转",
   "music": 0
  },
  {
   "from": 16.46,
   "to": 19.28,
   "sid": 9,
   "location": 2,
   "content": "这样才能把手腕对准框",
   "music": 0
  },
  {
   "from": 19.28,
   "to": 20.28,
   "sid": 10,
   "location": 2,
   "content": "用虎口",
   "music": 0
  },
  {
   "from": 20.28,
   "to": 20.86,
   "sid": 11,
   "location": 2,
   "content": "大拇指",
   "music": 0
  },
  {
   "from": 20.86,
   "to": 22.76,
   "sid": 12,
   "location": 2,
   "content": "食指是转腕的灵魂",
   "music": 0
  },
  {
   "from": 22.76,
   "to": 24.64,
   "sid": 13,
   "location": 2,
   "content": "而无名指天生内旋",
   "music": 0
  },
  {
   "from": 24.64,
   "to": 26.9,
   "sid": 14,
   "location": 2,
   "content": "中指又和无名指共用一根肌腱",
   "music": 0
  },
  {
   "from": 26.9,
   "to": 28.22,
   "sid": 15,
   "location": 2,
   "content": "如果过度用力",
   "music": 0
  },
  {
   "from": 28.22,
   "to": 31.06,
   "sid": 16,
   "location": 2,
   "content": "反而会导致手臂内旋回去",
   "music": 0
  },
  {
   "from": 31.06,
   "to": 34.379,
   "sid": 17,
   "location": 2,
   "content": "这也是很多人投篮手会内撇的原因",
   "music": 0
  },
  {
   "from": 34.379,
   "to": 36.779,
   "sid": 18,
   "location": 2,
   "content": "所以手指只要放松地贴在球上",
   "music": 0
  },
  {
   "from": 36.779,
   "to": 38.259,
   "sid": 19,
   "location": 2,
   "content": "注意力集中在这部分",
   "music": 0
  },
  {
   "from": 38.259,
   "to": 39.259,
   "sid": 20,
   "location": 2,
   "content": "瞄准发力",
   "music": 0
  },
  {
   "from": 39.259,
   "to": 41.3,
   "sid": 21,
   "location": 2,
   "content": "带动其余手指下压",
   "music": 0
  },
  {
   "from": 41.3,
   "to": 43.22,
   "sid": 22,
   "location": 2,
   "content": "你的投篮一定会特别准",
   "music": 0
  },
  {
   "from": 43.22,
   "to": 44.5,
   "sid": 23,
   "location": 2,
   "content": "再结合下肢发力",
   "music": 0
  },
  {
   "from": 44.5,
   "to": 46.36,
   "sid": 24,
   "location": 2,
   "content": "还会出现强烈的抖腕效果",
   "music": 0
  },
  {
   "from": 46.36,
   "to": 47.26,
   "sid": 25,
   "location": 2,
   "content": "还等什么",
   "music": 0
  },
  {
   "from": 47.26,
   "to": 48.48,
   "sid": 26,
   "location": 2,
   "content": "赶紧练起来吧",
   "music": 0
  }
 ]
}