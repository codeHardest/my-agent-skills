 "body": [
  {
   "from": 3.64,
   "to": 6.1,
   "sid": 1,
   "location": 2,
   "content": "今天给兄弟们分享两种胯下的发力模式"
  },
  {
   "from": 6.1,
   "to": 7.9,
   "sid": 2,
   "location": 2,
   "content": "能够帮助你一步过掉你的防守人"
  },
  {
   "from": 7.9,
   "to": 10.75,
   "sid": 3,
   "location": 2,
   "content": "那首先第一种利用我们的内测角进行一个发力"
  },
  {
   "from": 10.75,
   "to": 13.55,
   "sid": 4,
   "location": 2,
   "content": "我们在面对防守时做一次上部的胯下"
  },
  {
   "from": 13.55,
   "to": 15.35,
   "sid": 5,
   "location": 2,
   "content": "注意桥接到手的一瞬间"
  },
  {
   "from": 15.35,
   "to": 17.91,
   "sid": 6,
   "location": 2,
   "content": "我们立刻进行内侧角的向外延伸"
  },
  {
   "from": 17.91,
   "to": 20.4,
   "sid": 7,
   "location": 2,
   "content": "延伸过程中呢立刻去登记"
  },
  {
   "from": 20.4,
   "to": 21.51,
   "sid": 8,
   "location": 2,
   "content": "登记一瞬间"
  },
  {
   "from": 21.51,
   "to": 24,
   "sid": 9,
   "location": 2,
   "content": "利用辅助手摆臂加速进行一个交叉"
  },
  {
   "from": 24,
   "to": 25.21,
   "sid": 10,
   "location": 2,
   "content": "去完成一个突破"
  },
  {
   "from": 25.21,
   "to": 26.11,
   "sid": 11,
   "location": 2,
   "content": "在这个过程中呢"
  },
  {
   "from": 26.11,
   "to": 29.25,
   "sid": 12,
   "location": 2,
   "content": "我们相当于做了两次的蓄力一二"
  },
  {
   "from": 29.25,
   "to": 30.9,
   "sid": 13,
   "location": 2,
   "content": "这一下一定要画上力量"
  },
  {
   "from": 30.9,
   "to": 31.29,
   "sid": 14,
   "location": 2,
   "content": "来"
  },
  {
   "from": 31.29,
   "to": 32.28,
   "sid": 15,
   "location": 2,
   "content": "我们看一下这个动作"
  },
  {
   "from": 32.28,
   "to": 33.18,
   "sid": 16,
   "location": 2,
   "content": "完整动作"
  },
  {
   "from": 33.18,
   "to": 34.379,
   "sid": 17,
   "location": 2,
   "content": "上步"
  },
  {
   "from": 40.86,
   "to": 44.09,
   "sid": 18,
   "location": 2,
   "content": "第二种就是利用我们的外侧脚胯下进行一个提速"
  },
  {
   "from": 44.09,
   "to": 45.53,
   "sid": 19,
   "location": 2,
   "content": "当我们接近防守人时"
  },
  {
   "from": 45.53,
   "to": 47.6,
   "sid": 20,
   "location": 2,
   "content": "上步胯下对这次胯下"
  },
  {
   "from": 47.6,
   "to": 50.51,
   "sid": 21,
   "location": 2,
   "content": "我们用脚后跟点地球到手的瞬间"
  },
  {
   "from": 50.51,
   "to": 52.13,
   "sid": 22,
   "location": 2,
   "content": "将前脚向后钩挖破"
  },
  {
   "from": 52.13,
   "to": 55.09,
   "sid": 23,
   "location": 2,
   "content": "同时辅助手摆臂加速去交叉"
  },
  {
   "from": 55.09,
   "to": 57.04,
   "sid": 24,
   "location": 2,
   "content": "然后我们再慢一点看这个动作"
  },
  {
   "from": 57.04,
   "to": 59.52,
   "sid": 25,
   "location": 2,
   "content": "上步胯下拉住"
  },
  {
   "from": 59.52,
   "to": 61.98,
   "sid": 26,
   "location": 2,
   "content": "然后辅助手摆臂交叉"
  },
  {
   "from": 61.98,
   "to": 64.02,
   "sid": 27,
   "location": 2,
   "content": "然后我们连贯一点看这个动作"
  },
  {
   "from": 64.02,
   "to": 65.98,
   "sid": 28,
   "location": 2,
   "content": "面对防守人时"
  }
 ]
