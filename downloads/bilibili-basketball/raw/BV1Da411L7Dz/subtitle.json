 "version": "sync-en-v1.2.0.4-t0.2.c",
 "body": [
  {
   "from": 16.299,
   "to": 17.659,
   "sid": 1,
   "location": 2,
   "content": "在他的前三场比赛中"
  },
  {
   "from": 17.659,
   "to": 20.96,
   "sid": 2,
   "location": 2,
   "content": "雷洛·布拉德完蛋了"
  },
  {
   "from": 20.96,
   "to": 22.92,
   "sid": 3,
   "location": 2,
   "content": "就像他的球员一样"
  },
  {
   "from": 29.84,
   "to": 35.54,
   "sid": 4,
   "location": 2,
   "content": "在荣誉所在的超大约翰尼城 关羽到了一个"
  },
  {
   "from": 35.54,
   "to": 39.36,
   "sid": 5,
   "location": 2,
   "content": "我很确定每个人都能成为更好的射手"
  },
  {
   "from": 39.36,
   "to": 43.81,
   "sid": 6,
   "location": 2,
   "content": "因为这取决于细节和你对它们的关注"
  },
  {
   "from": 43.81,
   "to": 45.61,
   "sid": 7,
   "location": 2,
   "content": "把这个视频看到最后"
  },
  {
   "from": 45.61,
   "to": 52.06,
   "sid": 8,
   "location": 2,
   "content": "因为最后我会告诉你一个最重要的事情 关于那个帮助了我的镜头"
  },
  {
   "from": 67.98,
   "to": 72.11,
   "sid": 9,
   "location": 2,
   "content": "所以首先我想说的是 我们都是不同的"
  },
  {
   "from": 72.11,
   "to": 73.39,
   "sid": 10,
   "location": 2,
   "content": "我们的身体不一样"
  },
  {
   "from": 73.39,
   "to": 74.35,
   "sid": 11,
   "location": 2,
   "content": "我们的手不一样"
  },
  {
   "from": 74.35,
   "to": 75.51,
   "sid": 12,
   "location": 2,
   "content": "我们的腿不一样"
  },
  {
   "from": 75.51,
   "to": 84.38,
   "sid": 13,
   "location": 2,
   "content": "所以我今天要向你们展示的这些细节 在不同的人表演时 它们会看起来不同"
  },
  {
   "from": 84.38,
   "to": 87.08,
   "sid": 14,
   "location": 2,
   "content": "只是因为我们不同"
  },
  {
   "from": 87.08,
   "to": 93.08,
   "sid": 15,
   "location": 2,
   "content": "但动作的模式和你需要遵循的细节都是一样的"
  },
  {
   "from": 94.77,
   "to": 102.79,
   "sid": 16,
   "location": 2,
   "content": "最后的投篮会给你更稳定和平衡的位置，在投篮之前"
  },
  {
   "from": 102.79,
   "to": 107.96,
   "sid": 17,
   "location": 2,
   "content": "一个是如此的奥皮亚靠近哟哟印第安人，一个转弯你去"
  },
  {
   "from": 107.96,
   "to": 110.22,
   "sid": 18,
   "location": 2,
   "content": "如果你需要道场"
  },
  {
   "from": 110.22,
   "to": 111.86,
   "sid": 19,
   "location": 2,
   "content": "你的印第安人和一个"
  },
  {
   "from": 111.86,
   "to": 115.5,
   "sid": 20,
   "location": 2,
   "content": "一只脚在另一只脚前面会形成一条线"
  },
  {
   "from": 117.04,
   "to": 118.72,
   "sid": 21,
   "location": 2,
   "content": "拍摄形式"
  },
  {
   "from": 118.72,
   "to": 128.539,
   "sid": 22,
   "location": 2,
   "content": "所以从脚到手 你会创造一个完美的挖掘 看我去鞠躬 约翰逊死了"
  },
  {
   "from": 129.699,
   "to": 131.84,
   "sid": 23,
   "location": 2,
   "content": "是什么让你的男人想要你"
  },
  {
   "from": 133.54,
   "to": 137.64,
   "sid": 24,
   "location": 2,
   "content": "这将有助于我们在拍摄中让腿部工作"
  },
  {
   "from": 137.64,
   "to": 143.299,
   "sid": 25,
   "location": 2,
   "content": "我们的体重从食物转移到了山上 而不是山上"
  },
  {
   "from": 143.299,
   "to": 145.89,
   "sid": 26,
   "location": 2,
   "content": "如果我们把体重保持在山上"
  },
  {
   "from": 145.89,
   "to": 148.55,
   "sid": 27,
   "location": 2,
   "content": "我们的身体会过度平衡"
  },
  {
   "from": 148.55,
   "to": 151.5,
   "sid": 28,
   "location": 2,
   "content": "把你的体重移到前面"
  },
  {
   "from": 151.799,
   "to": 154.759,
   "sid": 29,
   "location": 2,
   "content": "你想等你的腿来工作"
  },
  {
   "from": 154.759,
   "to": 158.54,
   "sid": 30,
   "location": 2,
   "content": "你看到球上的手的位置"
  },
  {
   "from": 158.739,
   "to": 162.94,
   "sid": 31,
   "location": 2,
   "content": "投篮手就在球中间"
  },
  {
   "from": 162.94,
   "to": 163.8,
   "sid": 32,
   "location": 2,
   "content": "不在这里"
  },
  {
   "from": 163.8,
   "to": 164.88,
   "sid": 33,
   "location": 2,
   "content": "不在这里"
  },
  {
   "from": 164.88,
   "to": 167.1,
   "sid": 34,
   "location": 2,
   "content": "不是在这中间"
  },
  {
   "from": 167.1,
   "to": 173.039,
   "sid": 35,
   "location": 2,
   "content": "伸出你的手指，把第二只手放在球的侧面"
  },
  {
   "from": 173.039,
   "to": 179.46,
   "sid": 36,
   "location": 2,
   "content": "它会让你平稳地移动 引导手球击球"
  },
  {
   "from": 179.46,
   "to": 183.28,
   "sid": 37,
   "location": 2,
   "content": "如果你的手在上面的后面"
  },
  {
   "from": 183.28,
   "to": 185.06,
   "sid": 38,
   "location": 2,
   "content": "会影响投篮"
  },
  {
   "from": 185.06,
   "to": 186.96,
   "sid": 39,
   "location": 2,
   "content": "不知何故，你看得更容易"
  },
  {
   "from": 186.96,
   "to": 188.36,
   "sid": 40,
   "location": 2,
   "content": "我全速前进"
  },
  {
   "from": 188.36,
   "to": 191.1,
   "sid": 41,
   "location": 2,
   "content": "把球放在胸下一点"
  },
  {
   "from": 193.199,
   "to": 197.299,
   "sid": 42,
   "location": 2,
   "content": "它会自动在你的肘部设计90度"
  },
  {
   "from": 197.299,
   "to": 198.079,
   "sid": 43,
   "location": 2,
   "content": "就在这里"
  },
  {
   "from": 198.079,
   "to": 199.7,
   "sid": 44,
   "location": 2,
   "content": "不要把球放得太低"
  },
  {
   "from": 199.7,
   "to": 201.18,
   "sid": 45,
   "location": 2,
   "content": "不要把球放得太高"
  },
  {
   "from": 201.18,
   "to": 205.92,
   "sid": 46,
   "location": 2,
   "content": "从这里你将有完美的球举起传球"
  },
  {
   "from": 214.8,
   "to": 219.279,
   "sid": 47,
   "location": 2,
   "content": "把球放在离身体不远的地方"
  },
  {
   "from": 219.279,
   "to": 220.459,
   "sid": 48,
   "location": 2,
   "content": "这么大的错误"
  },
  {
   "from": 220.459,
   "to": 223.919,
   "sid": 49,
   "location": 2,
   "content": "当球员们把球举得离身体很远的时候"
  },
  {
   "from": 223.919,
   "to": 230.04,
   "sid": 50,
   "location": 2,
   "content": "从胸部以下开始，让球靠近身体"
  },
  {
   "from": 230.04,
   "to": 235.24,
   "sid": 51,
   "location": 2,
   "content": "它会给你一个平稳的传球来释放球"
  },
  {
   "from": 235.24,
   "to": 239,
   "sid": 52,
   "location": 2,
   "content": "球不会改变移动的方向 那么大"
  },
  {
   "from": 239.419,
   "to": 241.719,
   "sid": 53,
   "location": 2,
   "content": "这意味着你将控制球"
  },
  {
   "from": 241.719,
   "to": 243.9,
   "sid": 54,
   "location": 2,
   "content": "更多的控制过去"
  },
  {
   "from": 247.76,
   "to": 248.6,
   "sid": 55,
   "location": 2,
   "content": "起重点"
  },
  {
   "from": 248.6,
   "to": 251,
   "sid": 56,
   "location": 2,
   "content": "低于两米的球员"
  },
  {
   "from": 251,
   "to": 256.649,
   "sid": 57,
   "location": 2,
   "content": "我想说，提举点必须是关于眉毛线或发际线"
  },
  {
   "from": 256.649,
   "to": 259.289,
   "sid": 58,
   "location": 2,
   "content": "身高超过两米的球员"
  },
  {
   "from": 259.289,
   "to": 263.65,
   "sid": 59,
   "location": 2,
   "content": "他们可以把球留在比头部高一点的地方"
  },
  {
   "from": 263.65,
   "to": 273.22,
   "sid": 60,
   "location": 2,
   "content": "眉毛线和发际线的抬起点会让你更快一点，肘部伸展的范围也会更长一点"
  },
  {
   "from": 273.22,
   "to": 278.15,
   "sid": 61,
   "location": 2,
   "content": "它也会给你带来一点雨水"
  },
  {
   "from": 278.15,
   "to": 281.83,
   "sid": 62,
   "location": 2,
   "content": "所以周圍申張就從這兒來了"
  },
  {
   "from": 281.83,
   "to": 282.87,
   "sid": 63,
   "location": 2,
   "content": "当球在这里的时候"
  },
  {
   "from": 282.87,
   "to": 285.3,
   "sid": 64,
   "location": 2,
   "content": "我们的手肘伸得很快"
  },
  {
   "from": 291.7,
   "to": 297.61,
   "sid": 65,
   "location": 2,
   "content": "但直球也会扩大你的射程，并帮助你给球正确的方向"
  },
  {
   "from": 297.61,
   "to": 299.33,
   "sid": 66,
   "location": 2,
   "content": "在释放的瞬间"
  },
  {
   "from": 299.33,
   "to": 301.97,
   "sid": 67,
   "location": 2,
   "content": "把你的手腕和肘部合拢"
  },
  {
   "from": 301.97,
   "to": 305.15,
   "sid": 68,
   "location": 2,
   "content": "我们得到了一个球的大致方向"
  },
  {
   "from": 305.15,
   "to": 309.38,
   "sid": 69,
   "location": 2,
   "content": "但通过手腕我们可以调整细节"
  },
  {
   "from": 309.38,
   "to": 311.5,
   "sid": 70,
   "location": 2,
   "content": "像小球的方向"
  },
  {
   "from": 311.5,
   "to": 320.57,
   "sid": 71,
   "location": 2,
   "content": "在投篮结束的时候，乔·C用中指和指尖将球投进篮筐"
  },
  {
   "from": 320.57,
   "to": 322.61,
   "sid": 72,
   "location": 2,
   "content": "所以当我们伸展肘部的时候"
  },
  {
   "from": 322.61,
   "to": 324.9,
   "sid": 73,
   "location": 2,
   "content": "当我们合上手腕的时候"
  },
  {
   "from": 324.9,
   "to": 334.55,
   "sid": 74,
   "location": 2,
   "content": "最后的触球必须用食指和中指，篮内的点必须用食指"
  },
  {
   "from": 334.55,
   "to": 338.92,
   "sid": 75,
   "location": 2,
   "content": "这就是球的准确方向"
  },
  {
   "from": 338.92,
   "to": 342.98,
   "sid": 76,
   "location": 2,
   "content": "你看更容易通过展示一个完整的女人"
  },
  {
   "from": 342.98,
   "to": 345.5,
   "sid": 77,
   "location": 2,
   "content": "她谈到了节目中的那个女人"
  },
  {
   "from": 347.799,
   "to": 349.62,
   "sid": 78,
   "location": 2,
   "content": "所以周派人"
  },
  {
   "from": 357.4,
   "to": 365.98,
   "sid": 79,
   "location": 2,
   "content": "手掌这个也会给你更多的控制镜头 你可以看到移动的顺序"
  },
  {
   "from": 365.98,
   "to": 367.86,
   "sid": 80,
   "location": 2,
   "content": "所以我们刚刚了解了很多细节"
  },
  {
   "from": 367.86,
   "to": 370.94,
   "sid": 81,
   "location": 2,
   "content": "现在我们需要把所有的东西都放在一个里面"
  },
  {
   "from": 375.38,
   "to": 376.3,
   "sid": 82,
   "location": 2,
   "content": "屈膝"
  },
  {
   "from": 377.34,
   "to": 378.38,
   "sid": 83,
   "location": 2,
   "content": "把球留下"
  },
  {
   "from": 378.7,
   "to": 382.98,
   "sid": 84,
   "location": 2,
   "content": "球应该遵循完美的短版本"
  },
  {
   "from": 382.98,
   "to": 384.86,
   "sid": 85,
   "location": 2,
   "content": "所以更容易记住"
  },
  {
   "from": 386.14,
   "to": 389.78,
   "sid": 86,
   "location": 2,
   "content": "膝盖球闭嘴"
  },
  {
   "from": 390.36,
   "to": 391.78,
   "sid": 87,
   "location": 2,
   "content": "最后一个细节"
  },
  {
   "from": 391.78,
   "to": 393.4,
   "sid": 88,
   "location": 2,
   "content": "如果你想成为更好的射手"
  },
  {
   "from": 393.4,
   "to": 395.11,
   "sid": 89,
   "location": 2,
   "content": "你需要练习射击"
  },
  {
   "from": 395.11,
   "to": 396.77,
   "sid": 90,
   "location": 2,
   "content": "无数次"
  },
  {
   "from": 396.77,
   "to": 399.65,
   "sid": 91,
   "location": 2,
   "content": "大约300发子弹"
  },
  {
   "from": 399.65,
   "to": 402.13,
   "sid": 92,
   "location": 2,
   "content": "一周五天七天"
  },
  {
   "from": 402.13,
   "to": 403.21,
   "sid": 93,
   "location": 2,
   "content": "不许开玩笑"
  },
  {
   "from": 403.21,
   "to": 404.69,
   "sid": 94,
   "location": 2,
   "content": "我不是在开玩笑"
  },
  {
   "from": 404.69,
   "to": 406.89,
   "sid": 95,
   "location": 2,
   "content": "每一个细节都必须成为一种习惯"
  },
  {
   "from": 406.89,
   "to": 408.19,
   "sid": 96,
   "location": 2,
   "content": "你可以养成一个习惯"
  },
  {
   "from": 408.19,
   "to": 410.95,
   "sid": 97,
   "location": 2,
   "content": "只有这么多的重复"
  },
  {
   "from": 410.95,
   "to": 413.01,
   "sid": 98,
   "location": 2,
   "content": "当你重复舌头的时候"
  },
  {
   "from": 413.01,
   "to": 414.86,
   "sid": 99,
   "location": 2,
   "content": "但是正确的重复"
  },
  {
   "from": 414.86,
   "to": 417.22,
   "sid": 100,
   "location": 2,
   "content": "然后细节就会成为一种习惯"
  },
  {
   "from": 417.22,
   "to": 419.93,
   "sid": 101,
   "location": 2,
   "content": "你的射击会变得稳定"
  },
  {
   "from": 419.93,
   "to": 424.05,
   "sid": 102,
   "location": 2,
   "content": "她说他们可以进去"
  },
  {
   "from": 424.05,
   "to": 425.93,
   "sid": 103,
   "location": 2,
   "content": "有人会禁止他"
  },
  {
   "from": 425.93,
   "to": 430.52,
   "sid": 104,
   "location": 2,
   "content": "我们会看到其中一个"
  },
  {
   "from": 430.52,
   "to": 432.96,
   "sid": 105,
   "location": 2,
   "content": "一个会禁止他，他和他的死亡"
  },
  {
   "from": 432.96,
   "to": 434.88,
   "sid": 106,
   "location": 2,
   "content": "我可以保证"
  },
  {
   "from": 434.88,
   "to": 436.56,
   "sid": 107,
   "location": 2,
   "content": "如果你遵循这些细节"
  },
  {
   "from": 436.56,
   "to": 440.95,
   "sid": 108,
   "location": 2,
   "content": "你的镜头会变得更好"
  },
  {
   "from": 440.95,
   "to": 443.96,
   "sid": 109,
   "location": 2,
   "content": "请把这段视频分享给你的朋友"
  },
  {
   "from": 444.14,
   "to": 445.82,
   "sid": 110,
   "location": 2,
   "content": "迪万佐"
  },
  {
   "from": 445.82,
   "to": 447.36,
   "sid": 111,
   "location": 2,
   "content": "不要跳过我们的下一个视频"
  },
  {
   "from": 447.36,
   "to": 452.7,
   "sid": 112,
   "location": 2,
   "content": "因为在下一个视频中我将展示你不应该练习 你可以自己完成"
  },
  {
   "from": 452.7,
   "to": 457.099,
   "sid": 113,
   "location": 2,
   "content": "你要练习这些细节 不应该打破这个"
  }
 ]
}