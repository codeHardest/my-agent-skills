 "body": [
  {
   "from": 1.44,
   "to": 2.46,
   "sid": 1,
   "location": 2,
   "content": "你们在急什么呢"
  },
  {
   "from": 3.78,
   "to": 5.859,
   "sid": 2,
   "location": 2,
   "content": "努力必须得立刻看他汇报"
  },
  {
   "from": 7.06,
   "to": 8.94,
   "sid": 3,
   "location": 2,
   "content": "你们已经中了圈套了"
  },
  {
   "from": 9.239,
   "to": 12.239,
   "sid": 4,
   "location": 2,
   "content": "这个世界就是让你们不假思索"
  },
  {
   "from": 12.239,
   "to": 13.679,
   "sid": 5,
   "location": 2,
   "content": "没有时间思考"
  },
  {
   "from": 13.679,
   "to": 17.58,
   "sid": 6,
   "location": 2,
   "content": "只是在不断的比较攀比当中迷失自我"
  },
  {
   "from": 19.08,
   "to": 20.51,
   "sid": 7,
   "location": 2,
   "content": "停下来"
  },
  {
   "from": 20.51,
   "to": 22.7,
   "sid": 8,
   "location": 2,
   "content": "迷茫的时候停下来"
  },
  {
   "from": 22.7,
   "to": 24.24,
   "sid": 9,
   "location": 2,
   "content": "不要着急"
  },
  {
   "from": 24.5,
   "to": 27.62,
   "sid": 10,
   "location": 2,
   "content": "今天给兄弟们分享一个胯下拖曳步的一个变向"
  },
  {
   "from": 27.62,
   "to": 29.48,
   "sid": 11,
   "location": 2,
   "content": "能够快速提升我们的变向速度"
  },
  {
   "from": 29.48,
   "to": 32,
   "sid": 12,
   "location": 2,
   "content": "首先我们这次变相之前我们做了一次拖曳步"
  },
  {
   "from": 32,
   "to": 33.51,
   "sid": 13,
   "location": 2,
   "content": "这个拖曳步非常的重要"
  },
  {
   "from": 33.51,
   "to": 35.16,
   "sid": 14,
   "location": 2,
   "content": "首先我们上后胯下"
  },
  {
   "from": 35.16,
   "to": 38.25,
   "sid": 15,
   "location": 2,
   "content": "这时候我们上后脚抬起来登记"
  },
  {
   "from": 38.25,
   "to": 39.63,
   "sid": 16,
   "location": 2,
   "content": "第二脚往外延伸"
  },
  {
   "from": 39.63,
   "to": 41.34,
   "sid": 17,
   "location": 2,
   "content": "这时候我们重拳一下就过来了"
  },
  {
   "from": 41.34,
   "to": 43.53,
   "sid": 18,
   "location": 2,
   "content": "所以是我们把我们的手臂延伸出去"
  },
  {
   "from": 43.53,
   "to": 44.92,
   "sid": 19,
   "location": 2,
   "content": "立刻衔接变向"
  },
  {
   "from": 44.92,
   "to": 46.96,
   "sid": 20,
   "location": 2,
   "content": "所以我们的速度会非常快"
  },
  {
   "from": 46.96,
   "to": 48.1,
   "sid": 21,
   "location": 2,
   "content": "我们的诱导性也会更大"
  },
  {
   "from": 48.1,
   "to": 50.46,
   "sid": 22,
   "location": 2,
   "content": "还有一个细节就是我们在另外上步"
  },
  {
   "from": 50.46,
   "to": 52.38,
   "sid": 23,
   "location": 2,
   "content": "胯下第二延伸出去"
  },
  {
   "from": 52.38,
   "to": 53.7,
   "sid": 24,
   "location": 2,
   "content": "重心以后变向的时候"
  },
  {
   "from": 53.7,
   "to": 55.09,
   "sid": 25,
   "location": 2,
   "content": "我们可以接一个挖步"
  },
  {
   "from": 55.09,
   "to": 57.28,
   "sid": 26,
   "location": 2,
   "content": "这时候也会增加我们的突破速度"
  },
  {
   "from": 57.28,
   "to": 59.83,
   "sid": 27,
   "location": 2,
   "content": "我们可以连外卖也去玩游戏"
  },
  {
   "from": 59.83,
   "to": 63.19,
   "sid": 28,
   "location": 2,
   "content": "让我们上次刷下来一二连续重击"
  },
  {
   "from": 63.19,
   "to": 66.96,
   "sid": 29,
   "location": 2,
   "content": "就这时候顺势变相滑步打上来"
  },
  {
   "from": 67.64,
   "to": 69.32,
   "sid": 30,
   "location": 2,
   "content": "你想要把这个动作弄好了"
  },
  {
   "from": 69.32,
   "to": 71.87,
   "sid": 31,
   "location": 2,
   "content": "我现在原地做一个胯下垫子"
  },
  {
   "from": 71.87,
   "to": 74.22,
   "sid": 32,
   "location": 2,
   "content": "胯下一二兄弟"
  },
  {
   "from": 74.22,
   "to": 76.65,
   "sid": 33,
   "location": 2,
   "content": "然后我们再来胯下一二"
  },
  {
   "from": 76.65,
   "to": 80.789,
   "sid": 34,
   "location": 2,
   "content": "因为这个发力模式跟正常的作业整体配置不一样"
  },
  {
   "from": 80.789,
   "to": 83.789,
   "sid": 35,
   "location": 2,
   "content": "他需要我们依次往后来点水军"
  },
  {
   "from": 83.789,
   "to": 85.889,
   "sid": 36,
   "location": 2,
   "content": "工作细节就不再借鉴一下"
  },
  {
   "from": 85.889,
   "to": 87.47,
   "sid": 37,
   "location": 2,
   "content": "就是第二"
  },
  {
   "from": 87.47,
   "to": 88.67,
   "sid": 38,
   "location": 2,
   "content": "第二好发力"
  },
  {
   "from": 88.67,
   "to": 89.94,
   "sid": 39,
   "location": 2,
   "content": "保持血液病"
  },
  {
   "from": 97.08,
   "to": 100.32,
   "sid": 40,
