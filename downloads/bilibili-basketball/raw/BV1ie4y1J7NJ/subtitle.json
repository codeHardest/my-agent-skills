{
 "font_size": 0.4,
 "font_color": "#FFFFFF",
 "background_alpha": 0.5,
 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "v1.4.0.4",
 "body": [
  {
   "from": 0.12,
   "to": 3.45,
   "sid": 1,
   "location": 2,
   "content": "你的变向运球是否还存在运球僵硬不协调"
  },
  {
   "from": 3.45,
   "to": 4.89,
   "sid": 2,
   "location": 2,
   "content": "提不起速度的问题"
  },
  {
   "from": 4.89,
   "to": 6.78,
   "sid": 3,
   "location": 2,
   "content": "今天给大家分享五点"
  },
  {
   "from": 8.69,
   "to": 11.06,
   "sid": 4,
   "location": 2,
   "content": "首先第一点就是我们在变向时"
  },
  {
   "from": 11.06,
   "to": 14.03,
   "sid": 5,
   "location": 2,
   "content": "我们的手臂不要过度的紧张"
  },
  {
   "from": 14.03,
   "to": 16.37,
   "sid": 6,
   "location": 2,
   "content": "导致我们整个手臂是完全伸直的状态"
  },
  {
   "from": 16.37,
   "to": 17.39,
   "sid": 7,
   "location": 2,
   "content": "去进行一个变向"
  },
  {
   "from": 17.39,
   "to": 19.97,
   "sid": 8,
   "location": 2,
   "content": "这会让我们的运球看起来非常僵硬"
  },
  {
   "from": 19.97,
   "to": 21.83,
   "sid": 9,
   "location": 2,
   "content": "那么首先我们在变向时"
  },
  {
   "from": 21.83,
   "to": 25.19,
   "sid": 10,
   "location": 2,
   "content": "我们的手随着球的左右进行一个摆动"
  },
  {
   "from": 25.19,
   "to": 26.51,
   "sid": 11,
   "location": 2,
   "content": "它是一个放松的状态"
  },
  {
   "from": 26.51,
   "to": 28.78,
   "sid": 12,
   "location": 2,
   "content": "而不是一个完全绷紧的状态"
  },
  {
   "from": 28.78,
   "to": 30.9,
   "sid": 13,
   "location": 2,
   "content": "这样进行线下"
  },
  {
   "from": 31.06,
   "to": 31.84,
   "sid": 14,
   "location": 2,
   "content": "第二点"
  },
  {
   "from": 31.84,
   "to": 32.74,
   "sid": 15,
   "location": 2,
   "content": "正常容易犯的错误"
  },
  {
   "from": 32.74,
   "to": 34.48,
   "sid": 16,
   "location": 2,
   "content": "就是我们在变相使用我们的手腕"
  },
  {
   "from": 34.48,
   "to": 35.5,
   "sid": 17,
   "location": 2,
   "content": "参与发力太少"
  },
  {
   "from": 35.5,
   "to": 38.14,
   "sid": 18,
   "location": 2,
   "content": "很多同学也跟这局手臂好了"
  },
  {
   "from": 38.14,
   "to": 39.099,
   "sid": 19,
   "location": 2,
   "content": "手腕不动"
  },
  {
   "from": 39.12,
   "to": 41.1,
   "sid": 20,
   "location": 2,
   "content": "ok那我们在做的时候"
  },
  {
   "from": 41.1,
   "to": 43.8,
   "sid": 21,
   "location": 2,
   "content": "我们要注意我们的手腕朝对侧进行的拨腕"
  },
  {
   "from": 43.8,
   "to": 45.09,
   "sid": 22,
   "location": 2,
   "content": "像我们投篮一样"
  },
  {
   "from": 45.09,
   "to": 48.65,
   "sid": 23,
   "location": 2,
   "content": "这个球是慢慢离开我们的手到我们的指尖"
  },
  {
   "from": 48.65,
   "to": 50.05,
   "sid": 24,
   "location": 2,
   "content": "然后拨出去"
  },
  {
   "from": 50.05,
   "to": 53.14,
   "sid": 25,
   "location": 2,
   "content": "只是朝下坡桥对侧摸一个道理"
  },
  {
   "from": 53.14,
   "to": 55.48,
   "sid": 26,
   "location": 2,
   "content": "要我们手臂手腕要协调发力"
  },
  {
   "from": 56.72,
   "to": 57.82,
   "sid": 27,
   "location": 2,
   "content": "第三点原因"
  },
  {
   "from": 57.82,
   "to": 59.11,
   "sid": 28,
   "location": 2,
   "content": "辅助手跟随的问题"
  },
  {
   "from": 59.11,
   "to": 60.34,
   "sid": 29,
   "location": 2,
   "content": "我们在做变向时"
  },
  {
   "from": 60.34,
   "to": 62.54,
   "sid": 30,
   "location": 2,
   "content": "很多同学辅助手没有进行一个跟随"
  },
  {
   "from": 62.54,
   "to": 63.8,
   "sid": 31,
   "location": 2,
   "content": "那我们在做的过程中"
  },
  {
   "from": 63.8,
   "to": 66.14,
   "sid": 32,
   "location": 2,
   "content": "我们的辅助手始终跟着保持"
  },
  {
   "from": 66.14,
   "to": 67.8,
   "sid": 33,
   "location": 2,
   "content": "一拳左右的距离"
  },
  {
   "from": 67.8,
   "to": 68.88,
   "sid": 34,
   "location": 2,
   "content": "为了保护球"
  },
  {
   "from": 68.88,
   "to": 71.1,
   "sid": 35,
   "location": 2,
   "content": "同时也能让我们更好的找到"
  },
  {
   "from": 71.1,
   "to": 72.619,
   "sid": 36,
   "location": 2,
   "content": "落球点的起球点"
  },
  {
   "from": 72.78,
   "to": 75.66,
   "sid": 37,
   "location": 2,
   "content": "让我们的接球运动率更高"
  },
  {
   "from": 75.66,
   "to": 77.22,
   "sid": 38,
   "location": 2,
   "content": "让我扣脚特别长"
  },
  {
   "from": 77.22,
   "to": 78.22,
   "sid": 39,
   "location": 2,
   "content": "特别快"
  },
  {
   "from": 78.42,
   "to": 80.97,
   "sid": 40,
   "location": 2,
   "content": "第四点就是我们重心转换的问题"
  },
  {
   "from": 80.97,
   "to": 83.52,
   "sid": 41,
   "location": 2,
   "content": "很多同学在变向时重心没有转换"
  },
  {
   "from": 83.52,
   "to": 84.74,
   "sid": 42,
   "location": 2,
   "content": "像木乃伊一样"
  },
  {
   "from": 85.06,
   "to": 87.4,
   "sid": 43,
   "location": 2,
   "content": "那我们建议大家在做变向时"
  },
  {
   "from": 87.4,
   "to": 89.41,
   "sid": 44,
   "location": 2,
   "content": "我们的重心有个组一个转换"
  },
  {
   "from": 89.41,
   "to": 90.97,
   "sid": 45,
   "location": 2,
   "content": "我们球到一侧以后"
  },
  {
   "from": 90.97,
   "to": 92.56,
   "sid": 46,
   "location": 2,
   "content": "我们用外侧脚蹬地"
  },
  {
   "from": 92.56,
   "to": 93.97,
   "sid": 47,
   "location": 2,
   "content": "把重心转换到这一侧"
  },
  {
   "from": 93.97,
   "to": 96.22,
   "sid": 48,
   "location": 2,
   "content": "那这时候我们肩膀就有一个自然的调动"
  },
  {
   "from": 96.22,
   "to": 98.08,
   "sid": 49,
   "location": 2,
   "content": "就我们那有一个自然的光线"
  },
  {
   "from": 98.08,
   "to": 99.16,
   "sid": 50,
   "location": 2,
   "content": "我们可以理解成"
  },
  {
   "from": 99.16,
   "to": 101.26,
   "sid": 51,
   "location": 2,
   "content": "我们的内侧脚踝去贴近地面"
  },
  {
   "from": 101.26,
   "to": 103.48,
   "sid": 52,
   "location": 2,
   "content": "让我们左右去贴近地面"
  },
  {
   "from": 111.3,
   "to": 112.4,
   "sid": 53,
   "location": 2,
   "content": "最后一点就是"
  },
  {
   "from": 114.26,
   "to": 116.8,
   "sid": 54,
   "location": 2,
   "content": "经常把球运到我们的身体前方"
  },
  {
   "from": 117,
   "to": 119.22,
   "sid": 55,
   "location": 2,
   "content": "但这对于我们的保护球非常的不利"
  },
  {
   "from": 120.78,
   "to": 123.59,
   "sid": 56,
   "location": 2,
   "content": "尽量的将球放在我们的身体下方"
  },
  {
   "from": 123.59,
   "to": 126.82,
   "sid": 57,
   "location": 2,
   "content": "也就是我们在屈髋的过程中将球保护起来"
  },
  {
   "from": 126.82,
   "to": 130.09,
   "sid": 58,
   "location": 2,
   "content": "在我们这贴近膝盖的位置进行一个变向"
  },
  {
   "from": 130.09,
   "to": 132.54,
   "sid": 59,
   "location": 2,
   "content": "然后加上我们就是要广东"
  },
  {
   "from": 136.679,
   "to": 137.72,
   "sid": 60,
   "location": 2,
   "content": "你学会了吗"
  }
 ]
}