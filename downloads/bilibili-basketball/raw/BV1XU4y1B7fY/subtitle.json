   "to": 21.11,
   "sid": 10,
   "location": 2,
   "content": "向前投去借力"
  },
  {
   "from": 21.11,
   "to": 22.94,
   "sid": 11,
   "location": 2,
   "content": "投篮时身体重心前冲"
