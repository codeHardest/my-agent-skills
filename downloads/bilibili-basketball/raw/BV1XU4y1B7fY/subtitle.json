  {
   "from": 137.8,
   "to": 140.09,
   "sid": 66,
   "location": 2,
   "content": "其次是低效的下肢发力模型"
  },
  {
   "from": 140.09,
   "to": 142.1,
   "sid": 67,
   "location": 2,
   "content": "具体表现为屈膝过度"
  },
  {
   "from": 142.1,
   "to": 143,
   "sid": 68,
   "location": 2,
   "content": "屈髋不足"
  },
  {
   "from": 143,
   "to": 144.5,
   "sid": 69,
   "location": 2,
   "content": "较大的屈膝角度"
  },
  {
   "from": 144.5,
   "to": 146.66,
   "sid": 70,
   "location": 2,
   "content": "导致下肢的伸展速度变慢"
  },
  {
   "from": 146.66,
   "to": 148.37,
   "sid": 71,
   "location": 2,
   "content": "同时发力效率较低"
  },
  {
   "from": 148.37,
   "to": 151.82,
   "sid": 72,
   "location": 2,
   "content": "那么该如何做到快速而高效的下肢发力呢"
  },
  {
   "from": 151.82,
   "to": 153.65,
   "sid": 73,
   "location": 2,
   "content": "我们需要追求的是多屈髋"
  },
  {
   "from": 153.65,
   "to": 154.31,
   "sid": 74,
   "location": 2,
   "content": "少屈膝"
  },
  {
   "from": 154.31,
   "to": 156.709,
   "sid": 75,
   "location": 2,
   "content": "用屈髋带动小幅度的屈膝"
  },
  {
   "from": 156.709,
   "to": 159.259,
   "sid": 76,
   "location": 2,
   "content": "髋关节周围的肌肉都非常强大"
  },
  {
   "from": 159.259,
   "to": 162.35,
   "sid": 77,
   "location": 2,
   "content": "较小的屈髋角度就可以产生较大的力量"
  },
  {
   "from": 162.35,
   "to": 165.82,
   "sid": 78,
   "location": 2,
   "content": "大多数职业球员都有这样高效的下肢发力模式"
  },
  {
   "from": 165.82,
   "to": 169.33,
   "sid": 79,
   "location": 2,
   "content": "他们在远距离投篮通常采用一二步来衔接投篮"
  },
  {
   "from": 169.33,
   "to": 171.76,
   "sid": 80,
   "location": 2,
   "content": "一二部的站姿可以让你提前去宽"
  },
  {
   "from": 171.76,
   "to": 174.58,
   "sid": 81,
   "location": 2,
   "content": "在踏出第一步时就开始将重心在空中"
  },
  {
   "from": 174.58,
   "to": 175.99,
   "sid": 82,
   "location": 2,
   "content": "就完成了降重心"
  },
  {
   "from": 175.99,
   "to": 178.24,
   "sid": 83,
   "location": 2,
   "content": "第二步触地的瞬间就衔接蹬地"
  },
  {
   "from": 178.24,
   "to": 179.26,
   "sid": 84,
   "location": 2,
   "content": "启动下肢伸展"
  },
  {
   "from": 179.26,
   "to": 179.89,
   "sid": 85,
   "location": 2,
   "content": "向上跳"
  },
  {
   "from": 179.89,
   "to": 181.1,
   "sid": 86,
   "location": 2,
   "content": "同时起球"
  },
  {
   "from": 183.719,
   "to": 188.46,
   "sid": 87,
   "location": 2,
   "content": "我们同样可以练习一二部来培养多取宽敞屈膝的发力习惯"
  },
  {
   "from": 192.54,
   "to": 194.15,
   "sid": 88,
   "location": 2,
   "content": "最后需要补充一点"
  },
  {
   "from": 194.15,
   "to": 196.34,
   "sid": 89,
   "location": 2,
   "content": "有些人在进行两段式跳投时"
  },
  {
   "from": 196.34,
   "to": 198.47,
   "sid": 90,
   "location": 2,
   "content": "在出手后会有前跳的现象"
  },
  {
   "from": 198.47,
   "to": 199.88,
   "sid": 91,
   "location": 2,
   "content": "这属于正常情况"
  },
  {
   "from": 199.88,
   "to": 201.249,
   "sid": 92,
   "location": 2,
   "content": "无需纠正此类"
  },
  {
   "from": 201.249,
   "to": 202.299,
   "sid": 93,
   "location": 2,
   "content": "以科比为代表"
  },
  {
   "from": 202.299,
   "to": 205.85,
   "sid": 94,
   "location": 2,
   "content": "它是通过大幅度的屈膝屈髋来充分蓄力起跳"
  },
  {
   "from": 205.85,
   "to": 207.35,
   "sid": 95,
   "location": 2,
   "content": "上至会在空中等待"
  },
  {
   "from": 207.35,
   "to": 209.37,
   "sid": 96,
   "location": 2,
   "content": "下至完全伸展后发力出手"
  },
  {
   "from": 209.37,
   "to": 212.52,
   "sid": 97,
   "location": 2,
   "content": "而两段式投篮本身就是前后发力的投篮"
  },
  {
   "from": 212.52,
   "to": 215.93,
   "sid": 98,
   "location": 2,
   "content": "他会通过前排双腿或单腿来平衡身体重心"
  },
  {
   "from": 215.93,
   "to": 218.54,
   "sid": 99,
   "location": 2,
   "content": "最终形成了出手后的小幅度前跳"
  }
