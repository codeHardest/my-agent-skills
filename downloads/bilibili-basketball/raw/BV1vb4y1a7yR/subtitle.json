{
 "font_size": 0.4,
 "font_color": "#FFFFFF",
 "background_alpha": 0.5,
 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "1.5.0",
 "body": [
  {
   "from": 0.3,
   "to": 1.5,
   "sid": 1,
   "location": 2,
   "content": "如果你想改投篮",
   "music": 0
  },
  {
   "from": 1.5,
   "to": 4.17,
   "sid": 2,
   "location": 2,
   "content": "想像库里那样轻松毫不费力地投三分",
   "music": 0
  },
  {
   "from": 4.17,
   "to": 6.12,
   "sid": 3,
   "location": 2,
   "content": "那么这个视频一定能帮助到你",
   "music": 0
  },
  {
   "from": 6.12,
   "to": 7.8,
   "sid": 4,
   "location": 2,
   "content": "如果你不知道从何练起",
   "music": 0
  },
  {
   "from": 7.8,
   "to": 9.87,
   "sid": 5,
   "location": 2,
   "content": "不知道如何更高效的练习",
   "music": 0
  },
  {
   "from": 9.87,
   "to": 12.12,
   "sid": 6,
   "location": 2,
   "content": "那么这个视频你不容错过",
   "music": 0
  },
  {
   "from": 14.3,
   "to": 16.57,
   "sid": 7,
   "location": 2,
   "content": "库里真的是一个划时代的巨星",
   "music": 0.056872035219334476
  },
  {
   "from": 16.57,
   "to": 18.25,
   "sid": 8,
   "location": 2,
   "content": "他改变了比赛的方式",
   "music": 0.4345237836592989
  },
  {
   "from": 18.25,
   "to": 20.34,
   "sid": 9,
   "location": 2,
   "content": "过了半场就是他的进攻范围",
   "music": 0.2822966372106872
  },
  {
   "from": 20.34,
   "to": 22.5,
   "sid": 10,
   "location": 2,
   "content": "库里的球技征服了球迷",
   "music": 0.2330096974267141
  },
  {
   "from": 22.5,
   "to": 25.44,
   "sid": 11,
   "location": 2,
   "content": "无数球迷模仿在库里打球场上打球",
   "music": 0.31578946181242484
  },
  {
   "from": 25.44,
   "to": 27.36,
   "sid": 12,
   "location": 2,
   "content": "幻想着自己也能像库里那样",
   "music": 0.36666664629629736
  },
  {
   "from": 27.36,
   "to": 29.22,
   "sid": 13,
   "location": 2,
   "content": "一连串三分刷刷刷的进步",
   "music": 0.11827956353335622
  },
  {
   "from": 29.22,
   "to": 31.259,
   "sid": 14,
   "location": 2,
   "content": "库里的投篮动作同样是划时代的",
   "music": 0.22772276100382421
  },
  {
   "from": 31.259,
   "to": 33.599,
   "sid": 15,
   "location": 2,
   "content": "在库里之前甚至没听过one motion",
   "music": 0.40971889424874297
  },
  {
   "from": 33.599,
   "to": 35.74,
   "sid": 16,
   "location": 2,
   "content": "two motion之类的奇怪的名词",
   "music": 0.3533568726220671
  },
  {
   "from": 35.74,
   "to": 38.06,
   "sid": 17,
   "location": 2,
   "content": "库里对我的影响也是非常大的",
   "music": 0.24489794668887857
  },
  {
   "from": 38.06,
   "to": 40.04,
   "sid": 18,
   "location": 2,
   "content": "我之前的投篮是two motion",
   "music": 0.48148145176040125
  },
  {
   "from": 40.04,
   "to": 41.66,
   "sid": 19,
   "location": 2,
   "content": "当我看到库里如此轻松",
   "music": 0
  },
  {
   "from": 41.66,
   "to": 43.25,
   "sid": 20,
   "location": 2,
   "content": "毫不费力的投篮时",
   "music": 0.17567566380570138
  },
  {
   "from": 43.25,
   "to": 45.48,
   "sid": 21,
   "location": 2,
   "content": "我决心我也要像库里一样",
   "music": 0.3369565034262788
  },
  {
   "from": 45.48,
   "to": 47.04,
   "sid": 22,
   "location": 2,
   "content": "这个过程无比的痛苦",
   "music": 0.0933333271111119
  },
  {
   "from": 47.04,
   "to": 48.03,
   "sid": 23,
   "location": 2,
   "content": "无比漫长",
   "music": 0.5306121907538591
  },
  {
   "from": 48.03,
   "to": 49.83,
   "sid": 24,
   "location": 2,
   "content": "经历了两年的沉淀",
   "music": 0
  },
  {
   "from": 49.83,
   "to": 51.26,
   "sid": 25,
   "location": 2,
   "content": "才有了点模样",
   "music": 0
  },
  {
   "from": 51.26,
   "to": 54.62,
   "sid": 26,
   "location": 2,
   "content": "今天给大家分享一下我改投篮所进行的练习",
   "music": 0.26582277639801416
  },
  {
   "from": 54.62,
   "to": 56.45,
   "sid": 27,
   "location": 2,
   "content": "希望能帮助到大家",
   "music": 0.2987012793051078
  },
  {
   "from": 56.45,
   "to": 58.92,
   "sid": 28,
   "location": 2,
   "content": "我会结合库里的投篮动作一起讲解",
   "music": 0.21739129489603093
  },
  {
   "from": 58.92,
   "to": 62.28,
   "sid": 29,
   "location": 2,
   "content": "平时我自己也是非常喜欢研究分析库里的动作",
   "music": 0
  },
  {
   "from": 62.28,
   "to": 64.519,
   "sid": 30,
   "location": 2,
   "content": "因为实在是太他妈的酷了",
   "music": 0
  },
  {
   "from": 64.519,
   "to": 66.319,
   "sid": 31,
   "location": 2,
   "content": "练习前需要明确几点",
   "music": 0
  },
  {
   "from": 66.319,
   "to": 66.889,
   "sid": 32,
   "location": 2,
   "content": "第一点",
   "music": 0
  },
  {
   "from": 66.889,
   "to": 68.599,
   "sid": 33,
   "location": 2,
   "content": "改投篮尽量不要打比赛",
   "music": 0
  },
  {
   "from": 68.599,
   "to": 70.129,
   "sid": 34,
   "location": 2,
   "content": "第二点切忌急于求成",
   "music": 0
  },
  {
   "from": 70.129,
   "to": 71.38,
   "sid": 35,
   "location": 2,
   "content": "欲速则不达",
   "music": 0
  },
  {
   "from": 71.38,
   "to": 72.16,
   "sid": 36,
   "location": 2,
   "content": "第三点",
   "music": 0
  },
  {
   "from": 72.16,
   "to": 73.54,
   "sid": 37,
   "location": 2,
   "content": "采用循序渐进的方式",
   "music": 0
  },
  {
   "from": 73.54,
   "to": 74.56,
   "sid": 38,
   "location": 2,
   "content": "才能事半功倍",
   "music": 0.5686273952326089
  },
  {
   "from": 74.56,
   "to": 75.16,
   "sid": 39,
   "location": 2,
   "content": "话不多说",
   "music": 0
  },
  {
   "from": 75.16,
   "to": 77.41,
   "sid": 40,
   "location": 2,
   "content": "咱们练起第一个练习",
   "music": 0
  },
  {
   "from": 77.41,
   "to": 79.51,
   "sid": 41,
   "location": 2,
   "content": "持球到举球的分解动作",
   "music": 0
  },
  {
   "from": 79.51,
   "to": 82.1,
   "sid": 42,
   "location": 2,
   "content": "持球沉球在腰部附近的位置",
   "music": 0
  },
  {
   "from": 82.1,
   "to": 84.95,
   "sid": 43,
   "location": 2,
   "content": "两手放在球两侧稍稍偏上的位置",
   "music": 0.29838708474245373
  },
  {
   "from": 84.95,
   "to": 87.02,
   "sid": 44,
   "location": 2,
   "content": "我们来看一下库里的持球动作",
   "music": 0.1978021869339462
  },
  {
   "from": 87.02,
   "to": 89.72,
   "sid": 45,
   "location": 2,
   "content": "差不多也是在球的两侧边上的位置",
   "music": 0
  },
  {
   "from": 89.72,
   "to": 92.24,
   "sid": 46,
   "location": 2,
   "content": "这样手腕手臂都是非常放松的状态",
   "music": 0
  },
  {
   "from": 92.24,
   "to": 94.5,
   "sid": 47,
   "location": 2,
   "content": "完全不会向旋转手臂带来不适",
   "music": 0
  },
  {
   "from": 94.5,
   "to": 96.63,
   "sid": 48,
   "location": 2,
   "content": "辅助手是放在球的侧上面的",
   "music": 0
  },
  {
   "from": 96.63,
   "to": 97.56,
   "sid": 49,
   "location": 2,
   "content": "举球过程中",
   "music": 0
  },
  {
   "from": 97.56,
   "to": 99.66,
   "sid": 50,
   "location": 2,
   "content": "辅助手用力的占比是比较大的",
   "music": 0
  },
  {
   "from": 99.66,
   "to": 101.81,
   "sid": 51,
   "location": 2,
   "content": "几乎都是靠辅助手将球抬起",
   "music": 0.26976742931314135
  },
  {
   "from": 101.81,
   "to": 103.73,
   "sid": 52,
   "location": 2,
   "content": "投篮手几乎是一条直线",
   "music": 0
  },
  {
   "from": 103.73,
   "to": 106.2,
   "sid": 53,
   "location": 2,
   "content": "直上直下脚步只有前后的移动",
   "music": 0
  },
  {
   "from": 106.2,
   "to": 107.54,
   "sid": 54,
   "location": 2,
   "content": "不会有左右的移动",
   "music": 0
  },
  {
   "from": 107.54,
   "to": 109.58,
   "sid": 55,
   "location": 2,
   "content": "如果你觉得你的肘关节外踝",
   "music": 0
  },
  {
   "from": 109.58,
   "to": 111.23,
   "sid": 56,
   "location": 2,
   "content": "严重影响到投篮准度",
   "music": 0
  },
  {
   "from": 111.23,
   "to": 113.18,
   "sid": 57,
   "location": 2,
   "content": "那么你也可以单独做这个练习",
   "music": 0
  },
  {
   "from": 113.18,
   "to": 114.42,
   "sid": 58,
   "location": 2,
   "content": "非常的清晰明了",
   "music": 0.2258064334027088
  },
  {
   "from": 114.42,
   "to": 116.1,
   "sid": 59,
   "location": 2,
   "content": "举球到额头附近即可",
   "music": 0
  },
  {
   "from": 116.1,
   "to": 117.96,
   "sid": 60,
   "location": 2,
   "content": "收好大臂小臂的夹角",
   "music": 0
  },
  {
   "from": 117.96,
   "to": 120.72,
   "sid": 61,
   "location": 2,
   "content": "很多小伙伴说起球经常会碰到头",
   "music": 0.25833332256944025
  },
  {
   "from": 120.72,
   "to": 123.75,
   "sid": 62,
   "location": 2,
   "content": "有可能是你的大臂小臂收的太过了",
   "music": 0.21160408834115846
  },
  {
   "from": 123.75,
   "to": 126.26,
   "sid": 63,
   "location": 2,
   "content": "你可以将球直到额头偏右的位置",
   "music": 0
  },
  {
   "from": 126.26,
   "to": 129.14,
   "sid": 64,
   "location": 2,
   "content": "举球过程中球的轨迹是带有一定弧度的",
   "music": 0.02343749908446259
  },
  {
   "from": 129.14,
   "to": 130.36,
   "sid": 65,
   "location": 2,
   "content": "不是一条直线",
   "music": 0.31249996744792935
  },
  {
   "from": 130.36,
   "to": 133,
   "sid": 66,
   "location": 2,
   "content": "注意举球过程中头部要保持稳定",
   "music": 0.3279999868799978
  },
  {
   "from": 133,
   "to": 135.7,
   "sid": 67,
   "location": 2,
   "content": "如果头部往后除了会影响标准之外",
   "music": 0.1439393884871434
  },
  {
   "from": 135.7,
   "to": 137.92,
   "sid": 68,
   "location": 2,
   "content": "还容易导致你挺宽时身体反弓",
   "music": 0.2924528163937366
  },
  {
   "from": 137.92,
   "to": 139,
   "sid": 69,
   "location": 2,
   "content": "还有一个细节",
   "music": 0
  },
  {
   "from": 139,
   "to": 141.01,
   "sid": 70,
   "location": 2,
   "content": "举球到额头附近的时候",
   "music": 0
  },
  {
   "from": 141.01,
   "to": 142.24,
   "sid": 71,
   "location": 2,
   "content": "手腕是侧着的",
   "music": 0
  },
  {
   "from": 142.24,
   "to": 143.8,
   "sid": 72,
   "location": 2,
   "content": "如果是直的也没关系",
   "music": 0.28205126397107094
  },
  {
   "from": 143.8,
   "to": 145.57,
   "sid": 73,
   "location": 2,
   "content": "主要取决你的压腕弧度",
   "music": 0
  },
  {
   "from": 145.57,
   "to": 146.8,
   "sid": 74,
   "location": 2,
   "content": "压多了就会直",
   "music": 0
  },
  {
   "from": 146.8,
   "to": 149,
   "sid": 75,
   "location": 2,
   "content": "压少了自然就会撤走",
   "music": 0
  },
  {
   "from": 149,
   "to": 150.2,
   "sid": 76,
   "location": 2,
   "content": "第二个练习",
   "music": 0
  },
  {
   "from": 150.2,
   "to": 150.92,
   "sid": 77,
   "location": 2,
   "content": "单手举球",
   "music": 0
  },
  {
   "from": 150.92,
   "to": 151.79,
   "sid": 78,
   "location": 2,
   "content": "肩上拨球",
   "music": 0
  },
  {
   "from": 151.79,
   "to": 155.2,
   "sid": 79,
   "location": 2,
   "content": "这动作举球过程中需要将手臂旋转过来",
   "music": 0
  },
  {
   "from": 155.2,
   "to": 156.28,
   "sid": 80,
   "location": 2,
   "content": "到他额头位置",
   "music": 0
  },
  {
   "from": 156.28,
   "to": 157.06,
   "sid": 81,
   "location": 2,
   "content": "向上拨球",
   "music": 0
  },
  {
   "from": 157.06,
   "to": 157.9,
   "sid": 82,
   "location": 2,
   "content": "做这个练习",
   "music": 0
  },
  {
   "from": 157.9,
   "to": 158.62,
   "sid": 83,
   "location": 2,
   "content": "越是放松",
   "music": 0
  },
  {
   "from": 158.62,
   "to": 160.38,
   "sid": 84,
   "location": 2,
   "content": "向上弹的力就越大",
   "music": 0
  },
  {
   "from": 160.38,
   "to": 162.66,
   "sid": 85,
   "location": 2,
   "content": "在最后出手拨球时加快速度",
   "music": 0.29729728390553917
  },
  {
   "from": 162.66,
   "to": 163.86,
   "sid": 86,
   "location": 2,
   "content": "手臂向上顶肘",
   "music": 0
  },
  {
   "from": 163.86,
   "to": 165.87,
   "sid": 87,
   "location": 2,
   "content": "同时手腕手指下腕拨球",
   "music": 0.23350252621815004
  },
  {
   "from": 165.87,
   "to": 170.42,
   "sid": 88,
   "location": 2,
   "content": "使球场上后拳通常是食指和中指最后离开球",
   "music": 0.4685138421029261
  },
  {
   "from": 170.42,
   "to": 173.59,
   "sid": 89,
   "location": 2,
   "content": "所以有时候你会看到很多人投篮是兰花指",
   "music": 0.2352941095053953
  },
  {
   "from": 173.59,
   "to": 175.75,
   "sid": 90,
   "location": 2,
   "content": "拨球完后手腕指向地面",
   "music": 0.28703702374828854
  },
  {
   "from": 175.75,
   "to": 177.49,
   "sid": 91,
   "location": 2,
   "content": "保持跟随动作",
   "music": 0
  },
  {
   "from": 177.49,
   "to": 180.9,
   "sid": 92,
   "location": 2,
   "content": "第三个练习持球举球向上拨球",
   "music": 0
  },
  {
   "from": 180.9,
   "to": 182.58,
   "sid": 93,
   "location": 2,
   "content": "足球是非常关键的",
   "music": 0
  },
  {
   "from": 182.58,
   "to": 185.16,
   "sid": 94,
   "location": 2,
   "content": "很多时候投篮的脚步是比较容易调整的",
   "music": 0
  },
  {
   "from": 185.16,
   "to": 186.9,
   "sid": 95,
   "location": 2,
   "content": "但是触球就不一样了",
   "music": 0.17948716798157405
  },
  {
   "from": 186.9,
   "to": 189.24,
   "sid": 96,
   "location": 2,
   "content": "很多时候触球不在球的纹路上",
   "music": 0
  },
  {
   "from": 189.24,
   "to": 191.01,
   "sid": 97,
   "location": 2,
   "content": "两手的位置没把握好",
   "music": 0
  },
  {
   "from": 191.01,
   "to": 192.52,
   "sid": 98,
   "location": 2,
   "content": "就感觉很难受",
   "music": 0
  },
  {
   "from": 192.52,
   "to": 194.62,
   "sid": 99,
   "location": 2,
   "content": "同时球就感觉这球要打铁了",
   "music": 0
  },
  {
   "from": 194.62,
   "to": 196.18,
   "sid": 100,
   "location": 2,
   "content": "可以做一次搓球的调整",
   "music": 0
  },
  {
   "from": 196.18,
   "to": 198.52,
   "sid": 101,
   "location": 2,
   "content": "将球时在球的纹路上沉",
   "music": 0
  },
  {
   "from": 198.52,
   "to": 199.48,
   "sid": 102,
   "location": 2,
   "content": "球也是要有的",
   "music": 0
  },
  {
   "from": 199.48,
   "to": 202.66,
   "sid": 103,
   "location": 2,
   "content": "有助于后面降低手快脚慢出现的几率",
   "music": 0
  },
  {
   "from": 202.66,
   "to": 204.52,
   "sid": 104,
   "location": 2,
   "content": "同时要注意身体躯干",
   "music": 0
  },
  {
   "from": 204.52,
   "to": 205.9,
   "sid": 105,
   "location": 2,
   "content": "特别是上半身背部",
   "music": 0
  },
  {
   "from": 205.9,
   "to": 208.079,
   "sid": 106,
   "location": 2,
   "content": "腰部尽量保持直线状态",
   "music": 0
  },
  {
   "from": 208.079,
   "to": 209.819,
   "sid": 107,
   "location": 2,
