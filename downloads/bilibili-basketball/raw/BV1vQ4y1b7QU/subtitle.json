 "body": [
  {
   "from": 2.12,
   "to": 4.92,
   "sid": 1,
   "location": 2,
   "content": "如果我能让你的体重靠在后脚上"
  },
  {
   "from": 4.92,
   "to": 6.84,
   "sid": 2,
   "location": 2,
   "content": "或者让你踩到后脚"
  },
  {
   "from": 6.84,
   "to": 10.14,
   "sid": 3,
   "location": 2,
   "content": "首先，如果他走到这里，甚至靠在这里"
  },
  {
   "from": 10.14,
   "to": 13.24,
   "sid": 4,
   "location": 2,
   "content": "然后你，你回去，穿过这一边，他倾斜"
  },
  {
   "from": 13.24,
   "to": 14.4,
   "sid": 5,
   "location": 2,
   "content": "然后他打开了"
  },
  {
   "from": 14.4,
   "to": 15.5,
   "sid": 6,
   "location": 2,
   "content": "你已经用完了"
  },
  {
   "from": 15.5,
   "to": 18.14,
   "sid": 7,
   "location": 2,
   "content": "但要让它看起来像我的推"
  },
  {
   "from": 18.14,
   "to": 18.7,
   "sid": 8,
   "location": 2,
   "content": "好啦"
  },
  {
   "from": 18.7,
   "to": 19.87,
   "sid": 9,
   "location": 2,
   "content": "所以当我来到这里"
  },
  {
   "from": 19.87,
   "to": 22.75,
   "sid": 10,
   "location": 2,
   "content": "我想转动肩膀，用左脚踩"
  },
  {
   "from": 22.75,
   "to": 25.46,
   "sid": 11,
   "location": 2,
   "content": "如果你能带着一股蒸汽下坡"
  },
  {
   "from": 25.46,
   "to": 26.7,
   "sid": 12,
   "location": 2,
   "content": "我在倒车"
  },
  {
   "from": 26.7,
   "to": 29.46,
   "sid": 13,
   "location": 2,
   "content": "然后你让我更容易靠"
  }
 ]
