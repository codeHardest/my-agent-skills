 "type": "AIsubtitle",
 "lang": "zh",
 "version": "eng-1.2.0-Index-johns-pen-lite",
 "body": [
  {
   "content": "苏齐也不行",
   "from": 0.04,
   "location": 2,
   "music": 0,
   "sid": 1,
   "to": 5.98
  },
  {
   "content": "所以在跳绳时",
   "from": 24.92,
   "location": 2,
   "music": 0,
   "sid": 2,
   "to": 27.28
  },
  {
   "content": "十个细节阻碍你成为真正的三分射手",
   "from": 27.28,
   "location": 2,
   "music": 0,
   "sid": 3,
   "to": 30.9
  },
  {
   "content": "我在客户身上发现了这些错误",
   "from": 30.9,
   "location": 2,
   "music": 0,
   "sid": 4,
   "to": 33.2
  },
  {
   "content": "和我一起打球的人",
   "from": 33.2,
   "location": 2,
   "music": 0,
   "sid": 5,
   "to": 35.22
  },
  {
   "content": "当我们调整这些参数帮助他们更好地投篮",
   "from": 35.22,
   "location": 2,
   "music": 0,
   "sid": 6,
   "to": 38.5
  },
  {
   "content": "在我开始检查下方课程前，我相信会对你有帮助",
   "from": 38.5,
   "location": 2,
   "music": 0,
   "sid": 7,
   "to": 42.26
  },
  {
   "content": "全面提升你的每一项技术",
   "from": 42.26,
   "location": 2,
   "music": 0,
   "sid": 8,
   "to": 44.94
  },
  {
   "content": "现在让我们开始问题一",
   "from": 44.94,
   "location": 2,
   "music": 0,
   "sid": 9,
   "to": 46.74
  },
  {
   "content": "将下肢能量传递至上肢",
   "from": 46.74,
   "location": 2,
   "music": 0,
   "sid": 10,
   "to": 49.16
  },
  {
   "content": "动作的顺序",
   "from": 49.16,
   "location": 2,
   "music": 0,
   "sid": 11,
   "to": 50.58
  },
  {
   "content": "最关键的是如何让能量从下肢传递至上肢",
   "from": 50.58,
   "location": 2,
   "music": 0,
   "sid": 12,
   "to": 54.8
  },
  {
   "content": "投篮动作内部的能量传递需正确顺序",
   "from": 54.8,
   "location": 2,
   "music": 0,
   "sid": 13,
   "to": 58.62
  },
  {
   "content": "能量流动会更顺畅",
   "from": 58.62,
   "location": 2,
   "music": 0,
   "sid": 14,
   "to": 60.28
  },
  {
   "content": "简单又实用",
   "from": 60.28,
   "location": 2,
   "music": 0,
   "sid": 15,
   "to": 61.52
  },
  {
   "content": "首先下蹲",
   "from": 61.52,
   "location": 2,
   "music": 0,
   "sid": 16,
   "to": 62.92
  },
  {
   "content": "然后出球",
   "from": 62.92,
   "location": 2,
   "music": 0,
   "sid": 17,
   "to": 64.06
  },
  {
   "content": "接着膝盖再收",
   "from": 64.06,
   "location": 2,
   "music": 0,
   "sid": 18,
   "to": 66.6
  },
  {
   "content": "投篮前腿部不稳",
   "from": 74.56,
   "location": 2,
   "music": 0,
   "sid": 19,
   "to": 76.92
  },
  {
   "content": "这是个问题",
   "from": 76.92,
   "location": 2,
   "music": 0,
   "sid": 20,
   "to": 77.8
  },
  {
   "content": "每个投篮都始于双脚",
   "from": 77.8,
   "location": 2,
   "music": 0,
   "sid": 21,
   "to": 79.2
  },
  {
   "content": "若下肢未准备好启动能量",
   "from": 79.2,
   "location": 2,
   "music": 0,
   "sid": 22,
   "to": 84.34
  },
  {
   "content": "无法完成投篮",
   "from": 84.34,
   "location": 2,
   "music": 0,
   "sid": 23,
   "to": 85.7
  },
  {
   "content": "投篮前准备良好",
   "from": 85.7,
   "location": 2,
   "music": 0,
   "sid": 24,
   "to": 87.1
  },
  {
   "content": "双脚稍分保持平衡",
   "from": 87.1,
   "location": 2,
   "music": 0,
   "sid": 25,
   "to": 90.88
  },
  {
   "content": "弯曲膝盖",
   "from": 90.88,
   "location": 2,
   "music": 0,
   "sid": 26,
   "to": 91.62
  },
  {
   "content": "然后准备好投篮",
   "from": 91.62,
   "location": 2,
   "music": 0,
   "sid": 27,
   "to": 94.24
  },
  {
   "content": "下一个问题是最后触球动作",
   "from": 101.26,
   "location": 2,
   "music": 0,
   "sid": 28,
   "to": 104.3
  },
  {
   "content": "这是脚跟-脚尖过渡",
   "from": 104.3,
   "location": 2,
   "music": 0,
   "sid": 29,
   "to": 106.53
  },
  {
   "content": "然后跳跃时完成最后一步从脚跟到脚尖",
   "from": 106.53,
   "location": 2,
   "music": 0,
   "sid": 30,
   "to": 113.13
  },
  {
   "content": "平衡至关重要",
   "from": 113.13,
   "location": 2,
   "music": 0,
   "sid": 31,
   "to": 115.75
  },
  {
   "content": "我们进行两步脚步动作",
   "from": 115.75,
   "location": 2,
   "music": 0,
   "sid": 32,
   "to": 118.58
  },
  {
   "content": "或这是跳步停顿",
   "from": 118.58,
   "location": 2,
   "music": 0,
   "sid": 33,
   "to": 121.04
  },
  {
   "content": "尝试从双脚位置投篮",
   "from": 121.04,
   "location": 2,
   "music": 0,
   "sid": 34,
   "to": 125.48
  },
  {
   "content": "下一个问题是球离身体过远",
   "from": 131.66,
   "location": 2,
   "music": 0,
   "sid": 35,
   "to": 135.42
  },
  {
   "content": "球越贴近身体越好",
   "from": 135.42,
   "location": 2,
   "music": 0,
   "sid": 36,
   "to": 137.73
  },
  {
   "content": "球在上升时会改变方向",
   "from": 137.73,
   "location": 2,
   "music": 0,
   "sid": 37,
   "to": 140.35
  },
  {
   "content": "释放会更流畅",
   "from": 140.35,
   "location": 2,
   "music": 0,
   "sid": 38,
   "to": 143.22
  },
  {
   "content": "动作方向性也会更好",
   "from": 143.22,
   "location": 2,
   "music": 0,
   "sid": 39,
   "to": 148.92
  },
  {
   "content": "下一个问题是抬球过慢",
   "from": 153.3,
   "location": 2,
   "music": 0,
   "sid": 40,
   "to": 156.56
  },
  {
   "content": "这容易吗",
   "from": 156.56,
   "location": 2,
   "music": 0,
   "sid": 41,
   "to": 157.28
  },
  {
   "content": "抬球越快",
   "from": 157.28,
   "location": 2,
   "music": 0,
   "sid": 42,
   "to": 158.76
  },
  {
   "content": "能量越充足",
   "from": 158.76,
   "location": 2,
   "music": 0,
   "sid": 43,
   "to": 159.72
  },
  {
   "content": "将力量传递给球",
   "from": 159.72,
   "location": 2,
   "music": 0,
   "sid": 44,
   "to": 160.88
  },
  {
   "content": "从而实现三分球甚至更远投射",
   "from": 160.88,
   "location": 2,
   "music": 0,
   "sid": 45,
   "to": 164.88
  },
  {
   "content": "抬球必须迅速",
   "from": 164.88,
   "location": 2,
   "music": 0,
   "sid": 46,
   "to": 167.7
  },
  {
   "content": "这也与前一点相关",
   "from": 167.7,
   "location": 2,
   "music": 0,
   "sid": 47,
   "to": 170.08
  },
  {
   "content": "观察球离手越慢",
   "from": 170.08,
   "location": 2,
   "music": 0,
   "sid": 48,
   "to": 173.64
  },
  {
   "content": "抬球越快",
   "from": 173.64,
   "location": 2,
   "music": 0,
   "sid": 49,
   "to": 175.98
  },
  {
   "content": "十五天纠正正确",
   "from": 179.22,
   "location": 2,
   "music": 0,
   "sid": 50,
   "to": 180.97
  },
  {
   "content": "应通知课程",
   "from": 180.97,
   "location": 2,
   "music": 0,
   "sid": 51,
   "to": 181.89
  },
  {
   "content": "十五天三次投篮练习",
   "from": 181.89,
   "location": 2,
   "music": 0,
   "sid": 52,
   "to": 183.37
  },
  {
   "content": "当然",
   "from": 183.37,
   "location": 2,
   "music": 0,
   "sid": 53,
   "to": 183.75
  },
  {
   "content": "如果你对此有疑问",
   "from": 183.75,
   "location": 2,
   "music": 0,
   "sid": 54,
   "to": 185.27
  },
  {
   "content": "去查看他们的课程",
   "from": 185.27,
   "location": 2,
   "music": 0,
   "sid": 55,
   "to": 186.19
  },
  {
   "content": "帮助了千人",
   "from": 186.19,
   "location": 2,
   "music": 0,
   "sid": 56,
   "to": 187.49
  },
  {
   "content": "并将助你持续进步",
   "from": 187.49,
   "location": 2,
   "music": 0,
   "sid": 57,
   "to": 189.84
  },
  {
   "content": "问题六：抬碗过高超过头顶",
   "from": 189.84,
   "location": 2,
   "music": 0,
   "sid": 58,
   "to": 193.38
  },
  {
   "content": "然后试图将球投得更高",
   "from": 193.38,
   "location": 2,
   "music": 0,
   "sid": 59,
   "to": 195.72
  },
  {
   "content": "球在头顶上方",
   "from": 195.72,
   "location": 2,
   "music": 0,
   "sid": 60,
   "to": 197.06
  },
  {
   "content": "肘部伸展越少",
   "from": 197.06,
   "location": 2,
   "music": 0,
   "sid": 61,
   "to": 200.519
  },
  {
   "content": "肘部产生的能量就越少",
   "from": 200.519,
   "location": 2,
   "music": 0,
   "sid": 62,
   "to": 203.879
  },
  {
   "content": "低球更长",
   "from": 203.879,
   "location": 2,
   "music": 0,
   "sid": 63,
   "to": 206.659
  },
  {
   "content": "肘部伸展动作",
   "from": 206.659,
   "location": 2,
   "music": 0,
   "sid": 64,
   "to": 208.72
  },
  {
   "content": "将产生更多投射力量",
   "from": 208.72,
   "location": 2,
   "music": 0,
   "sid": 65,
   "to": 212.22
  },
  {
   "content": "并允许我们在三分线外更远投篮",
   "from": 212.22,
   "location": 2,
   "music": 0,
   "sid": 66,
   "to": 216.1
  },
  {
   "content": "高个子约两米身高",
   "from": 216.1,
   "location": 2,
   "music": 0,
   "sid": 67,
   "to": 217.86
  },
  {
   "content": "单手即可完成",
   "from": 217.86,
   "location": 2,
   "music": 0,
   "sid": 68,
   "to": 219.62
  },
  {
   "content": "但观看我视频的大多数人",
   "from": 219.62,
   "location": 2,
   "music": 0,
   "sid": 69,
   "to": 221.9
  },
  {
   "content": "我不是高个子",
   "from": 221.9,
   "location": 2,
   "music": 0,
   "sid": 70,
   "to": 223.16
  },
  {
   "content": "将球放低些并开始在此处伸肘",
   "from": 223.16,
   "location": 2,
   "music": 0,
   "sid": 71,
   "to": 228.1
  },
  {
   "content": "我们出手时机太晚",
   "from": 232.46,
   "location": 2,
   "music": 0,
   "sid": 72,
   "to": 234.68
  },
  {
   "content": "有效将能量从脚部传递至球",
   "from": 234.68,
   "location": 2,
   "music": 0,
   "sid": 73,
   "to": 238.31
  },
  {
   "content": "我们需要更流畅",
   "from": 238.31,
   "location": 2,
   "music": 0,
   "sid": 74,
   "to": 239.77
  },
  {
   "content": "最好的做法是开始",
   "from": 239.77,
   "location": 2,
   "music": 0,
   "sid": 75,
   "to": 242.13
  },
  {
   "content": "上抬时伸展肘部",
   "from": 242.13,
   "location": 2,
   "music": 0,
   "sid": 76,
   "to": 246.03
  },
  {
   "content": "这样不会中断能量传递",
   "from": 246.03,
   "location": 2,
   "music": 0,
   "sid": 77,
   "to": 248.77
  },
  {
   "content": "投篮会更轻松自如",
   "from": 248.77,
   "location": 2,
   "music": 0,
   "sid": 78,
   "to": 252.98
  },
  {
   "content": "下一个问题是投篮时",
   "from": 256.259,
   "location": 2,
   "music": 0,
   "sid": 79,
   "to": 257.879
  },
  {
   "content": "肘部未完全伸展",
   "from": 257.879,
   "location": 2,
   "music": 0,
   "sid": 80,
   "to": 260.58
  },
  {
   "content": "手臂的笔直度",
   "from": 260.58,
   "location": 2,
   "music": 0,
   "sid": 81,
   "to": 262.48
  },
  {
   "content": "首先给出投篮方向",
   "from": 262.48,
   "location": 2,
   "music": 0,
   "sid": 82,
   "to": 265.22
  },
  {
   "content": "像交易员和锁紧手臂让球直入篮筐",
   "from": 265.22,
   "location": 2,
   "music": 0,
   "sid": 83,
   "to": 271.78
  },
  {
   "content": "第二个原因是",
   "from": 271.78,
   "location": 2,
   "music": 0,
   "sid": 84,
   "to": 273.02
  },
  {
   "content": "当然",
   "from": 273.02,
   "location": 2,
   "music": 0,
   "sid": 85,
   "to": 273.48
  },
  {
   "content": "若肘部不动能量链会中断",
   "from": 273.48,
   "location": 2,
   "music": 0,
   "sid": 86,
   "to": 278.82
  },
  {
   "content": "从肩到腕的全身能量",
   "from": 278.82,
   "location": 2,
   "music": 0,
   "sid": 87,
   "to": 281.9
  },
  {
   "content": "此动作需完全伸展肘部",
   "from": 281.9,
   "location": 2,
   "music": 0,
   "sid": 88,
   "to": 286.5
  },
  {
   "content": "下一个问题是需从指尖释放球",
   "from": 289.6,
   "location": 2,
   "music": 0,
   "sid": 89,
   "to": 293.12
  },
  {
   "content": "而非手腕",
   "from": 293.12,
   "location": 2,
   "music": 0,
   "sid": 90,
   "to": 294.32
  },
  {
   "content": "我发现许多球员投前未牢固握球",
   "from": 294.32,
   "location": 2,
   "music": 0,
   "sid": 91,
   "to": 299
  },
  {
   "content": "这阻碍了指尖释放球并产生良好旋转",
   "from": 299,
   "location": 2,
   "music": 0,
   "sid": 92,
   "to": 304.04
  },
  {
   "content": "为精准投篮",
   "from": 304.04,
   "location": 2,
   "music": 0,
   "sid": 93,
   "to": 305.02
  },
  {
   "content": "许多球员仅这样按住球",
   "from": 305.02,
   "location": 2,
   "music": 0,
   "sid": 94,
   "to": 308.62
  },
  {
   "content": "投前准备时",
   "from": 308.62,
   "location": 2,
   "music": 0,
   "sid": 95,
   "to": 310.5
  },
  {
   "content": "轻握球",
   "from": 310.5,
   "location": 2,
   "music": 0,
   "sid": 96,
   "to": 311.86
  },
  {
   "content": "用指尖紧握球以增强灵敏度和控球",
   "from": 311.86,
   "location": 2,
   "music": 0,
   "sid": 97,
   "to": 315.9
  },
  {
   "content": "此时将从指尖释放球",
   "from": 315.9,
   "location": 2,
   "music": 0,
   "sid": 98,
   "to": 319.93
  },
  {
   "content": "球会自带旋转",
   "from": 319.93,
   "location": 2,
   "music": 0,
   "sid": 99,
   "to": 323.55
  },
  {
   "content": "最后最重要细节及所有问题",
   "from": 326.22,
   "location": 2,
   "music": 0,
   "sid": 100,
   "to": 330.12
  },
  {
   "content": "如果你从技术层面解决它",
   "from": 330.12,
   "location": 2,
   "music": 0,
   "sid": 101,
   "to": 331.8
  },
  {
   "content": "没有这一点就无法有效运作",
   "from": 331.8,
   "location": 2,
   "music": 0,
   "sid": 102,
   "to": 335.54
  },
  {
   "content": "这是射手最基本的常识",
   "from": 335.54,
   "location": 2,
   "music": 0,
   "sid": 103,
   "to": 338.88
  },
  {
   "content": "你需要投篮",
   "from": 338.88,
   "location": 2,
   "music": 0,
   "sid": 104,
   "to": 341.14
  },
  {
   "content": "非常多",
   "from": 341.14,
   "location": 2,
   "music": 0,
   "sid": 105,
   "to": 341.86
  },
  {
   "content": "你需要投篮",
   "from": 341.86,
   "location": 2,
   "music": 0,
   "sid": 106,
   "to": 343.16
  },
  {
   "content": "很多",
   "from": 343.16,
   "location": 2,
   "music": 0,
   "sid": 107,
   "to": 343.5
  },
  {
   "content": "非常多",
   "from": 343.5,
   "location": 2,
   "music": 0,
   "sid": 108,
   "to": 344.22
  },
  {
   "content": "成千上万次",
   "from": 344.22,
   "location": 2,
   "music": 0,
   "sid": 109,
   "to": 346.02
  },
  {
   "content": "我有客户拥有完美的投篮姿势",
   "from": 346.02,
   "location": 2,
   "music": 0,
   "sid": 110,
   "to": 348.6
  },
  {
   "content": "但他们仍然无法进球",
   "from": 348.6,
   "location": 2,
   "music": 0,
   "sid": 111,
   "to": 351.06
  },
  {
   "content": "仅仅因为练习次数不够",
   "from": 351.06,
   "location": 2,
   "music": 0,
   "sid": 112,
   "to": 354.08
  },
  {
   "content": "你感觉不到与篮筐的距离",
   "from": 354.08,
   "location": 2,
   "music": 0,
   "sid": 113,
   "to": 357.75
  },
  {
   "content": "你在场上的位置",
   "from": 357.75,
   "location": 2,
   "music": 0,
   "sid": 114,
