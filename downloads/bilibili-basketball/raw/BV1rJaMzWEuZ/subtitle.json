   "location": 2,
   "music": 0,
   "sid": 231,
   "to": 460.28
  },
  {
   "content": "第三种方法是同脚停球后做交叉步",
   "from": 460.28,
   "location": 2,
   "music": 0,
   "sid": 232,
   "to": 464.16
  },
  {
   "content": "同样是同样的动作",
   "from": 464.16,
   "location": 2,
   "music": 0,
   "sid": 233,
   "to": 466.1
  },
  {
   "content": "如果你想做交叉步",
   "from": 466.1,
   "location": 2,
   "music": 0,
   "sid": 234,
   "to": 467.56
  },
  {
   "content": "确保有空间",
   "from": 467.56,
   "location": 2,
   "music": 0,
   "sid": 235,
   "to": 468.78
  },
  {
   "content": "所以你要侧身",
   "from": 468.78,
   "location": 2,
   "music": 0,
   "sid": 236,
   "to": 469.5
  },
  {
   "content": "像这样球和内脚背球和同侧脚",
   "from": 469.5,
   "location": 2,
   "music": 0,
   "sid": 237,
   "to": 473
  },
  {
   "content": "注意球在后方被保护",
