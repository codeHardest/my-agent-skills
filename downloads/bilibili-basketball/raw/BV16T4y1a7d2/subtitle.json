{
 "font_size": 0.4,
 "font_color": "#FFFFFF",
 "background_alpha": 0.5,
 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "a1.3.0.2",
 "body": [
  {
   "from": 1.42,
   "to": 2.08,
   "sid": 1,
   "location": 2,
   "content": "一"
  },
  {
   "from": 4.84,
   "to": 8.24,
   "sid": 2,
   "location": 2,
   "content": "今天给大家分享运球投篮"
  },
  {
   "from": 11.16,
   "to": 13.64,
   "sid": 3,
   "location": 2,
   "content": "原地的投篮可能大家已经会了"
  },
  {
   "from": 13.68,
   "to": 16.92,
   "sid": 4,
   "location": 2,
   "content": "但是像我一样各种衔接运球的丝滑投篮"
  },
  {
   "from": 16.92,
   "to": 18.54,
   "sid": 5,
   "location": 2,
   "content": "有可能很多人还不会"
  },
  {
   "from": 18.54,
   "to": 20.16,
   "sid": 6,
   "location": 2,
   "content": "或者说会的不精"
  },
  {
   "from": 20.16,
   "to": 21.3,
   "sid": 7,
   "location": 2,
   "content": "不够丝滑"
  },
  {
   "from": 21.32,
   "to": 23.51,
   "sid": 8,
   "location": 2,
   "content": "甚至总感觉哪里很别扭"
  },
  {
   "from": 23.51,
   "to": 28.24,
   "sid": 9,
   "location": 2,
   "content": "今天就给大家分享一下如何拥有一个丝滑的运球投篮"
  },
  {
   "from": 29.1,
   "to": 33.32,
   "sid": 10,
   "location": 2,
   "content": "第一个我们先从原地投篮的基础上进阶到原地运球"
  },
  {
   "from": 33.32,
   "to": 34.25,
   "sid": 11,
   "location": 2,
   "content": "合球投篮"
  },
  {
   "from": 34.25,
   "to": 37.1,
   "sid": 12,
   "location": 2,
   "content": "首先我们运球的高度要在我们的腰间"
  },
  {
   "from": 37.1,
   "to": 38.27,
   "sid": 13,
   "location": 2,
   "content": "如果运得过底"
  },
  {
   "from": 38.27,
   "to": 39.6,
   "sid": 14,
   "location": 2,
   "content": "你会很难去合球"
  },
  {
   "from": 39.66,
   "to": 42.5,
   "sid": 15,
   "location": 2,
   "content": "然后我们不要做这种脚不动的运球"
  },
  {
   "from": 42.5,
   "to": 45.62,
   "sid": 16,
   "location": 2,
   "content": "我们要跳起来做这种前后坠步胯下"
  },
  {
   "from": 45.64,
   "to": 47.71,
   "sid": 17,
   "location": 2,
   "content": "然后加上大力运球"
  },
  {
   "from": 47.71,
   "to": 50.5,
   "sid": 18,
   "location": 2,
   "content": "无论是左侧合球还是右侧合球"
  },
  {
   "from": 50.5,
   "to": 53.96,
   "sid": 19,
   "location": 2,
   "content": "最终都把球合到你原地投篮球的合球点"
  },
  {
   "from": 53.96,
   "to": 57.02,
   "sid": 20,
   "location": 2,
   "content": "熟练了一次运球就可以进阶为两次运球"
  },
  {
   "from": 57.02,
   "to": 59.38,
   "sid": 21,
   "location": 2,
   "content": "而很多人合球合不明白"
  },
  {
   "from": 59.4,
   "to": 61.11,
   "sid": 22,
   "location": 2,
   "content": "当球在左手的时候"
  },
  {
   "from": 61.11,
   "to": 62.91,
   "sid": 23,
   "location": 2,
   "content": "是左手把球推回中间"
  },
  {
   "from": 62.91,
   "to": 64.65,
   "sid": 24,
   "location": 2,
   "content": "右手直接去摁在球上"
  },
  {
   "from": 64.65,
   "to": 67.2,
   "sid": 25,
   "location": 2,
   "content": "而此时手腕已经和投篮状态一样"
  },
  {
   "from": 67.2,
   "to": 68.76,
   "sid": 26,
   "location": 2,
   "content": "是一个弯着的状态"
  },
  {
   "from": 68.78,
   "to": 71.12,
   "sid": 27,
   "location": 2,
   "content": "右侧合球是右手推着球过去"
  },
  {
   "from": 71.12,
   "to": 72.06,
   "sid": 28,
   "location": 2,
   "content": "左手找球"
  },
  {
   "from": 72.06,
   "to": 74.1,
   "sid": 29,
   "location": 2,
   "content": "而在左手触碰球的一瞬间"
  },
  {
   "from": 74.1,
   "to": 75.48,
   "sid": 30,
   "location": 2,
   "content": "右手有一个转弯"
  },
  {
   "from": 75.5,
   "to": 76.64,
   "sid": 31,
   "location": 2,
   "content": "这样也是成功的"
  },
  {
   "from": 76.64,
   "to": 78.44,
   "sid": 32,
   "location": 2,
   "content": "直接到达了一个投篮预备状态"
  },
  {
   "from": 78.44,
   "to": 80.9,
   "sid": 33,
   "location": 2,
   "content": "接下来我们进阶行进间的运球投篮"
  },
  {
   "from": 80.92,
   "to": 83.26,
   "sid": 34,
   "location": 2,
   "content": "那原地运球投篮和行进间运球投篮"
  },
  {
   "from": 83.26,
   "to": 84.34,
   "sid": 35,
   "location": 2,
   "content": "他俩有什么区别呢"
  },
  {
   "from": 84.34,
   "to": 87.58,
   "sid": 36,
   "location": 2,
   "content": "你会发现行进间运球投篮的屈髋程度更大一些"
  },
  {
   "from": 87.58,
   "to": 89.47,
   "sid": 37,
   "location": 2,
   "content": "只有这样才能刹住车"
  },
  {
   "from": 89.47,
   "to": 91.82,
   "sid": 38,
   "location": 2,
   "content": "将向前的力转化为向上的力"
  },
  {
   "from": 91.84,
   "to": 95.38,
   "sid": 39,
   "location": 2,
   "content": "我们第一个练的就是这个急停屈髋上前的制动"
  },
  {
   "from": 95.38,
   "to": 97.34,
   "sid": 40,
   "location": 2,
   "content": "脚一定要全脚掌踩实的地"
  },
  {
   "from": 97.36,
   "to": 99.24,
   "sid": 41,
   "location": 2,
   "content": "整个人的重心尽量靠后"
  },
  {
   "from": 99.24,
   "to": 100.98,
   "sid": 42,
   "location": 2,
   "content": "就像突然坐到一个凳子上"
  },
  {
   "from": 100.98,
   "to": 103.29,
   "sid": 43,
   "location": 2,
   "content": "合球也是右手直接摁在球上"
  },
  {
   "from": 103.29,
   "to": 104.28,
   "sid": 44,
   "location": 2,
   "content": "运球的时候"
  },
  {
   "from": 104.28,
   "to": 106.47,
   "sid": 45,
   "location": 2,
   "content": "球尽量保证与身体在同一平面"
  },
  {
   "from": 106.47,
   "to": 108.14,
   "sid": 46,
   "location": 2,
   "content": "这样更方便合球"
  },
  {
   "from": 108.16,
   "to": 111.46,
   "sid": 47,
   "location": 2,
   "content": "而和球的关键都是球尽量靠近身体"
  },
  {
   "from": 111.46,
   "to": 112.87,
   "sid": 48,
   "location": 2,
   "content": "在合球的时候"
  },
  {
   "from": 112.87,
   "to": 115.96,
   "sid": 49,
   "location": 2,
   "content": "手臂的夹角就已经和投篮时的手臂夹角差不多"
  },
  {
   "from": 115.96,
   "to": 117.7,
   "sid": 50,
   "location": 2,
   "content": "而且手腕已经在弯曲状态"
  },
  {
   "from": 117.7,
   "to": 119.34,
   "sid": 51,
   "location": 2,
   "content": "就是一个投篮预备状态"
  },
  {
   "from": 119.34,
   "to": 120.9,
   "sid": 52,
   "location": 2,
   "content": "与左侧不同的是"
  },
  {
   "from": 120.9,
   "to": 121.98,
   "sid": 53,
   "location": 2,
   "content": "右侧的运球投篮"
  },
  {
   "from": 121.98,
   "to": 125.52,
   "sid": 54,
   "location": 2,
   "content": "另一个细节就是及时让我自己的肩肘对向篮筐"
  },
  {
   "from": 125.54,
   "to": 128.9,
   "sid": 55,
   "location": 2,
   "content": "因为左侧绝大多数时候肩肘就已经对下篮筐了"
  },
  {
   "from": 128.9,
   "to": 130.43,
   "sid": 56,
   "location": 2,
   "content": "而右侧需要自己去调整"
  },
  {
   "from": 130.43,
   "to": 132.4,
   "sid": 57,
   "location": 2,
   "content": "这样才能让你的出手更加的正"
  },
  {
   "from": 132.4,
   "to": 134.83,
   "sid": 58,
   "location": 2,
   "content": "然后我们再来细看这些动作"
  },
  {
   "from": 134.83,
   "to": 137.18,
   "sid": 59,
   "location": 2,
   "content": "这是一个行进间的合球投篮"
  },
  {
   "from": 137.22,
   "to": 139.32,
   "sid": 60,
   "location": 2,
   "content": "全球器官就非常的多"
  },
  {
   "from": 139.32,
   "to": 142.44,
   "sid": 61,
   "location": 2,
   "content": "这个算是一个原地运球的合球投篮"
  },
  {
   "from": 142.74,
   "to": 144.62,
   "sid": 62,
   "location": 2,
   "content": "七款就没有那么的多"
  },
  {
   "from": 145.8,
   "to": 148.73,
   "sid": 63,
   "location": 2,
   "content": "这种脚步调整的都属于原地运球投篮"
  },
  {
   "from": 148.73,
   "to": 149.84,
   "sid": 64,
   "location": 2,
   "content": "知道这些细节了"
  },
  {
   "from": 149.84,
   "to": 151.28,
   "sid": 65,
   "location": 2,
   "content": "大家就可以多加练习了"
  },
  {
   "from": 151.28,
   "to": 153.64,
   "sid": 66,
   "location": 2,
   "content": "也祝大家拥有一个丝滑的运球投篮"
  }
 ]
}