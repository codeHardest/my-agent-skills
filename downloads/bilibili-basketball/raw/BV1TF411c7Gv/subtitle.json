 "version": "sync-en-v1.2.0.4-t0.3.c",
 "body": [
  {
   "from": 0.12,
   "to": 2.26,
   "sid": 1,
   "location": 2,
   "content": "马库斯和IB精英们在这里"
  },
  {
   "from": 2.26,
   "to": 4.98,
   "sid": 2,
   "location": 2,
   "content": "今天我们要学习如何掌握引体向上"
  },
  {
   "from": 4.98,
   "to": 6.18,
   "sid": 3,
   "location": 2,
   "content": "运球步"
  },
  {
   "from": 6.18,
   "to": 7.42,
   "sid": 4,
   "location": 2,
   "content": "当我进攻的时候"
  },
  {
   "from": 7.42,
   "to": 9,
   "sid": 5,
   "location": 2,
   "content": "它总是会在里面"
  },
  {
   "from": 9,
   "to": 11.2,
   "sid": 6,
   "location": 2,
   "content": "但在我左手的蛋蛋上"
  },
  {
   "from": 11.2,
   "to": 12.79,
   "sid": 7,
   "location": 2,
   "content": "这一切都会是"
  },
  {
   "from": 13.39,
   "to": 15.95,
   "sid": 8,
   "location": 2,
   "content": "但正如我所说的"
  },
  {
   "from": 15.95,
   "to": 18.61,
   "sid": 9,
   "location": 2,
   "content": "这是你的三次练习"
  },
  {
   "from": 18.61,
   "to": 20.93,
   "sid": 10,
   "location": 2,
   "content": "然后再一次拿起"
  },
  {
   "from": 20.93,
   "to": 24.26,
   "sid": 11,
   "location": 2,
   "content": "你可以在任何状态下工作三倍"
  },
  {
   "from": 24.54,
   "to": 29,
   "sid": 12,
   "location": 2,
   "content": "我只需要去攻击我的投篮"
  },
  {
   "from": 29,
   "to": 32.15,
   "sid": 13,
   "location": 2,
   "content": "最后一个是保持你的身体低"
  },
  {
   "from": 32.15,
   "to": 34.35,
   "sid": 14,
   "location": 2,
   "content": "你就不能投篮了"
  },
  {
   "from": 34.35,
   "to": 35.65,
   "sid": 15,
   "location": 2,
   "content": "如果你的胸部"
  },
  {
   "from": 35.65,
   "to": 37.71,
   "sid": 16,
   "location": 2,
   "content": "也许一对一比赛的唯一一件事"
  },
  {
   "from": 37.71,
   "to": 39.09,
   "sid": 17,
   "location": 2,
   "content": "这将是调整"
  },
  {
   "from": 39.09,
   "to": 40.89,
   "sid": 18,
   "location": 2,
   "content": "一直在走的前端"
  },
  {
   "from": 40.89,
   "to": 42.77,
   "sid": 19,
   "location": 2,
   "content": "我的胸部现在是这样的"
  },
  {
   "from": 42.77,
   "to": 43.67,
   "sid": 20,
   "location": 2,
   "content": "我们要进行手术"
  },
  {
   "from": 43.67,
   "to": 45.24,
   "sid": 21,
   "location": 2,
   "content": "对我的内心来说很低"
  },
  {
   "from": 45.24,
   "to": 46.1,
   "sid": 22,
   "location": 2,
   "content": "在我的肩膀上"
  },
  {
   "from": 46.1,
   "to": 47.88,
   "sid": 23,
   "location": 2,
   "content": "侧面让他的臀部"
  },
  {
   "from": 47.88,
   "to": 49.81,
   "sid": 24,
   "location": 2,
   "content": "现在它会打印角度"
  },
  {
   "from": 49.81,
   "to": 51.39,
   "sid": 25,
   "location": 2,
   "content": "看起来我在开车"
  },
  {
   "from": 51.39,
   "to": 53.03,
   "sid": 26,
   "location": 2,
   "content": "直接拉上来"
  },
  {
   "from": 53.03,
   "to": 55.75,
   "sid": 27,
   "location": 2,
   "content": "你会看到很多恩德斯张开臀部"
  },
  {
   "from": 55.75,
   "to": 57.23,
   "sid": 28,
   "location": 2,
   "content": "他们认为你会开车"
  },
  {
   "from": 57.23,
   "to": 60.37,
   "sid": 29,
   "location": 2,
   "content": "你知道在哪里拉起来创造空间"
  },
  {
   "from": 60.37,
   "to": 61.57,
   "sid": 30,
   "location": 2,
   "content": "不然你就拉上来"
  },
  {
   "from": 61.57,
   "to": 63.05,
   "sid": 31,
   "location": 2,
   "content": "你就是这么问的"
  },
  {
   "from": 79.55,
   "to": 83.23,
   "sid": 32,
   "location": 2,
   "content": "所以三重计时将是极其重要的，也是伟大的"
  },
  {
   "from": 83.23,
   "to": 87.6,
   "sid": 33,
   "location": 2,
   "content": "我看到很多球员完全三倍于第三帧"
  },
  {
   "from": 87.6,
   "to": 88.12,
   "sid": 34,
   "location": 2,
   "content": "就在这里"
  },
  {
   "from": 88.12,
   "to": 90.22,
   "sid": 35,
   "location": 2,
   "content": "你注意到了吗？我在右边的中心运球"
  },
  {
   "from": 90.22,
   "to": 92.28,
   "sid": 36,
   "location": 2,
   "content": "我不能很低"
  },
  {
   "from": 92.28,
   "to": 97.23,
   "sid": 37,
   "location": 2,
   "content": "一个低杠杆试图从更多的关注中得到我的一个"
  },
  {
   "from": 97.23,
   "to": 99.66,
   "sid": 38,
   "location": 2,
   "content": "确保我们在大脑之外滴水"
  },
  {
   "from": 99.76,
   "to": 101.4,
   "sid": 39,
   "location": 2,
   "content": "第二部分是"
  },
  {
   "from": 102.6,
   "to": 104.6,
   "sid": 40,
   "location": 2,
   "content": "所以现在我的奶油外面翻了三倍"
  },
  {
   "from": 104.6,
   "to": 106.02,
   "sid": 41,
   "location": 2,
   "content": "当我开始收集"
  },
  {
   "from": 106.02,
   "to": 109.62,
   "sid": 42,
   "location": 2,
   "content": "我想聚集作为我的最后一只脚"
  },
  {
   "from": 109.62,
   "to": 111.8,
   "sid": 43,
   "location": 2,
   "content": "也就是我的右脚开始变短"
  },
  {
   "from": 111.8,
   "to": 113.18,
   "sid": 44,
   "location": 2,
   "content": "所以这将是我的皮卡"
  },
  {
   "from": 113.18,
   "to": 115.31,
   "sid": 45,
   "location": 2,
   "content": "用我的运球时间计时"
  },
  {
   "from": 115.31,
   "to": 116.25,
   "sid": 46,
   "location": 2,
   "content": "所以我开车"
  },
  {
   "from": 116.25,
   "to": 117.63,
   "sid": 47,
   "location": 2,
   "content": "我有一个引体向上"
  },
  {
   "from": 117.63,
   "to": 119.07,
   "sid": 48,
   "location": 2,
   "content": "我要进去了"
  },
  {
   "from": 119.07,
   "to": 122.05,
   "sid": 49,
   "location": 2,
   "content": "然后我要去得到一个小弹出"
  },
  {
   "from": 122.05,
   "to": 123.34,
   "sid": 50,
   "location": 2,
   "content": "看一下"
  },
  {
   "from": 126.68,
   "to": 128.4,
   "sid": 51,
   "location": 2,
   "content": "别让我离开你的眼睛"
  },
  {
   "from": 132.2,
   "to": 133.04,
   "sid": 52,
   "location": 2,
   "content": "我告诉你这个"
  },
  {
   "from": 133.04,
   "to": 134.56,
   "sid": 53,
   "location": 2,
   "content": "我什么时候去"
  },
  {
   "from": 134.56,
   "to": 135.86,
   "sid": 54,
   "location": 2,
   "content": "我去"
  },
  {
   "from": 138.21,
   "to": 139.55,
   "sid": 55,
   "location": 2,
   "content": "捣碎的时候你把它拉起来"
  },
  {
   "from": 139.55,
   "to": 140.85,
   "sid": 56,
   "location": 2,
   "content": "并不总是一次运球"
  },
  {
   "from": 140.85,
   "to": 143.27,
   "sid": 57,
   "location": 2,
   "content": "有时可能是两三次运球"
  },
  {
   "from": 143.27,
   "to": 146.34,
   "sid": 58,
   "location": 2,
   "content": "这就是驾驶空间的重要性"
  },
  {
   "from": 146.34,
   "to": 147.84,
   "sid": 59,
   "location": 2,
   "content": "驾驶一个空间将是"
  },
  {
   "from": 147.84,
   "to": 150.62,
   "sid": 60,
   "location": 2,
   "content": "我想让你想想开阔的空间或开阔的水域"
  },
  {
   "from": 150.62,
   "to": 152.19,
   "sid": 61,
   "location": 2,
   "content": "防守者在哪里"
  },
  {
   "from": 152.19,
   "to": 154.63,
   "sid": 62,
   "location": 2,
   "content": "射手能够定位空地"
  },
  {
   "from": 154.63,
   "to": 155.89,
   "sid": 63,
   "location": 2,
   "content": "很快就打到了那里"
  },
  {
   "from": 155.89,
   "to": 158.19,
   "sid": 64,
   "location": 2,
   "content": "有节奏地射击所有的球"
  },
  {
   "from": 158.19,
   "to": 160.09,
   "sid": 65,
   "location": 2,
   "content": "持球击倒"
  },
  {
   "from": 160.09,
   "to": 162.23,
   "sid": 66,
   "location": 2,
   "content": "我们将在空间中关注这一点"
  },
  {
   "from": 162.23,
   "to": 163.34,
   "sid": 67,
   "location": 2,
   "content": "不会开枪的"
  },
  {
   "from": 163.34,
   "to": 165.82,
   "sid": 68,
   "location": 2,
   "content": "就像我所有的战斗一样"
  },
  {
   "from": 165.82,
   "to": 166.76,
   "sid": 69,
   "location": 2,
   "content": "我做对了"
  },
  {
   "from": 166.76,
   "to": 167.96,
   "sid": 70,
   "location": 2,
   "content": "不要尝试"
  },
  {
   "from": 167.96,
   "to": 168.18,
   "sid": 71,
   "location": 2,
   "content": "现在"
  },
  {
   "from": 168.18,
   "to": 169.44,
   "sid": 72,
   "location": 2,
   "content": "你过着生活"
  },
  {
   "from": 169.44,
   "to": 170.62,
   "sid": 73,
   "location": 2,
   "content": "我喜欢"
  },
  {
   "from": 170.62,
   "to": 172.52,
   "sid": 74,
   "location": 2,
   "content": "我现在感觉好多了"
  },
  {
   "from": 172.52,
   "to": 173.44,
   "sid": 75,
   "location": 2,
   "content": "我醒来时"
  },
  {
   "from": 173.44,
   "to": 174.56,
   "sid": 76,
   "location": 2,
   "content": "像一段很长的路"
  },
  {
   "from": 176,
   "to": 177.62,
   "sid": 77,
   "location": 2,
   "content": "永远不要说话的方式"
  }
 ]
}