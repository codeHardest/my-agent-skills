 "body": [
  {
   "from": 0,
   "to": 1.35,
   "sid": 1,
   "location": 2,
   "content": "这是我几年前的运球",
   "music": 0
  },
  {
   "from": 1.35,
   "to": 2.94,
   "sid": 2,
   "location": 2,
   "content": "虽然动作多且连贯",
   "music": 0
  },
  {
   "from": 2.94,
   "to": 4.32,
   "sid": 3,
   "location": 2,
   "content": "但绝对谈不上技术好",
   "music": 0
  },
  {
   "from": 4.32,
   "to": 5.49,
   "sid": 4,
   "location": 2,
   "content": "如果你悟性一般",
   "music": 0
  },
  {
   "from": 5.49,
   "to": 6.78,
   "sid": 5,
   "location": 2,
   "content": "运球全靠自学",
   "music": 0
  },
  {
   "from": 6.78,
   "to": 9,
   "sid": 6,
   "location": 2,
   "content": "基本就这个水平很难再提升了",
   "music": 0
  },
  {
   "from": 9,
   "to": 10.08,
   "sid": 7,
   "location": 2,
   "content": "这是我去年的运球",
   "music": 0
  },
  {
   "from": 10.08,
   "to": 11.19,
   "sid": 8,
   "location": 2,
   "content": "都有一些基本动作",
   "music": 0
  },
  {
   "from": 11.19,
   "to": 12.9,
   "sid": 9,
   "location": 2,
   "content": "但只要你对运球有些了解",
   "music": 0
  },
  {
   "from": 12.9,
   "to": 14.28,
   "sid": 10,
   "location": 2,
   "content": "就应该一眼能看出来",
   "music": 0
  },
  {
   "from": 14.28,
   "to": 16.75,
   "sid": 11,
   "location": 2,
   "content": "这是我的技术水平比之前要好了很多",
   "music": 0
  },
  {
   "from": 16.75,
   "to": 19.18,
   "sid": 12,
   "location": 2,
   "content": "那么该如何来提升自己的运球技术呢",
   "music": 0
  },
  {
   "from": 19.18,
   "to": 21.22,
   "sid": 13,
   "location": 2,
   "content": "今天就和大家分享一下我的经验",
   "music": 0
  },
  {
   "from": 21.22,
   "to": 22.15,
   "sid": 14,
   "location": 2,
   "content": "一共有五点",
   "music": 0
  },
  {
   "from": 22.15,
   "to": 22.59,
   "sid": 15,
   "location": 2,
   "content": "一",
   "music": 0
  },
  {
   "from": 22.59,
   "to": 24.24,
   "sid": 16,
   "location": 2,
   "content": "不要用小臂来主导发力",
   "music": 0
  },
  {
   "from": 24.24,
   "to": 25.53,
   "sid": 17,
   "location": 2,
   "content": "小臂主导发力的特点",
   "music": 0
  },
  {
   "from": 25.53,
   "to": 27.24,
   "sid": 18,
   "location": 2,
   "content": "就运球时小臂弯曲明显",
   "music": 0
  },
  {
   "from": 27.24,
   "to": 29.28,
   "sid": 19,
   "location": 2,
   "content": "肩关节没有或者开合较小",
   "music": 0
  },
  {
   "from": 29.28,
   "to": 30.75,
   "sid": 20,
   "location": 2,
   "content": "要用大臂来主导发力",
   "music": 0
  },
  {
   "from": 30.75,
   "to": 32.31,
   "sid": 21,
   "location": 2,
   "content": "小臂跟随大臂摆动",
   "music": 0
  },
  {
   "from": 32.31,
   "to": 33.3,
   "sid": 22,
   "location": 2,
   "content": "弯曲较小",
   "music": 0
  },
  {
   "from": 33.3,
   "to": 35.4,
   "sid": 23,
   "location": 2,
   "content": "二运球时膝盖不要内扣",
   "music": 0
  },
  {
   "from": 35.4,
   "to": 36.81,
   "sid": 24,
   "location": 2,
   "content": "这样会导致下盘不稳",
   "music": 0
  },
  {
   "from": 36.81,
   "to": 38.12,
   "sid": 25,
   "location": 2,
   "content": "且膝关节容易受伤",
   "music": 0
  },
  {
   "from": 38.12,
   "to": 39.44,
   "sid": 26,
   "location": 2,
   "content": "双腿应该脚踏实地",
   "music": 0
  },
  {
   "from": 39.44,
   "to": 42.02,
   "sid": 27,
   "location": 2,
   "content": "呈外八字来保证运球时下肢稳定",
   "music": 0
  },
  {
   "from": 42.02,
   "to": 43.07,
   "sid": 28,
   "location": 2,
   "content": "便于移动",
   "music": 0
  },
  {
   "from": 43.07,
   "to": 45.629,
   "sid": 29,
   "location": 2,
   "content": "三运球时身体不要有倾斜",
   "music": 0
  },
  {
   "from": 45.629,
   "to": 46.229,
   "sid": 30,
   "location": 2,
   "content": "这个问题",
   "music": 0
  },
  {
   "from": 46.229,
   "to": 47.369,
   "sid": 31,
   "location": 2,
   "content": "新手机不注意的话",
   "music": 0
  },
  {
   "from": 47.369,
   "to": 49.26,
   "sid": 32,
   "location": 2,
   "content": "形成肌肉记忆后非常难改",
   "music": 0
  },
  {
   "from": 49.26,
   "to": 51.81,
   "sid": 33,
   "location": 2,
   "content": "我们在运球时一定要保持躯干中立",
   "music": 0
  },
  {
   "from": 51.81,
   "to": 54.3,
   "sid": 34,
   "location": 2,
   "content": "否则在组合运球时很容易引起失误",
   "music": 0
  },
  {
   "from": 54.3,
   "to": 56.599,
   "sid": 35,
   "location": 2,
   "content": "很多运球不错的人都有这个问题",
   "music": 0
  },
  {
   "from": 56.84,
   "to": 58.31,
   "sid": 36,
   "location": 2,
   "content": "四运球接力",
   "music": 0
  },
  {
   "from": 58.31,
   "to": 60.68,
   "sid": 37,
   "location": 2,
   "content": "很多运球时会不自觉的摇晃身体",
   "music": 0
  },
  {
   "from": 60.68,
   "to": 62.42,
   "sid": 38,
   "location": 2,
   "content": "以此借力来完成运球动作",
   "music": 0
  },
  {
   "from": 62.42,
   "to": 63.63,
   "sid": 39,
   "location": 2,
   "content": "或者增加运球速度",
   "music": 0
  },
  {
   "from": 63.63,
   "to": 64.53,
   "sid": 40,
   "location": 2,
   "content": "这种情况下",
   "music": 0
  },
  {
   "from": 64.53,
   "to": 66.24,
   "sid": 41,
   "location": 2,
   "content": "身体重心很难保持稳定",
   "music": 0
  },
  {
   "from": 66.24,
   "to": 69.289,
   "sid": 42,
   "location": 2,
   "content": "他对运球造成的影响比上一点还要严重",
   "music": 0
  },
  {
   "from": 69.289,
   "to": 71.32,
   "sid": 43,
   "location": 2,
   "content": "五运球时胯打不开",
   "music": 0
  },
  {
   "from": 71.32,
   "to": 73.9,
   "sid": 44,
   "location": 2,
   "content": "这会导致我们花滑运球时由于空间不够",
   "music": 0
  },
  {
   "from": 73.9,
   "to": 74.92,
   "sid": 45,
   "location": 2,
   "content": "只能向后运球",
   "music": 0
  },
  {
   "from": 74.92,
   "to": 76.42,
   "sid": 46,
   "location": 2,
   "content": "出现身体旋转了情况",
   "music": 0
  },
  {
   "from": 76.42,
   "to": 78.22,
   "sid": 47,
   "location": 2,
   "content": "也会导致我们因为重心过高",
   "music": 0
  },
  {
   "from": 78.22,
   "to": 81.1,
   "sid": 48,
   "location": 2,
   "content": "只能通过双腿内八字的方式降低重心来完成",
   "music": 0
  },
  {
   "from": 81.1,
   "to": 82.81,
   "sid": 49,
   "location": 2,
   "content": "备孕和驼背运球一样",
   "music": 0
  },
  {
   "from": 82.81,
   "to": 83.62,
   "sid": 50,
   "location": 2,
   "content": "时间久了",
   "music": 0
  },
  {
   "from": 83.62,
   "to": 84.82,
   "sid": 51,
   "location": 2,
   "content": "腰酸背痛就来了",
   "music": 0
  },
  {
   "from": 84.82,
   "to": 87.08,
   "sid": 52,
   "location": 2,
   "content": "随意运球时我们一定要把胯给打开",
   "music": 0
  },
  {
   "from": 87.08,
   "to": 89.63,
   "sid": 53,
   "location": 2,
   "content": "脚间距约为肩宽的1.5到两倍即可",
   "music": 0
  },
  {
   "from": 89.63,
   "to": 91.04,
   "sid": 54,
   "location": 2,
   "content": "ok今天就说到这里",
   "music": 0
  },
  {
   "from": 91.04,
   "to": 91.74,
   "sid": 55,
   "location": 2,
   "content": "我是泡菜",
   "music": 0
  },
  {
   "from": 91.74,
   "to": 93.06,
   "sid": 56,
   "location": 2,
   "content": "专治运球疑难杂症",
   "music": 0
  },
  {
   "from": 93.06,
   "to": 94.32,
   "sid": 57,
   "location": 2,
   "content": "免费教学进火山群",
   "music": 0
  },
  {
   "from": 94.32,
   "to": 95.46,
   "sid": 58,
   "location": 2,
   "content": "社会教学请私信",
   "music": 0
  },
  {
   "from": 95.46,
   "to": 96.84,
   "sid": 59,
   "location": 2,
   "content": "我们下期再见",
   "music": 0
  }
 ]
}