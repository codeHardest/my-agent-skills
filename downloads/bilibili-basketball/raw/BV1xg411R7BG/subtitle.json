{
 "font_size": 0.4,
 "font_color": "#FFFFFF",
 "background_alpha": 0.5,
 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "en-v1.2.0.4-t0.3.c",
 "body": [
  {
   "from": 0.28,
   "to": 2.74,
   "sid": 1,
   "location": 2,
   "content": "教练马库斯·霍奇斯在这里接受IB精英训练"
  },
  {
   "from": 2.74,
   "to": 6.08,
   "sid": 2,
   "location": 2,
   "content": "今天我们要专注于一些在家整理"
  },
  {
   "from": 6.48,
   "to": 7.64,
   "sid": 3,
   "location": 2,
   "content": "这是一个很大的弯曲"
  },
  {
   "from": 7.64,
   "to": 9.6,
   "sid": 4,
   "location": 2,
   "content": "嗯，股票涨了六倍"
  },
  {
   "from": 10.6,
   "to": 14,
   "sid": 5,
   "location": 2,
   "content": "你在外面的车库里，你需要方法来完成"
  },
  {
   "from": 14,
   "to": 15.3,
   "sid": 6,
   "location": 2,
   "content": "但现在就在这里"
  },
  {
   "from": 15.3,
   "to": 18.4,
   "sid": 7,
   "location": 2,
   "content": "我们要专注于外手外脚完成"
  },
  {
   "from": 18.4,
   "to": 19.96,
   "sid": 8,
   "location": 2,
   "content": "这样你就可以在篮子下面"
  },
  {
   "from": 19.96,
   "to": 21.19,
   "sid": 9,
   "location": 2,
   "content": "或者稍微向右"
  },
  {
   "from": 21.19,
   "to": 22.47,
   "sid": 10,
   "location": 2,
   "content": "当我在这里的时候"
  },
  {
   "from": 22.47,
   "to": 24.47,
   "sid": 11,
   "location": 2,
   "content": "我想把车开到肘部"
  },
  {
   "from": 24.47,
   "to": 25.65,
   "sid": 12,
   "location": 2,
   "content": "右手的蝴蝶结"
  },
  {
   "from": 25.65,
   "to": 26.98,
   "sid": 13,
   "location": 2,
   "content": "我会开车到肘部"
  },
  {
   "from": 27.9,
   "to": 29.5,
   "sid": 14,
   "location": 2,
   "content": "或者右脚触碰"
  },
  {
   "from": 29.5,
   "to": 30.74,
   "sid": 15,
   "location": 2,
   "content": "当你的右脚接触"
  },
  {
   "from": 30.74,
   "to": 31.82,
   "sid": 16,
   "location": 2,
   "content": "我要到后面去"
  },
  {
   "from": 31.82,
   "to": 33.54,
   "sid": 17,
   "location": 2,
   "content": "所以注意现在我的左脚是为了"
  },
  {
   "from": 33.54,
   "to": 34.54,
   "sid": 18,
   "location": 2,
   "content": "我的右脚又回来了"
  },
  {
   "from": 34.54,
   "to": 36.58,
   "sid": 19,
   "location": 2,
   "content": "我想要一个三两步"
  },
  {
   "from": 36.58,
   "to": 39.08,
   "sid": 20,
   "location": 2,
   "content": "当这代表一个运球繁荣"
  },
  {
   "from": 39.08,
   "to": 40.2,
   "sid": 21,
   "location": 2,
   "content": "这一步"
  },
  {
   "from": 40.2,
   "to": 41.34,
   "sid": 22,
   "location": 2,
   "content": "这是我的下一步"
  },
  {
   "from": 41.34,
   "to": 43.59,
   "sid": 23,
   "location": 2,
   "content": "所以外手外脚"
  },
  {
   "from": 43.59,
   "to": 44.93,
   "sid": 24,
   "location": 2,
   "content": "完成的好方法"
  },
  {
   "from": 44.93,
   "to": 46.85,
   "sid": 25,
   "location": 2,
   "content": "只是为了摆脱你的防守者的时机"
  },
  {
   "from": 46.85,
   "to": 49.39,
   "sid": 26,
   "location": 2,
   "content": "利用你的防守队员习惯从你的内侧脚跳下"
  },
  {
   "from": 49.39,
   "to": 51.3,
   "sid": 27,
   "location": 2,
   "content": "所以就在你迈出最后一步之前"
  },
  {
   "from": 51.3,
   "to": 52.74,
   "sid": 28,
   "location": 2,
   "content": "你已经把球打到玻璃上了"
  },
  {
   "from": 52.74,
   "to": 53.34,
   "sid": 29,
   "location": 2,
   "content": "到玻璃上"
  },
  {
   "from": 53.34,
   "to": 54.9,
   "sid": 30,
   "location": 2,
   "content": "再来点黄油"
  },
  {
   "from": 82,
   "to": 83.3,
   "sid": 31,
   "location": 2,
   "content": "好的另一种结束方式"
  },
  {
   "from": 83.3,
   "to": 84.54,
   "sid": 32,
   "location": 2,
   "content": "我坚持同样的哲学"
  },
  {
   "from": 84.54,
   "to": 86.3,
   "sid": 33,
   "location": 2,
   "content": "一旦你们攻击肘部"
  },
  {
   "from": 86.3,
   "to": 87.949,
   "sid": 34,
   "location": 2,
   "content": "和你一模一样的脚"
  },
  {
   "from": 87.949,
   "to": 89.769,
   "sid": 35,
   "location": 2,
   "content": "但现在我有一个运球"
  },
  {
   "from": 89.769,
   "to": 90.6,
   "sid": 36,
   "location": 2,
   "content": "两步"
  },
  {
   "from": 90.6,
   "to": 93.14,
   "sid": 37,
   "location": 2,
   "content": "我想用我的内手完成"
  },
  {
   "from": 93.14,
   "to": 95.02,
   "sid": 38,
   "location": 2,
   "content": "所以被告认为你往左走"
  },
  {
   "from": 95.02,
   "to": 97.19,
   "sid": 39,
   "location": 2,
   "content": "他几乎要跳过你的背"
  },
  {
   "from": 97.19,
   "to": 99.23,
   "sid": 40,
   "location": 2,
   "content": "你就在腋下完成"
  },
  {
   "from": 99.23,
   "to": 100.87,
   "sid": 41,
   "location": 2,
   "content": "所以你就在这里结束了"
  },
  {
   "from": 100.87,
   "to": 102.83,
   "sid": 42,
   "location": 2,
   "content": "到外面篮子的部分"
  },
  {
   "from": 102.83,
   "to": 104.53,
   "sid": 43,
   "location": 2,
   "content": "脚内手饰面"
  },
  {
   "from": 104.53,
   "to": 105.88,
   "sid": 44,
   "location": 2,
   "content": "让我们做吧"
  },
  {
   "from": 119.68,
   "to": 120.68,
   "sid": 45,
   "location": 2,
   "content": "祝你好运"
  },
  {
   "from": 120.68,
   "to": 122.06,
   "sid": 46,
   "location": 2,
   "content": "感谢收看"
  },
  {
   "from": 128.06,
   "to": 129.18,
   "sid": 47,
   "location": 2,
   "content": "我们的第三季"
  },
  {
   "from": 129.18,
   "to": 132.3,
   "sid": 48,
   "location": 2,
   "content": "我们还在攻击你向上的同一肘部"
  },
  {
   "from": 132.3,
   "to": 133.44,
   "sid": 49,
   "location": 2,
   "content": "在背后"
  },
  {
   "from": 133.44,
   "to": 136.62,
   "sid": 50,
   "location": 2,
   "content": "你还是一样的运球两步"
  },
  {
   "from": 136.62,
   "to": 137.9,
   "sid": 51,
   "location": 2,
   "content": "但现在我放手了"
  },
  {
   "from": 137.9,
   "to": 139.32,
   "sid": 52,
   "location": 2,
   "content": "我想把一切都说出来"
  },
  {
   "from": 139.32,
   "to": 140.459,
   "sid": 53,
   "location": 2,
   "content": "篮筐左侧"
  },
  {
   "from": 140.459,
   "to": 141.879,
   "sid": 54,
   "location": 2,
   "content": "所以现在当我走的时候"
  },
  {
   "from": 141.879,
   "to": 144.259,
   "sid": 55,
   "location": 2,
   "content": "我的肢体语言是说篮子的左边"
  },
  {
   "from": 144.259,
   "to": 146.09,
   "sid": 56,
   "location": 2,
   "content": "但现在我想在对面伸展"
  },
  {
   "from": 146.09,
   "to": 147.97,
   "sid": 57,
   "location": 2,
   "content": "因为你有一个运动后卫"
  },
  {
   "from": 147.97,
   "to": 148.91,
   "sid": 58,
   "location": 2,
   "content": "在你的背上传递"
  },
  {
   "from": 148.91,
   "to": 150.63,
   "sid": 59,
   "location": 2,
   "content": "他就会跳到左边"
  },
  {
   "from": 150.63,
   "to": 152.61,
   "sid": 60,
   "location": 2,
   "content": "你完成了那个鬼鬼祟祟的完成"
  },
  {
   "from": 152.61,
   "to": 154.45,
   "sid": 61,
   "location": 2,
   "content": "我想把右手放在右边"
  },
  {
   "from": 154.45,
   "to": 156.25,
   "sid": 62,
   "location": 2,
   "content": "所以我要到后面去"
  },
  {
   "from": 156.25,
   "to": 158.29,
   "sid": 63,
   "location": 2,
   "content": "我要那个一二"
  },
  {
   "from": 158.29,
   "to": 161.5,
   "sid": 64,
   "location": 2,
   "content": "从左脚跳起，向对面伸展"
  },
  {
   "from": 166.979,
   "to": 169.8,
   "sid": 65,
   "location": 2,
   "content": "我的背伙计，再来一个，就在这里"
  },
  {
   "from": 170,
   "to": 173.84,
   "sid": 66,
   "location": 2,
   "content": "同样的两步对你的伸展都是同样的一步"
  },
  {
   "from": 173.84,
   "to": 175.4,
   "sid": 67,
   "location": 2,
   "content": "一个"
  },
  {
   "from": 182.18,
   "to": 184.54,
   "sid": 68,
   "location": 2,
   "content": "不是想跳到两个人身上"
  },
  {
   "from": 184.54,
   "to": 185.58,
   "sid": 69,
   "location": 2,
   "content": "跳到一个上"
  },
  {
   "from": 191.519,
   "to": 193.199,
   "sid": 70,
   "location": 2,
   "content": "一二左"
  },
  {
   "from": 193.199,
   "to": 194.359,
   "sid": 71,
   "location": 2,
   "content": "你走对了"
  },
  {
   "from": 194.359,
   "to": 195.279,
   "sid": 72,
   "location": 2,
   "content": "这是一回事"
  },
  {
   "from": 195.279,
   "to": 197.32,
   "sid": 73,
   "location": 2,
   "content": "但现在你得再跳一点"
  },
  {
   "from": 201.12,
   "to": 201.74,
   "sid": 74,
   "location": 2,
   "content": "啊"
  },
  {
   "from": 201.74,
   "to": 202.5,
   "sid": 75,
   "location": 2,
   "content": "哦"
  },
  {
   "from": 202.5,
   "to": 203.16,
   "sid": 76,
   "location": 2,
   "content": "是啊，是啊"
  },
  {
   "from": 203.16,
   "to": 203.64,
   "sid": 77,
   "location": 2,
   "content": "再来一个"
  },
  {
   "from": 203.64,
   "to": 205.22,
   "sid": 78,
   "location": 2,
   "content": "就差一个了"
  },
  {
   "from": 205.22,
   "to": 208.64,
   "sid": 79,
   "location": 2,
   "content": "所以你想在背后弹"
  },
  {
   "from": 208.64,
   "to": 210.32,
   "sid": 80,
   "location": 2,
   "content": "一二"
  },
  {
   "from": 211.639,
   "to": 214.399,
   "sid": 81,
   "location": 2,
   "content": "你可以从右脚跳，也可以从左脚跳"
  },
  {
   "from": 214.399,
   "to": 219,
   "sid": 82,
   "location": 2,
   "content": "但我希望你们把注意力集中在脚上或者让代表们"
  },
  {
   "from": 219,
   "to": 220.87,
   "sid": 83,
   "location": 2,
   "content": "不管那个捍卫者怎么守护"
  },
  {
   "from": 220.87,
   "to": 222.94,
   "sid": 84,
   "location": 2,
   "content": "我要你到长凳对面去"
  },
  {
   "from": 242.12,
   "to": 242.98,
   "sid": 85,
   "location": 2,
   "content": "另一个选择"
  },
  {
   "from": 245.62,
   "to": 248.44,
   "sid": 86,
   "location": 2,
   "content": "当你们现在登上顶峰的时候"
  },
  {
   "from": 249.1,
   "to": 250.2,
   "sid": 87,
   "location": 2,
   "content": "当我在这里"
  },
  {
   "from": 250.2,
   "to": 252.26,
   "sid": 88,
   "location": 2,
   "content": "我再来一次运球拳"
  },
  {
   "from": 252.26,
   "to": 254.7,
   "sid": 89,
   "location": 2,
   "content": "同样的事情我的右脚会打"
  },
  {
   "from": 254.7,
   "to": 258.039,
   "sid": 90,
   "location": 2,
   "content": "但我会用左脚把球捡起来"
  },
  {
   "from": 258.039,
   "to": 259.399,
   "sid": 91,
   "location": 2,
   "content": "所以当我走到背后"
  },
  {
   "from": 259.399,
   "to": 261.079,
   "sid": 92,
   "location": 2,
   "content": "我把球捡起来"
  },
  {
   "from": 261.079,
   "to": 262.979,
   "sid": 93,
   "location": 2,
   "content": "这让我多走了一步"
  },
  {
   "from": 262.979,
   "to": 264.579,
   "sid": 94,
   "location": 2,
   "content": "利用你的运动能力"
  },
  {
   "from": 264.579,
   "to": 267.499,
   "sid": 95,
   "location": 2,
   "content": "用你的平衡来推动你的完成"
  },
  {
   "from": 267.499,
   "to": 268.82,
   "sid": 96,
   "location": 2,
   "content": "拾音器留下了"
  },
  {
   "from": 268.82,
   "to": 270.16,
   "sid": 97,
   "location": 2,
   "content": "完成他的右脚"
  },
  {
   "from": 270.16,
   "to": 271.28,
   "sid": 98,
   "location": 2,
   "content": "中间完成"
  },
  {
   "from": 271.28,
   "to": 272.82,
   "sid": 99,
   "location": 2,
   "content": "也可以在对面完成"
  },
  {
   "from": 274.22,
   "to": 275.14,
   "sid": 100,
   "location": 2,
   "content": "在你的"
  },
  {
   "from": 291,
   "to": 292.32,
   "sid": 101,
   "location": 2,
   "content": "再做一个"
  },
  {
   "from": 292.32,
   "to": 294.12,
   "sid": 102,
   "location": 2,
   "content": "你基本上是鳟鱼"
  },
  {
   "from": 294.12,
   "to": 295.4,
   "sid": 103,
   "location": 2,
   "content": "然后你基本上"
  },
  {
   "from": 297.56,
   "to": 301.92,
   "sid": 104,
   "location": 2,
   "content": "一二开始"
  },
  {
   "from": 301.92,
   "to": 304.08,
   "sid": 105,
   "location": 2,
   "content": "那是一个在家整理系列"
  },
  {
   "from": 304.08,
   "to": 305.06,
   "sid": 106,
   "location": 2,
   "content": "你把它吃完"
  },
  {
   "from": 305.06,
   "to": 307.36,
   "sid": 107,
   "location": 2,
   "content": "背后到欧元台阶"
  },
  {
   "from": 307.36,
   "to": 308.93,
   "sid": 108,
   "location": 2,
   "content": "如果你完成了中间"
  },
  {
   "from": 308.93,
   "to": 313.03,
   "sid": 109,
   "location": 2,
   "content": "还要记住那些运动员可以跳起来盖帽"
  },
  {
   "from": 313.03,
   "to": 316.72,
   "sid": 110,
   "location": 2,
   "content": "但如果你有能力把它从侧面伸出来"
  },
  {
   "from": 316.72,
   "to": 320.7,
   "sid": 111,
   "location": 2,
   "content": "你把那个山坡上的容器从篮子里拿开"
  },
  {
   "from": 320.7,
   "to": 322.7,
   "sid": 112,
   "location": 2,
   "content": "我还没有看到任何人跳过房间"
  },
  {
   "from": 322.7,
   "to": 323.56,
   "sid": 113,
   "location": 2,
   "content": "也许是锡安"
  },
  {
   "from": 323.56,
   "to": 324.74,
   "sid": 114,
   "location": 2,
   "content": "我们能没见过吗"
  },
  {
   "from": 324.74,
   "to": 328.47,
   "sid": 115,
   "location": 2,
   "content": "所以能够在这个的对面伸展"
  },
  {
   "from": 328.47,
   "to": 329.91,
   "sid": 116,
   "location": 2,
   "content": "希望那个山坡卫士"
  },
  {
   "from": 329.91,
   "to": 331.4,
   "sid": 117,
   "location": 2,
   "content": "他的手被下一个"
  },
  {
   "from": 331.4,
   "to": 332.68,
   "sid": 118,
   "location": 2,
   "content": "我们叫轮辋"
  },
  {
   "from": 332.68,
   "to": 334.96,
   "sid": 119,
   "location": 2,
   "content": "我们在左边完成在对面"
  },
  {
   "from": 334.96,
   "to": 335.72,
   "sid": 120,
   "location": 2,
   "content": "你已经知道了"
  },
  {
   "from": 335.72,
   "to": 336.12,
   "sid": 121,
   "location": 2,
   "content": "让我们得到它"
  }
 ]
}